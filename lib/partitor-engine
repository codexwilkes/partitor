        "(with clef). Brown = system header (copied to every part). Grey = "
        "discarded (light grey = noise / page edge). Red box = check by eye. "
        "Red band = safety gate failure.</p>" + "".join(items), encoding="utf-8")
    return idx


def make_strip(res: PageResult, st_idx: list[int], header_owner: int,
               darker: bool = False, bar_no: int | None = None,
               marks: list | None = None, movement: bool = False) -> Strip:
    """make_strip -> Strip for staves st_idx (one part) plus system header.

    The header is shifted to sit above this staff at the same offset it had
    above the system's top staff, and moved up if it would touch own ink.
    darker: dilate the ink by 1 px."""
    o = res.owner
    sp = res.sp
    own = np.isin(o, st_idx)
    sts = [res.staves[i] for i in st_idx]
    ys, xs = np.nonzero(own)
    y0, y1 = int(ys.min()), int(ys.max())
    x0, x1 = int(xs.min()), int(xs.max())
    hdr = o == header_owner
    # printed mid-line bar numbers: own ink of the top staff or header ink
    inbox = np.zeros(o.shape, bool)
    for bx0, by0, bx1, by1 in res.num_boxes.get(sts[0].system, []):
        inbox[by0:by1 + 1, bx0:bx1 + 1] = True
    n_own = inbox[ys, xs]
    hy = hx = None
    n_hdr = None
    if hdr.any():
        hy, hx = np.nonzero(hdr)
        n_hdr = inbox[hy, hx]
    top_staff = min((s for s in res.staves if s.system == sts[0].system),
                    key=lambda s: s.top)
    shift = int(round(sts[0].top - top_staff.top))
    if hy is not None and shift > 0:
        hy = hy + shift
        hb = int(hy.max())
        cols = slice(int(hx.min()), int(hx.max()) + 1)
        sub = own[:, cols]
        rows = np.flatnonzero(sub.any(axis=1))
        own_top = int(rows.min()) if rows.size else y0
        need = own_top - int(0.5 * sp)
        if hb > need:
            hy = hy - (hb - need)
    if hy is not None:
        # a header never starts left of the music: the staves keep the
        # left margin and the header text moves right
        if int(hx.min()) < x0:
            hx = hx + (x0 - int(hx.min()))
        y0 = min(y0, int(hy.min()))
        x1 = max(x1, int(hx.max()))
    pad = 1 if darker else 0
    canvas = np.zeros((y1 - y0 + 1 + 2 * pad, x1 - x0 + 1 + 2 * pad), bool)
    hcanvas = np.zeros_like(canvas)
    canvas[ys - y0 + pad, xs - x0 + pad] = True
    ncanvas = np.zeros_like(canvas)
    ncanvas[ys[n_own] - y0 + pad, xs[n_own] - x0 + pad] = True
    if hy is not None:
        canvas[hy - y0 + pad, hx - x0 + pad] = True
        hcanvas[hy - y0 + pad, hx - x0 + pad] = True
        ncanvas[hy[n_hdr] - y0 + pad, hx[n_hdr] - x0 + pad] = True
    if darker:
        k = np.ones((3, 3), np.uint8)
        canvas = cv2.dilate(canvas.astype(np.uint8), k) > 0
        hcanvas = cv2.dilate(hcanvas.astype(np.uint8), k) > 0
        ncanvas = cv2.dilate(ncanvas.astype(np.uint8), k) > 0
    return Strip(canvas, min(s.x0 for s in sts) - x0 + pad,
                 int(round(sts[0].top)) - y0 + pad,
                 int(round(sts[-1].bottom)) - y0 + pad, sp, hcanvas, bar_no,
                 marks=[(int(mx) - x0 + pad, t) for mx, t in (marks or [])],
                 movement=movement, num_mask=ncanvas if ncanvas.any() else None)


GROUP_BAR_COVER = 0.85   # a barline stroke covers this share of a staff's height
GROUP_BAR_SP = 0.5       # search window around a system barline, staff spaces


def group_bars(res: PageResult, idx: list[int], gsys: int, nums: list
               ) -> tuple[list[int], list[int], str]:
    """group_bars -> (x of the barlines common to all staves idx, the
    number of the bar that ends at each, why not).

    A system barline is common when every staff of the group has its own
    ink through the full staff height at that x (a Mensurstrich, a misread
    barline or a bar edit made without ink gives no stroke on a staff, so
    nobody cuts there). nums: the system's number per bar; a bar that
    holds dropped barlines keeps the number of its first bar. why: text
    for the re-flow report when no barline is left or the numbers cannot
    follow the merged bars (then no cut at all)."""
    allb = res.barlines.get(gsys, [])
    sp, thick = res.sp, res.thick
    w = max(1, int(round(GROUP_BAR_SP * sp)))
    kept: list[int] = []
    bad = ""
    for k, bx in enumerate(allb):
        for i in idx:
            st = res.staves[i]
            r0, r1 = max(0, int(st.top - thick)), int(st.bottom + thick) + 1
            band = res.owner[r0:r1, max(0, bx - w):bx + w + 1] == i
            if not band.size or band.mean(axis=0).max() < GROUP_BAR_COVER:
                bad = f"barline {k + 1} is not on every staff"
                break
        else:
            kept.append(k)
    if not kept:
        return [], [], bad or "no barline in the system"
    numbers: list[int] = []
    if nums:
        if len(nums) != len(allb) and len(kept) != len(allb):
            return [], [], "bar numbers do not match the barlines"
        if len(nums) == len(allb):
            numbers = [int(nums[(kept[j - 1] + 1) if j else 0]) for j in range(len(kept))]
    return [int(allb[k]) for k in kept], numbers, ""


def own_group_gap(lay: dict, name: str, opts: dict) -> float | None:
    """own_group_gap -> `group_gap` (sp) of a part or group: its own value in
    layout.parts, else the item's (a command-line value is in opts); None =
    the source distance between the staves."""
    own = (((lay.get("layout") or {}).get(PART_LAYOUT_KEY) or {}).get(name) or {})
    v = own.get("group_gap", opts.get("group_gap"))
    return None if v is None else float(v)


def group_strip(res: PageResult, sys_staves: list[int], runs: list[tuple[str, list[int]]],
                header_owner: int, darker: bool = False, bar_no: int | None = None,
                marks: list | None = None, movement: bool = False,
                nums: list | None = None, gap_sp: float | None = None,
                labels: bool = True) -> Strip:
    """group_strip -> one line of a group score: the staves of its parts
    (runs: (part, staff indices), score order), stacked at the source's
    staff distance. Staves of other parts between them leave no space
    (operator request 2026-10-24: Alto, then Tenor I, as if adjacent). The distance
    grows only where ink would come closer than 0.5 sp. Labels per part.
    gap_sp (0.3.0-dev.36, `group_gap`): the space between one staff's bottom
    line and the next staff's top line, in staff spaces, instead of the
    source distance (operator request 2026-10-27: the white between the staves may
    shrink); the 0.5 sp ink guard stays. labels=False: a part on two staves
    (no label column, not a group line)."""
    sp = res.sp
    idx_all = [i for _, ix in runs for i in ix]
    pos = {st: k for k, st in enumerate(sys_staves)}

    def bars(st: Strip, off: int) -> Strip:
        # barlines common to all staves, in strip coordinates (re-flow);
        # off: strip x minus page x
        bx, nn, why = group_bars(res, idx_all, res.staves[idx_all[0]].system, nums or [])
        st.bars_x = [int(b + off) for b in bx]
        st.bar_nums = nn
        end = max(res.staves[i].x1 for i in idx_all) + off
        st.ends_at_bar = bool(st.bars_x) and end - st.bars_x[-1] <= 2.0 * sp
        st.end_gap_sp = (end - st.bars_x[-1]) / sp if st.bars_x else -1.0
        st.bars_why = why or ("" if st.ends_at_bar else "the line does not end at a barline")
        return st

    contiguous = all(pos[b] - pos[a] == 1 for a, b in zip(idx_all, idx_all[1:]))
    if contiguous and gap_sp is None:
        stp = make_strip(res, idx_all, header_owner, darker, bar_no=bar_no, marks=marks,
                         movement=movement)
        t0 = res.staves[idx_all[0]].top
        for name, ix in runs:
            stp.staff_labels.append((name, int(round(res.staves[ix[0]].top - t0)) + stp.staff_top,
                                     int(round(res.staves[ix[0]].bottom - t0)) + stp.staff_top))
        return bars(stp, stp.staff_x0 - min(res.staves[i].x0 for i in idx_all))
    # source distance from one staff to the next (top line to top line)
    tops = [res.staves[i].top for i in sys_staves]
    step = float(np.median(np.diff(tops))) if len(tops) > 1 else 12 * sp
    subs = []
    for k, (name, ix) in enumerate(runs):
        sub = make_strip(res, ix, header_owner if k == 0 else -999, darker,
                         bar_no=bar_no if k == 0 else None,
                         marks=marks if k == 0 else None, movement=movement)
        ox = min(res.staves[i].x0 for i in ix) - sub.staff_x0     # page x of column 0
        subs.append((name, ix, sub, ox))
    left = min(ox for *_, ox in subs)
    width = max(ox - left + sub.img.shape[1] for _, _, sub, ox in subs)
    # vertical place of each sub strip (row of its img top in the canvas)
    ys, prev = [], None
    for name, ix, sub, ox in subs:
        if prev is None:
            ys.append(0)
        else:
            pname, pix, psub, py = prev
            if gap_sp is not None:
                want = py + psub.staff_bottom + int(round(gap_sp * sp)) - sub.staff_top
            else:
                want = py + psub.staff_top + (res.staves[ix[0]].top - res.staves[pix[-1]].top
                                              if pos[ix[0]] - pos[pix[-1]] == 1 else
                                              (psub.staff_bottom - psub.staff_top) + step
                                              - 4 * sp) - sub.staff_top
            # no closer than 0.5 sp, ink to ink, column by column
            pc = psub.img.any(axis=0)
            pb = np.full(width, -10 ** 9)
            cols = np.flatnonzero(pc)
            last = psub.img.shape[0] - 1 - np.argmax(psub.img[::-1, cols], axis=0)
            pb[cols + prev_ox - left] = last + py
            nc = np.flatnonzero(sub.img.any(axis=0))
            first = np.argmax(sub.img[:, nc], axis=0)
            nt = np.full(width, 10 ** 9)
            nt[nc + ox - left] = first
            need = int(np.max(pb - nt)) + int(0.5 * sp) if nc.size and cols.size else want
            ys.append(int(round(max(want, need))))
        prev = (name, ix, sub, ys[-1])
        prev_ox = ox
    h = max(y + sub.img.shape[0] for y, (_, _, sub, _) in zip(ys, subs))
    img = np.zeros((h, width), bool)
    hdr = np.zeros_like(img)
    num = np.zeros_like(img)
    labels_ = []
    for y, (name, ix, sub, ox) in zip(ys, subs):
        x = ox - left
        sl = (slice(y, y + sub.img.shape[0]), slice(x, x + sub.img.shape[1]))
        img[sl] |= sub.img
        hdr[sl] |= sub.hdr
        if sub.num_mask is not None:
            num[sl] |= sub.num_mask
        labels_.append((name, y + sub.staff_top, y + sub.staff_top + int(round(4 * sp))))
    first_sub, last_sub = subs[0][2], subs[-1][2]
    out = Strip(img, subs[0][3] - left + first_sub.staff_x0, first_sub.staff_top,
                ys[-1] + last_sub.staff_bottom, sp, hdr, bar_no,
                marks=[(mx + subs[0][3] - left, t) for mx, t in first_sub.marks],
                movement=movement, num_mask=num if num.any() else None)
    out.staff_labels = labels_ if labels else []
    return bars(out, -left)


def profile(img: np.ndarray, staff_x0: int, nbins: int, bin_px: float
            ) -> tuple[np.ndarray, np.ndarray]:
    """Top and bottom ink row per x-bin, bins measured from staff_x0."""
    top = np.full(nbins, np.inf)
    bot = np.full(nbins, -np.inf)
    h = img.shape[0]
    xs = np.flatnonzero(img.any(axis=0))
    if not xs.size:
        return top, bot
    first = img[:, xs].argmax(axis=0)
    last = h - 1 - img[::-1, xs].argmax(axis=0)
    bins = ((xs - staff_x0) / bin_px).astype(int) + nbins // 2   # int(): toward 0
    ok = (bins >= 0) & (bins < nbins)
    np.minimum.at(top, bins[ok], first[ok].astype(float))
    np.maximum.at(bot, bins[ok], last[ok].astype(float))
    return top, bot


def profiles(s: Strip, nbins: int, bin_px: float
             ) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """profiles -> (top of own ink, top of header ink, bottom of all ink).

    A strip with a bar number reserves its box (see bar_mark), like header
    ink."""
    a = anchor(s)
    t_own, _ = profile(s.img & ~s.hdr, a, nbins, bin_px)
    t_hdr, _ = profile(s.hdr, a, nbins, bin_px)
    _, bot = profile(s.img, a, nbins, bin_px)
    boxes = [(x0, top, x1) for x0, top, x1, *_ in reh_boxes(s)]
    rb = rest_box(s)
    if rb:
        boxes.append(rb[:3])
    if s.bar_no is not None:
        _, top, wpx = bar_mark(s)
        c0 = bar_x(s)
        boxes.append((c0, top, c0 + wpx))
    for x0, top, x1 in boxes:
        b0 = max(0, int((x0 - a) / bin_px) + nbins // 2)
        b1 = min(nbins, int(np.ceil((x1 - a) / bin_px)) + nbins // 2 + 1)
        t_hdr[b0:b1] = np.minimum(t_hdr[b0:b1], top)
    return t_own, t_hdr, bot


def rest_text(n: str) -> tuple[str, str, float, float]:
    """rest_text -> (text, font kind, size in sp, baseline above the top
    line in sp) for a multi-bar rest count: Bravura time-signature digits
    (U+E080..E089, 2 sp tall, centred on the baseline; em = 4 sp), else
    SemiBold Garamond."""
    if _font("music")[1]:
        return "".join(chr(0xE080 + int(d)) for d in n), "music", 4.0, 1.5
    return n, "bold", 2.6, 0.8


def rest_box(s: Strip) -> tuple[float, float, float, float, float, str, str] | None:
    """rest_box -> (x0, top, x1, baseline, font size, text, font kind) of
    the multi-bar rest count, centred above the H-bar, in strip px; None
    without one."""
    if not s.rest_label:
        return None
    cx, n = s.rest_label
    t, kind, size, raise_ = rest_text(n)
    fs = size * s.sp
    w = text_len(t, kind, fs)
    base = s.staff_top - raise_ * s.sp
    top = base - (1.0 * s.sp if kind == "music" else 0.72 * fs)
    return (cx - w / 2, top, cx + w / 2, base, fs, t, kind)


REH_SIZE = 2.6        # rehearsal letter size, staff spaces
REH_PAD = 0.3         # box padding, staff spaces


def reh_boxes(s: Strip) -> list[tuple[float, float, float, float, str, float, float]]:
    """reh_boxes -> [(x0, top, x1, bottom, letter, font size, baseline)] in
    strip px: a boxed bold letter at the start of its bar, above the staff
    and clear of the ink below it (like a bar number)."""
    out = []
    pad = REH_PAD * s.sp
    for mx, t in s.marks:
        fs = REH_SIZE * s.sp
        tw = text_len(t, "bold", fs)
        x0 = float(mx) + (0.0 if mx <= s.staff_x0 + 2 else 0.3 * s.sp)
        x1 = x0 + tw + 2 * pad
        cols = s.img[:, max(0, int(x0)):int(x1) + 1]
        rows = np.flatnonzero(cols.any(axis=1)) if cols.size else np.array([])
        ink_top = float(rows.min()) if rows.size else float(s.staff_top)
        bottom = min(s.staff_top - s.bar_raise * s.sp, ink_top - 0.4 * s.sp)
        top = bottom - 0.72 * fs - 2 * pad
        out.append((x0, top, x1, bottom, t, fs, bottom - pad))
    return out


def bar_x(s: Strip) -> float:
    """Left edge of the bar number: the staff start, or right of a
    rehearsal letter that also stands at the line start."""
    x = float(max(0, s.staff_x0))
    for x0, _, x1, *_ in reh_boxes(s):
        if x0 <= s.staff_x0 + 2:
            x = max(x, x1 + 0.4 * s.sp)
    return x


BAR_CLEAR_SP = 0.5    # bar number above the clef / first ink by this


def bar_mark(s: Strip) -> tuple[float, float, float]:
    """bar_mark -> (baseline row, top row, width px) of the bar number in
    strip coordinates. Left edge at the staff start (above the clef, as
    engravers set it). Baseline at least bar_raise sp above the top line and
    BAR_CLEAR_SP above any ink in the number's columns (clef, header text)."""
    size = s.bar_size * s.sp
    wpx = text_len(str(s.bar_no), "italic", size)
    c0 = int(bar_x(s))
    cols = s.img[:, c0:int(c0 + wpx) + 2]
    rows = np.flatnonzero(cols.any(axis=1))
    ink_top = float(rows.min()) if rows.size else float(s.staff_top)
    base = min(s.staff_top - s.bar_raise * s.sp, ink_top - BAR_CLEAR_SP * s.sp)
    return base, base - 0.72 * size, wpx


# =============================================================================
# Re-flow (DESIGN.md §4.2 item 2): offered when the print is small
# =============================================================================
REFLOW_MAX_PREFIX_SP = 12.0     # clef + key signature: never wider than this


def set_bar_geometry(stp: Strip, res: PageResult, idx: list[int], gsys: int,
                     nums: list) -> None:
    """Barlines of the strip's system in strip coordinates, the number of
    each bar, and whether the line ends at a barline."""
    sx = min(res.staves[i].x0 for i in idx)
    off = stp.staff_x0 - sx
    stp.bars_x = [int(b + off) for b in res.barlines.get(gsys, [])]
    stp.bar_nums = [int(n) for n in nums]
    end = max(res.staves[i].x1 for i in idx) + off
    # a repeat or final barline (thin + thick) is found at its middle
    stp.ends_at_bar = bool(stp.bars_x) and end - stp.bars_x[-1] <= 2.0 * res.sp
    stp.end_gap_sp = (end - stp.bars_x[-1]) / res.sp if stp.bars_x else -1.0


def _x0(s: Strip) -> int:
    """Staff start in the strip image; a scan's staff can start left of the
    crop (negative staff_x0)."""
    return max(0, s.staff_x0)


def _single(s: Strip) -> bool:
    return abs((s.staff_bottom - s.staff_top) - 4 * s.sp) <= 0.8 * s.sp


def _band(s: Strip) -> np.ndarray:
    """Own ink around the staff (1.5 sp above and below), staff lines
    removed, rows relative to the top line; header text and a system
    barline at the staff start excluded."""
    sp = s.sp
    h = int((s.staff_bottom - s.staff_top) + 3 * sp)
    r0 = int(round(s.staff_top - 1.5 * sp))
    img = s.img & ~s.hdr
    out = np.zeros((h, img.shape[1]), bool)
    a0, a1 = max(0, r0), min(img.shape[0], r0 + h)
    out[a0 - r0:a1 - r0] = img[a0:a1]
    # system barline left of the clef: ink over the whole staff height
    # (measured before the staff lines go)
    x0 = _x0(s)
    t, b = int(1.5 * sp), int(1.5 * sp + (s.staff_bottom - s.staff_top))
    hit = [x for x in range(max(0, x0 - int(0.3 * sp)), min(out.shape[1], x0 + int(0.6 * sp)))
           if out[t:b, x:x + 3].any(axis=1).mean() > 0.6]   # scans: slanted, broken
    # staff lines: long horizontal runs (also on a skewed scan), and their
    # antialiased edges
    u8 = out.astype(np.uint8)
    lines = cv2.morphologyEx(u8, cv2.MORPH_OPEN,
                             np.ones((1, max(3, int(2 * sp))), np.uint8))
    lines = cv2.dilate(lines, np.ones((5, 1), np.uint8)) > 0
    out &= ~lines
    # what is left of a slanted staff line: strokes under 3 px high
    out = cv2.morphologyEx(out.astype(np.uint8), cv2.MORPH_OPEN,
                           np.ones((3, 1), np.uint8)) > 0
    for x in hit:
        out[:, x:x + 3] = False
    return out


def _diverge(a: Strip, b: Strip) -> float:
    """Distance (px, from the staff start) where the music of two lines of
    the same part stops being identical: clef and key signature are the
    same on every line, the first note is not."""
    A, B = _band(a), _band(b)
    h = min(A.shape[0], B.shape[0])
    ax, bx = _x0(a), _x0(b)
    L = int(min(A.shape[1] - ax, B.shape[1] - bx, REFLOW_MAX_PREFIX_SP * 1.6 * a.sp))
    if L <= 0 or h <= 0:
        return 0.0
    sp = a.sp
    m = int(round(0.4 * sp))                 # scans: clefs move a few px
    A = A[:h, ax:ax + L]
    v = max(2, int(round(0.2 * sp)))        # rows +-v
    Bf = np.zeros((h + 2 * v, L + 2 * m), bool)  # B padded: rows +-v, cols +-m
    seg = B[:h, max(0, bx - m):bx + L + m]
    c0 = m - (bx - max(0, bx - m))
    Bf[v:v + h, c0:c0 + seg.shape[1]] = seg
    if A.size == 0 or not Bf.any():
        return 0.0
    t_ = max(5, int(round(0.3 * sp)) | 1)    # +-3 px at 400 dpi; a pitch step is 0.5 sp
    k = np.ones((t_, t_), np.uint8)
    dA = cv2.dilate(A.astype(np.uint8), k) > 0
    w0 = min(L, int(3 * sp))                 # the clef decides the shift
    best, shift = None, (v, m)
    for dy in range(2 * v + 1):
        for dx in range(2 * m + 1):
            Bc = Bf[dy:dy + h, dx:dx + L]
            e = int((A[:, :w0] ^ Bc[:, :w0]).sum())
            if best is None or e < best:
                best, shift = e, (dy, dx)
    B = Bf[shift[0]:shift[0] + h, shift[1]:shift[1] + L]
    dB = cv2.dilate(B.astype(np.uint8), k) > 0
    mis = ((A & ~dB) | (B & ~dA)).sum(axis=0).astype(float)
    win = max(2, int(round(sp)))
    run = np.convolve(mis, np.ones(win), mode="full")[:len(mis) + win - 1]
    hit = np.flatnonzero(run >= 0.3 * sp * sp)   # a hollow note: ~0.5 sp^2
    if not hit.size:
        return float(L)
    j = max(0, int(hit[0]) - win + 1)        # window start
    first = np.flatnonzero(mis[j:j + win] > 0)
    return float(j + (first[0] if first.size else 0))


def _prefix_candidates(s_: Strip, d: float) -> list[float]:
    """Possible prefix ends (px from the staff start) of one line: the start
    of each blank gap (0.3 sp) past the clef, before the line differs from
    the others (d). With no gap at all (time signature touching the clef),
    the point where the line differs."""
    sp = s_.sp
    band = _band(s_)
    cols = band[:, _x0(s_):_x0(s_) + int(d)].any(axis=0)
    gap = max(2, int(0.3 * sp))
    lo, hi = 2.5 * sp, REFLOW_MAX_PREFIX_SP * sp
    out: list[float] = []
    run = 0
    for x in range(len(cols)):
        run = run + 1 if not cols[x] else 0
        if run == gap and x - gap + 1 >= int(lo):
            c = x - gap + 1 + int(0.15 * sp)
            if c <= hi:
                out.append(float(c))
    if not out and lo <= d - 1 <= hi:
        out.append(d - 1)
    return out


def _next_ink(s_: Strip, x: int) -> int:
    """First ink column (px from the staff start) at or after x."""
    band = _band(s_)
    cols = band[:, _x0(s_) + x:].any(axis=0)
    nz = np.flatnonzero(cols)
    return x + int(nz[0]) if nz.size else x + len(cols)


def _staff_set(s: Strip) -> tuple:
    """Names of the staves of a group line (() for a part): lines with
    other staves never share a prefix or a line."""
    return tuple(n for n, _, _ in s.staff_labels) if len(s.staff_labels) > 1 else ()


def _staff_offs(s: Strip) -> tuple:
    """Row of each group staff below the top staff line."""
    return tuple(int(t - s.staff_top) for _, t, _ in s.staff_labels) if len(s.staff_labels) > 1 else ()


def _same_stack(a: Strip, b: Strip) -> bool:
    """Same staves at the same distances (within 0.07 sp): pieces of the two
    lines can stand side by side with their staff lines joined."""
    if _staff_set(a) != _staff_set(b):
        return False
    tol = max(1.0, 0.07 * a.sp)
    return all(abs(x - y) <= tol for x, y in zip(_staff_offs(a), _staff_offs(b)))


def _group_view(s: Strip) -> Strip:
    """_group_view -> a one-staff Strip for the prefix search: the ink around
    each staff of a group line (2 sp above and below), all put on one staff
    (OR). A gap that is blank in the view is blank on every staff; lines
    differ in the view when they differ on any staff."""
    if len(s.staff_labels) < 2:
        return s
    pad = int(round(2 * s.sp))
    h = int(s.staff_labels[0][2] - s.staff_labels[0][1]) + 2 * pad
    img = np.zeros((h, s.img.shape[1]), bool)
    hdr = np.zeros_like(img)
    num = np.zeros_like(img)
    for k, (_, t, b) in enumerate(s.staff_labels):
        a0 = int(t) - pad
        r0, r1 = max(0, a0), min(s.img.shape[0], a0 + h)
        sl = slice(r0 - a0, r1 - a0)
        # the staves' own ink only: the first one keeps the header
        img[sl] |= s.img[r0:r1]
        if k == 0:
            hdr[sl] |= s.hdr[r0:r1]
        if s.num_mask is not None:
            num[sl] |= s.num_mask[r0:r1]
    st = dc_replace(s, img=img, hdr=hdr, num_mask=num if num.any() else None,
                    staff_top=pad, staff_bottom=pad + int(s.staff_labels[0][2] - s.staff_labels[0][1]),
                    staff_labels=[], bracket=False)
    return st


def find_prefixes(strips: list[Strip]) -> list[tuple[int, int] | None]:
    """find_prefixes -> per strip (start, donor) or None.
    start: x (img) where the music of the line's first bar starts; donor:
    the strip whose columns 0..its start are the clef + key signature copied
    to the front of a continuation line. None: the line is never cut.

    Clef and key signature are the same on every line of a movement; the
    first notes are not. The prefix ends at a blank gap (0.3 sp) that at
    least half of the movement's lines (2 or more) have at the same x
    (0.4 sp), the last such gap. A line takes it only when its music
    differs right after the gap (else its key signature can be longer);
    a movement's first line (time signature, range marks) is exempt. A
    line with no such gap (a note close to the clef) keeps its own clef
    in its first bar and borrows the copy from a line of the movement
    that is identical up to that line's prefix. One-line movements give None.
    Group lines (several staves, 0.3.0-dev.34) are searched in a one-staff
    view of all their staves (_group_view); a movement is also split where
    the staves of the lines change, and a line borrows a prefix only from a
    line with the same staves at the same distances."""
    out: list[tuple[int, int] | None] = [None] * len(strips)
    orig = strips
    strips = [_group_view(s_) for s_ in orig]
    segs: list[list[int]] = []
    for i, s_ in enumerate(orig):
        if not segs or s_.movement or _staff_set(s_) != _staff_set(orig[segs[-1][-1]]):
            segs.append([i])
        else:
            segs[-1].append(i)
    for seg in segs:
        cand = [i for i in seg if _single(strips[i])]
        if len(cand) < 2:
            continue
        sp = strips[cand[0]].sp
        tol = 0.4 * sp
        cs, dd, f0 = {}, {}, {}
        for i in cand:
            # compared with the 6 nearest lines of the movement (enough for a
            # median; all pairs cost minutes on a long piece)
            near = sorted((j for j in cand if j != i), key=lambda j: abs(j - i))[:6]
            dd[i] = float(np.median([_diverge(strips[i], strips[j]) for j in near]))
            f0[i] = _next_ink(strips[i], 0)   # clef start: steadier than the staff start on scans
            cs[i] = [c - f0[i] for c in _prefix_candidates(strips[i], dd[i])]
        core = [i for i in cand if not strips[i].movement]
        if len(core) < 2:
            core = cand
        need = max(2, (len(core) + 1) // 2)
        allc = sorted({round(x) for i in core for x in cs[i]})
        common = [x for x in allc
                  if sum(any(abs(x - y) <= tol for y in cs[j]) for j in core) >= need]
        if not common:
            continue
        X = max(common)
        own: dict[int, int] = {}
        for i in cand:
            near = [y for y in cs[i] if abs(y - X) <= tol]
            if not near:
                continue
            y = int(min(near, key=lambda v: abs(v - X)) + f0[i])
            if not strips[i].movement and dd[i] > _next_ink(strips[i], y) + 0.5 * sp:
                continue                      # same music after the gap: too short
            own[i] = y
        if not own:
            continue
        for i in cand:
            if i in own:
                out[i] = (_x0(strips[i]) + own[i], i)
                continue
            # nearest line with its own prefix that matches this one up to it
            for k in sorted(own, key=lambda k: abs(k - i)):
                if _same_stack(orig[i], orig[k]) \
                   and _diverge(strips[i], strips[k]) >= own[k] - 0.5 * sp:
                    out[i] = (0, k)
                    break
    return out


def _break_lines(widths: list[float], pre: float, W: float) -> list[int]:
    """Balanced line breaks: bar widths, prefix width, line width -> the
    index of the first bar of each line. Minimises the squared slack of
    every line but the last (a single bar wider than a line stands alone)."""
    n = len(widths)
    best = [0.0] + [float("inf")] * n
    prev = [0] * (n + 1)
    for j in range(1, n + 1):
        tot = pre
        for i in range(j, 0, -1):
            tot += widths[i - 1]
            if tot > W and i < j:
                break
            cost = 0.0 if j == n else (max(0.0, W - tot)) ** 2
            if best[i - 1] + cost < best[j]:
                best[j] = best[i - 1] + cost
                prev[j] = i - 1
    starts, j = [], n
    while j > 0:
        starts.append(prev[j])
        j = prev[j]
    return sorted(starts)


def _compose(pieces: list[tuple[Strip, int, int, bool]]) -> tuple[np.ndarray, np.ndarray, int]:
    """Join crops of strips side by side, aligned on the top staff line.
    pieces: (strip, x0, x1, keep header). -> (img, hdr, staff_top row)."""
    above = max(p[0].staff_top for p in pieces)
    below = max(p[0].img.shape[0] - p[0].staff_top for p in pieces)
    width = sum(p[2] - p[1] for p in pieces)
    img = np.zeros((above + below, width), bool)
    hdr = np.zeros_like(img)
    x = 0
    for s_, x0, x1, keep in pieces:
        y = above - s_.staff_top
        src, hsrc = s_.img, s_.hdr
        if s_.num_mask is not None:          # printed numbers: wrong place once re-flowed
            src, hsrc = src & ~s_.num_mask, hsrc & ~s_.num_mask
        part = src[:, x0:x1]
        hpart = hsrc[:, x0:x1]
        if not keep:
            part = part & ~hpart
            hpart = np.zeros_like(hpart)
        img[y:y + part.shape[0], x:x + part.shape[1]] |= part
        hdr[y:y + part.shape[0], x:x + part.shape[1]] |= hpart
        x += x1 - x0
    return img, hdr, above


def reflow(strips: list[Strip], W: float, pre: list | None = None) -> list[Strip]:
    """reflow -> new lines no wider than W (px, where possible), cut only
    at barlines. A continuation line starts with a copy of the clef and key
    signature of its source line (header text not copied). Lines that
    cannot be cut safely (no prefix found, not ending at a barline, two
    staves) stay whole. A movement always starts a new line; bars of two
    source lines join only when their prefixes are the same."""
    pre = find_prefixes(strips) if pre is None else pre
    bw = lambda s_: max(1, int(0.2 * s_.sp))         # barline width kept left
    units: list[list] = []        # runs of bars that may share lines
    for i, s_ in enumerate(strips):
        cut = pre[i] is not None and s_.ends_at_bar and len(s_.bars_x) >= 2
        cw = lambda j: pre[pre[j][1]][0]                # copy width of line j
        if not cut:
            units.append([("whole", i)])
            continue
        # a line with a borrowed prefix keeps its own clef in its first
        # bar: that bar must start a line
        same = (units and units[-1][0][0] == "bar" and not s_.movement
                and pre[i][0] > 0)
        if same:
            j = units[-1][-1][1]
            dj, di = pre[j][1], pre[i][1]
            if abs((cw(j) - _x0(strips[dj])) - (cw(i) - _x0(strips[di]))) > 0.5 * s_.sp \
               or _diverge(_group_view(strips[dj]), _group_view(strips[di])) \
               < (cw(i) - _x0(strips[di])) - 0.5 * s_.sp \
               or not _same_stack(strips[j], s_):
                same = False
        if not same:
            units.append([])
        for b in range(len(s_.bars_x)):
            units[-1].append(("bar", i, b))
    out: list[Strip] = []
    for unit in units:
        if unit[0][0] == "whole":
            out.append(strips[unit[0][1]])
            continue
        bars = [(t[1], t[2]) for t in unit]

        def span(i, b):
            s_ = strips[i]
            x0 = pre[i][0] if b == 0 else s_.bars_x[b - 1] + bw(s_)
            if b == len(s_.bars_x) - 1:              # line end: whole final/repeat barline
                return x0, s_.img.shape[1]
            x1 = min(s_.img.shape[1], s_.bars_x[b] + bw(s_))
            return x0, x1
        widths = [span(i, b)[1] - span(i, b)[0] for i, b in bars]
        i0 = bars[0][0]
        starts = _break_lines(widths, pre[pre[i0][1]][0], W)
        for k, a in enumerate(starts):
            z = starts[k + 1] if k + 1 < len(starts) else len(bars)
            i, b = bars[a]
            s_ = strips[i]
            if b == 0:                               # real start: own clef, header
                pieces = [(s_, 0, pre[i][0], True)] if pre[i][0] > 0 else []
            else:                                    # continuation: copied clef + key
                k_ = pre[i][1]
                pieces = [(strips[k_], 0, pre[k_][0], False)]
            for ii, bb in bars[a:z]:
                x0, x1 = span(ii, bb)
                pieces.append((strips[ii], x0, x1, True))
            img, hdr, top = _compose(pieces)
            # rehearsal marks move with their bars: a mark stands at the
            # barline before its bar (or the line start for bar 0); a copied
            # prefix carries none
            marks, x = [], 0
            for n_, (ps, x0, x1, keep) in enumerate(pieces):
                lo = x0 - 2 * bw(ps) if n_ > 0 else 0
                hi = x1 - 2 * bw(ps)
                if n_ > 0 or keep:
                    for mx, t in ps.marks:
                        if (lo <= mx < hi) and not (n_ == 0 and mx >= x1):
                            marks.append((x + max(0, mx - x0), t))
                x += x1 - x0
            if b < len(s_.bar_nums):
                num = s_.bar_nums[b]
            elif s_.bar_no is not None:
                num = s_.bar_no + b
            else:
                num = None
            first_of_mvt = s_.movement and b == 0
            show = None if (first_of_mvt or num is None or num < 1) else num
            line = Strip(img, s_.staff_x0, top, top + (s_.staff_bottom - s_.staff_top),
                         s_.sp, hdr, show, s_.bar_raise, s_.bar_size,
                         marks=sorted(set(marks)), movement=first_of_mvt,
                         bracket=s_.bracket,
                         staff_labels=[(n, t - s_.staff_top + top, b - s_.staff_top + top)
                                       for n, t, b in s_.staff_labels])
            out.append(line)
    return out


def whole_reason(s_: Strip, p) -> str:
    """whole_reason -> why re-flow keeps a line whole ('' when it is cut)."""
    if s_.rest_src is not None:
        return "multi-bar rest"
    if not s_.ends_at_bar:
        gap = f" (last barline {s_.end_gap_sp:.1f} sp before the staff end)" if s_.end_gap_sp >= 0 else ""
        return s_.bars_why or "the line does not end at a barline" + gap
    if len(s_.bars_x) < 2:
        return s_.bars_why or "one bar"
    if p is None:
        return "no clef and key prefix found"
    return ""


def reflow_report(strips: list[Strip], pre: list) -> str:
    """reflow_report -> one text line for the build: how many lines can be
    cut, the reasons for the others, and the widest line that stays whole
    (it sets the largest staff re-flow can reach)."""
    why = [whole_reason(s_, pre[i]) for i, s_ in enumerate(strips)]
    whole = [i for i, w in enumerate(why) if w]
    kinds: dict[str, int] = {}
    for i in whole:
        kinds[why[i]] = kinds.get(why[i], 0) + 1
    txt = f"re-flow: {len(strips) - len(whole)} of {len(strips)} lines can be cut"
    if not whole:
        return txt
    txt += "; whole: " + ", ".join(f"{n} {k}" for k, n in sorted(kinds.items(), key=lambda t: -t[1]))
    sp = strips[0].sp
    w = max((i for i in whole if strips[i].rest_src is None),
            key=lambda i: strips[i].img.shape[1], default=None)
    if w is not None:
        txt += (f"; widest whole line {strips[w].img.shape[1] / sp:.0f} sp "
                f"(line {w + 1}: {why[w]})")
    return txt


def reflow_caps(strips: list[Strip], pre: list | None = None) -> float:
    """Widest piece that can never be cut (px): a whole line that stays
    whole, or prefix + the widest bar. The line width may not be smaller."""
    pre = find_prefixes(strips) if pre is None else pre
    widest = 0.0
    for i, s_ in enumerate(strips):
        if pre[i] is None or not s_.ends_at_bar or len(s_.bars_x) < 2:
            widest = max(widest, s_.img.shape[1])
        else:
            edges = [pre[i][0]] + s_.bars_x
            copy = pre[pre[i][1]][0]
            widest = max(widest, pre[i][0] + edges[1] - edges[0],
                         copy + max(b - a for a, b in zip(edges[1:], edges[2:])))
    return widest


# =============================================================================
# Line width, indent, labels (engraved-part look)
# =============================================================================
INDENT_MIN_SP = 4.0     # a first line this much shorter is indented, not stretched
INDENT_MAX = 0.15       # largest first-line indent, share of the line width
RAGGED_LAST = 0.6       # a movement's last line below this share of the width stays short
NAME_SP = (2.0, 1.2)    # part name in the indent: largest, smallest size (sp)
LABEL_SP = 1.5          # group staff label size (sp)


def anchor(s: Strip) -> int:
    """Alignment line of a strip (px in img): the staff start, less the
    indent. Every line of a part puts this column at the left margin."""
    return s.staff_x0 - s.indent


def pad_left(s: Strip, n: int) -> Strip:
    """pad_left -> strip with n blank columns at the left, kept as indent."""
    if n <= 0:
        return s
    pw = ((0, 0), (n, 0))
    return dc_replace(
        s, img=np.pad(s.img, pw), hdr=np.pad(s.hdr, pw),
        num_mask=None if s.num_mask is None else np.pad(s.num_mask, pw),
        staff_x0=s.staff_x0 + n, indent=s.indent + n,
        marks=[(mx + n, t) for mx, t in s.marks],
        bars_x=[b + n for b in s.bars_x],
        rest_label=None if s.rest_label is None else (s.rest_label[0] + n, s.rest_label[1]))


def staff_end(s: Strip) -> int:
    """Last column (img) where 3 of the 5 lines of the top staff have ink."""
    hits = np.zeros(s.img.shape[1], np.int16)
    for kk in range(5):
        y = int(round(s.staff_top + kk * s.sp))
        band = s.img[max(0, y - 1):y + 2]
        if band.size:
            hits += band.any(axis=0)
    cols = np.flatnonzero(hits >= 3)
    return int(cols.max()) if cols.size else s.img.shape[1] - 1


def justify(s: Strip, target: int) -> Strip:
    """justify -> the line stretched so its staff is target px long (from
    the staff start). Space is added only in blank gaps between glyphs
    (columns with staff lines only, 0.25 sp or wider), the same amount in
    each gap, after the clef; engraved glyphs are never stretched. A
    multi-bar rest line is drawn again at the width."""
    if s.rest_src is not None:
        src, cw, run = s.rest_src
        r = make_rest_strip(s, src, cw, run, {"bar_raise": s.bar_raise,
                                              "bar_size": s.bar_size},
                            staff_len=target)
        r = dc_replace(r, bracket=s.bracket)     # drawn again: keep the group bracket
        return pad_left(dc_replace(r, name_label=s.name_label), s.indent) if s.indent else r
    sp = s.sp
    end = staff_end(s)
    extra = target - (end - s.staff_x0)
    if extra < 0.3 * sp:
        return s
    x0 = s.staff_x0 + int(4.5 * sp)
    x1 = end - int(0.3 * sp)
    if x1 <= x0:
        return s
    rows = s.img[:, x0:x1].mean(axis=1) > 0.6            # staff line rows
    rows = cv2.dilate(rows.astype(np.uint8)[:, None], np.ones((5, 1), np.uint8))[:, 0] > 0
    ink = s.img & ~rows[:, None]
    # text (lyrics, titles) lies outside the staff band: a gap between its
    # letters is no gap; widen that ink by 0.7 sp each side
    b0 = max(0, int(s.staff_top - 1.5 * sp))
    b1 = min(s.img.shape[0], int(s.staff_bottom + 1.5 * sp))
    outer = ink.copy()
    outer[b0:b1] = False
    k_ = np.ones((1, 2 * int(0.7 * sp) + 1), np.uint8)
    outer = cv2.dilate(outer.astype(np.uint8), k_) > 0
    other = ink[b0:b1].any(axis=0) | outer.any(axis=0)
    elig = np.zeros(s.img.shape[1], bool)
    elig[x0:x1] = ~other[x0:x1]
    d = np.diff(np.concatenate(([0], elig.astype(np.int8), [0])))
    runs = [(a, b) for a, b in zip(np.flatnonzero(d == 1), np.flatnonzero(d == -1))
            if b - a >= max(2, int(0.25 * sp))]
    if not runs:
        return s
    counts = np.ones(s.img.shape[1], np.int64)
    base, rem = divmod(int(extra), len(runs))
    for j, (a, b) in enumerate(runs):
        counts[(a + b) // 2] += base + (1 if j < rem else 0)
    start = np.cumsum(counts) - counts                   # new x of each old column
    rp = lambda m: None if m is None else np.repeat(m, counts, axis=1)
    return dc_replace(
        s, img=rp(s.img), hdr=rp(s.hdr), num_mask=rp(s.num_mask),
        marks=[(int(start[min(mx, len(start) - 1)]), t) for mx, t in s.marks],
        bars_x=[int(start[min(b, len(start) - 1)]) for b in s.bars_x])


def short_name(name: str) -> str:
    """Abbreviation for a group staff label: words of 5+ letters cut to 3
    and a full stop; numbers, roman numerals and short words kept
    ('Basso Trombone grosso' -> 'Bas. Tro. gro.')."""
    out = []
    for w in name.split():
        if len(w) >= 5 and w.isalpha() and w.lower() not in _NUMERALS:
            out.append(w[:3] + ".")
        else:
            out.append(w)
    return " ".join(out)


def line_labels(s: Strip) -> list[tuple[str, float, float, float, bool]]:
    """line_labels -> [(text, right x, baseline, size, small caps)] in strip
    px: the part name in the indent of the first line, or the label of
    each group staff, right-aligned 1 sp before the staff start and
    centred on the staff."""
    out = []
    xr = s.staff_x0 - (2.0 if s.bracket else 1.0) * s.sp     # clear of the bracket
    room = xr - (anchor(s) + 0.5 * s.sp)
    if s.name_label and room > 0:
        fs = NAME_SP[0] * s.sp
        w = smallcaps_len(s.name_label, fs)
        if w > room:
            fs *= room / w
        if fs >= NAME_SP[1] * s.sp:
            mid = (s.staff_top + s.staff_bottom) / 2
            out.append((s.name_label, xr, mid + 0.33 * fs, fs, True))
    for name, t, b in s.staff_labels:
        fs = LABEL_SP * s.sp
        out.append((name, xr, (t + b) / 2 + 0.35 * fs, fs, False))
    return out


def _smallcaps_runs(text: str, size: float) -> list[tuple[str, float]]:
    return [(ch.upper(), size * (0.78 if ch.islower() else 1.0)) for ch in text]


def smallcaps_len(text: str, size: float) -> float:
    return sum(text_len(ch, "regular", fs) for ch, fs in _smallcaps_runs(text, size))


def put_smallcaps(page: pymupdf.Page, x_right: float, base: float, text: str,
                  size: float) -> None:
    """Small caps from EB Garamond Regular (capitals at 78 % for lower
    case), right-aligned at x_right."""
    x = x_right - smallcaps_len(text, size)
    for ch, fs in _smallcaps_runs(text, size):
        put_text(page, (x, base), ch, "regular", fs)
        x += text_len(ch, "regular", fs)


AMB_W_SP = 8.0          # ambitus width in staff spaces (ambitus_width / sp)


def finish_lines(strips: list[Strip], name: str, group: bool,
                 amb: tuple | None = None, amb_map: dict | None = None) -> list[Strip]:
    """finish_lines -> the lines of one part or group at one width: the
    longest staff sets it; other lines are justified (a movement's short
    last line stays short). A first line shorter by INDENT_MIN_SP or more
    is right-aligned (indented) with the part name in small caps. Group
    lines: when the staves differ from line to line, every staff is
    labelled (short names) in an indent; else the first line has the full
    names. amb (a part) / amb_map (a group: part -> ambitus): the ambitus
    takes the place of the name on the first line, as engravers set it
    (operator request 2026-10-25); the first line is indented for it when there is
    room (else the ambitus stays beside the part name in the heading)."""
    if not strips:
        return strips
    sp = strips[0].sp
    ends = [staff_end(s) - s.staff_x0 for s in strips if s.rest_src is None]
    target = max(ends) if ends else max(s.img.shape[1] - s.staff_x0 for s in strips)
    out: list[Strip] = []
    for i, s in enumerate(strips):
        length = staff_end(s) - s.staff_x0
        last_of_mvt = i + 1 == len(strips) or strips[i + 1].movement
        amb_w = (AMB_W_SP + 1.5) * sp
        if i == 0 and not group and s.rest_src is None and amb \
           and target - length >= amb_w:
            # the ambitus in the first-line indent, in place of the name
            ind = int(min(max(target - length, amb_w), INDENT_MAX * target))
            if 0 < target - ind - length < 0.3 * sp:
                ind = target - length
            s = pad_left(justify(s, target - ind), ind)
            s = dc_replace(s, ambitus_marks=[(int(s.staff_x0 - 1.0 * sp - AMB_W_SP * sp),
                                              int(round(s.staff_bottom)), *amb)])
        elif i == 0 and not group and s.rest_src is None \
           and target - length >= INDENT_MIN_SP * sp:
            # engraved first line: indented by room for the name (at least
            # the source indent, at most INDENT_MAX of the width), the rest
            # justified
            want = smallcaps_len(name, NAME_SP[0] * sp) + 2.0 * sp
            ind = int(min(max(target - length, want), INDENT_MAX * target))
            if 0 < target - ind - length < 0.3 * sp:   # too little left to justify
                ind = target - length
            s = dc_replace(pad_left(justify(s, target - ind), ind), name_label=name)
        elif s.rest_src is not None or not (last_of_mvt and length < RAGGED_LAST * target):
            s = justify(s, target)
        out.append(s)
    if group and any(s.staff_labels for s in out):
        # one label column on every line (else the lines with names would
        # stick out at the right): short names, full names on the first
        # line where they fit the column
        size = LABEL_SP * sp
        shorts = {n: short_name(n) for s in out for n, *_ in s.staff_labels}
        col_w = max(text_len(v, "regular", size) for v in shorts.values())
        col = int(col_w + 3.0 * sp)
        if amb_map and any(amb_map.values()):
            # the first line shows each staff's ambitus instead of its name
            col = max(col, int((AMB_W_SP + 3.0) * sp))
        fin = []
        for j, s in enumerate(out):
            names, marks = [], []
            p_ = pad_left(s, col)
            for n, t, b in s.staff_labels:
                a_ = (amb_map or {}).get(n) if j == 0 else None
                if a_:
                    xl = p_.staff_x0 - (2.0 if p_.bracket else 1.0) * sp - AMB_W_SP * sp
                    marks.append((int(xl), int(round(b)), *a_))
                    continue
                full_fits = text_len(n, "regular", size) <= col_w
                names.append((n if (j == 0 and full_fits) else shorts[n], t, b))
            fin.append(dc_replace(p_, staff_labels=names, ambitus_marks=marks))
        out = fin
    return out


# =============================================================================
# Multi-bar rests
# =============================================================================
REST_BAR_SP = 26.0      # width of a multi-bar rest (H-bar) measure
REST_ONE_SP = 12.0      # width of a one-bar rest measure


def make_rest_strip(tpl: Strip, src: Strip | None, cw: int, run: RestRun,
                    opts: dict, staff_len: int | None = None) -> Strip:
    """make_rest_strip -> one line with a multi-bar rest: clef and key
    signature copied from src (columns 0..cw; none when src is None), an
    H-bar with the bar count above it (one bar: a whole rest), and a
    barline. Staff lines as in tpl (a part's nearest line)."""
    sp = tpl.sp
    top = int(round(3.5 * sp))
    if run.header is not None:                     # movement title above
        himg, hdx, hgap = run.header
        top = max(top, himg.shape[0] + max(hgap, int(round(3.5 * sp))))
    h4 = int(round(4 * sp))
    h = top + h4 + int(round(2.5 * sp))
    wr = int(round((REST_BAR_SP if run.bars > 1 else REST_ONE_SP) * sp))
    th = max(1, int(round(0.1 * sp)))
    if src is None or cw <= 0 or not _single(src):
        src, cw = None, 0
    x_staff = max(0, src.staff_x0) if src is not None else 0
    if staff_len is not None:                      # line width of the part
        wr = max(int(6 * sp), staff_len + x_staff - cw + 1)   # staff_len: to the last column
    img = np.zeros((h, cw + wr), bool)
    col = np.zeros(h, bool)
    if src is not None:
        clean = src.img & ~src.hdr
        if src.num_mask is not None:
            clean &= ~src.num_mask
        r0 = src.staff_top - top                   # src row of img row 0
        a0, a1 = max(0, r0), min(src.img.shape[0], r0 + h)
        img[a0 - r0:a1 - r0, :cw] = clean[a0:a1, :cw]
        col = img[:, cw - 1].copy()                # the prefix ends in a blank gap:
    if not col[top:top + h4 + 1].any():            # staff lines only
        for kk in range(5):
            y = top + int(round(kk * sp))
            col[y:y + th] = True
    img[:, cw:] |= col[:, None]
    x0, x1 = cw, cw + wr
    mid = top + int(round(2 * sp))
    if run.bars > 1:                               # H-bar on the middle line
        a, b = x0 + int(2 * sp), x1 - int(2 * sp)  # across the measure (engraving)
        img[mid - int(0.45 * sp):mid + int(0.45 * sp) + 1, a:b] = True
        # brackets at both ends: full staff height, 0.5 sp thick (operator request
        # 2026-10-24, twice: 0.3 sp from line 2 to 4 was not seen)
        sw = max(4, int(round(0.5 * sp)))
        for xx in (a, b - sw):
            img[top:top + h4 + th, xx:xx + sw] = True
    else:                                          # whole rest: hangs from the 2nd line
        c = (x0 + x1) // 2
        y = top + int(round(sp))
        img[y:y + int(round(0.5 * sp)), c - int(0.6 * sp):c + int(0.6 * sp)] = True
    bw = max(2, int(round(0.16 * sp)))
    img[top:top + h4 + 1, x1 - bw:x1] = True       # closing barline
    hdr = np.zeros_like(img)
    if run.header is not None:
        hx = max(0, x_staff + hdx)
        if hx + himg.shape[1] > img.shape[1]:      # a long title widens the line
            pad = hx + himg.shape[1] - img.shape[1]
            img = np.pad(img, ((0, 0), (0, pad)))
            hdr = np.pad(hdr, ((0, 0), (0, pad)))
        y1 = top - max(hgap, int(round(3.5 * sp)))
        hdr[y1 - himg.shape[0]:y1, hx:hx + himg.shape[1]] = himg
        img |= hdr
    return Strip(img, x_staff, top, top + h4, sp, hdr,
                 None if run.movement or run.first is None else run.first,
                 opts.get("bar_raise", 1.0), opts.get("bar_size", 2.0),
                 movement=run.movement,
                 rest_label=((x0 + x1) / 2, str(run.bars)) if run.bars > 1 else None,
                 rest_src=(src, cw, run))


def fill_rests(items: list, opts: dict) -> list[Strip]:
    """fill_rests -> strips of one part with each run of RestRun items
    (systems without the part's staff) made one multi-bar rest line; a
    movement start begins a new run. The clef and key come from the
    part's line before the run (after it, for a run at the start)."""
    real = [x for x in items if isinstance(x, Strip)]
    if not real:
        return []
    if not any(isinstance(x, RestRun) for x in items):
        return real
    pre = find_prefixes(real)
    where = {id(x): i for i, x in enumerate(real)}
    out: list[Strip] = []
    run: RestRun | None = None
    run_at = 0

    def flush(k_next: int) -> None:
        nonlocal run
        if run is None:
            return
        before = [x for x in items[:run_at] if isinstance(x, Strip)]
        after = [x for x in items[k_next:] if isinstance(x, Strip)]
        tpl = before[-1] if before else after[0]
        ti = where[id(tpl)]
        p = pre[ti]
        src, cw = (real[p[1]], pre[p[1]][0]) if p else (None, 0)
        if p is None and _single(tpl):
            # no prefix for the line (one line in its movement): borrow the
            # nearest line's clef and key if this line starts the same way
            for j in sorted(range(len(real)), key=lambda j: abs(j - ti)):
                q = pre[j]
                if q is None:
                    continue
                d_, c_ = real[q[1]], pre[q[1]][0]
                if _diverge(tpl, d_) >= (c_ - _x0(d_)) - 0.5 * tpl.sp:
                    src, cw = d_, c_
                    break
        out.append(make_rest_strip(tpl, src, cw, run, opts))
        run = None

    for k, x in enumerate(items):
        if isinstance(x, RestRun):
            if run is not None and not x.movement:
                run.bars += x.bars
            else:
                flush(k)
                run, run_at = RestRun(x.bars, x.first, x.movement, x.header), k
        else:
            flush(k)
            out.append(x)
    flush(len(items))
    return out


# =============================================================================
# Packing and rendering
# =============================================================================
# (width, height) in pt, as the sheet is printed. ledger = 17 x 11 in,
# landscape (0.3.0-dev.35): the same height as Letter, 2.2 x the line width.
PAPER = {"a4": (595.28, 841.89), "letter": (612.0, 792.0), "ledger": (1224.0, 792.0)}
MARGIN = 42.5        # pt (15 mm), default margin (tests)
MIN_MARGIN_MM = 5.0  # no margin below this (printer edge)
TITLE_BAND = 85.0    # pt, page 1
RUN_HEAD = 22.0      # pt, later pages


def _profiles_cached(s: Strip, nbins: int) -> tuple:
    if getattr(s, "_prof", None) is None:
        s._prof = profiles(s, nbins, s.sp)          # type: ignore[attr-defined]
    return s._prof                                   # type: ignore[attr-defined]


GROUP_REFLOW_PAGES = 1.5  # group re-flow, pages=auto: page budget / pages without re-flow
SYSTEM_GAP_LAST = 2.0     # the same on a last page with room to spare


def pitches(strips: list[Strip], opts: dict) -> list[float]:
    """pitches -> staff-top to staff-top distance (source px) after each
    strip: the constant pitch (staff height + `gap` staff spaces), larger
    only where ink of two strips would come closer than `clearance`
    (header ink: HEADER_CLEAR_SP). Constant leading, so the eye can predict
    where the next line is."""
    nb = 400
    out = []
    for a, b in zip(strips, strips[1:]):
        base = (a.staff_bottom - a.staff_top) + opts["gap"] * a.sp
        clear = opts["clearance"]
        n_st = len(a.staff_labels)
        if n_st > 1:
            # a group score: systems apart by more than their staves (operator request
            # 2026-10-24: two systems almost touched). 1.5 x the space
            # between the staves of the system, at least `gap`; ink 3 sp apart
            inner = ((a.staff_bottom - a.staff_top) - n_st * 4 * a.sp) / (n_st - 1)
            base = (a.staff_bottom - a.staff_top) + max(opts["gap"] * a.sp,
                                                        SYSTEM_GAP_FACTOR * inner)
            clear = max(clear, SYSTEM_CLEAR_SP)
        if b.movement:                 # a new movement: double leading
            base += opts["gap"] * a.sp
        _, _, pb = _profiles_cached(a, nb)
        t_own, t_hdr, _ = _profiles_cached(b, nb)
        req = 0.0
        for t, c in ((t_own, clear),
                     (t_hdr, max(clear, HEADER_CLEAR_SP))):
            both = np.isfinite(t) & np.isfinite(pb)
            if both.any():
                req = max(req, float(np.max((pb[both] - a.staff_top)
                                            - (t[both] - b.staff_top))) + c * a.sp)
        out.append(max(base, req))
    return out


def mm2pt(v: float) -> float:
    return float(v) * 72.0 / 25.4


def page_box(opts: dict, pi: int, duplex: bool) -> tuple[float, float, float, float]:
    """page_box -> (left, right, top, bottom) margins in pt for page index pi
    (0 = page 1, a recto). Double-sided: the spine margin (left on a recto,
    right on a verso) gains `gutter`/2 and the outer margin loses it, so
    the text width, and with it the staff size, is the same on every page."""
    side = mm2pt(opts.get("margin_side", 15.0))
    g = mm2pt(opts.get("gutter", 0.0)) / 2 if duplex else 0.0
    inner, outer = side + g, side - g
    left, right = (inner, outer) if pi % 2 == 0 else (outer, inner)
    return left, right, mm2pt(opts.get("margin_top", 15.0)), mm2pt(opts.get("margin_bottom", 15.0))


def check_margins(opts: dict) -> str:
    """check_margins -> error text, or '' when the margins are usable."""
    for k in ("margin_top", "margin_bottom", "margin_side"):
        if float(opts[k]) < MIN_MARGIN_MM:
            return f"{k} {opts[k]} mm is below {MIN_MARGIN_MM} mm"
    if float(opts["gutter"]) < 0:
        return "gutter must not be negative"
    if float(opts["margin_side"]) - float(opts["gutter"]) / 2 < MIN_MARGIN_MM:
        return (f"gutter {opts['gutter']} mm leaves an outer margin below "
                f"{MIN_MARGIN_MM} mm (margin_side {opts['margin_side']} mm)")
    if opts["duplex"] not in ("auto", "on", "off"):
        return f"duplex must be auto, on or off (not {opts['duplex']})"
    return ""


def is_duplex(opts: dict, npages: int) -> bool:
    d = opts.get("duplex", "auto")
    return d == "on" or (d == "auto" and npages > 2)


MIN_LAST_LINES = 3    # a part's last page holds at least this many lines


def pack(strips: list[Strip], dpi: int, opts: dict
         ) -> list[list[tuple[Strip, float]]]:
    """pack -> pages of (strip, y of the strip image top, pt within the
    content area). Strips follow at constant pitch (see pitches); a strip
    that does not fit goes to the next page. Free space stays at the
    bottom of the page. A last page with fewer than MIN_LAST_LINES lines
    takes lines from the pages before it (largest lines-per-page limit
    that gives it enough), with the same page count."""
    pages = _pack(strips, dpi, opts, None)
    n, total = len(pages), len(strips)
    need = min(MIN_LAST_LINES, total // n) if n > 1 else 0
    if n > 1 and len(pages[-1]) < need:
        for cap in range(max(len(p) for p in pages) - 1, -(-total // n) - 1, -1):
            alt = _pack(strips, dpi, opts, cap)
            if len(alt) == n and len(alt[-1]) >= need:
                return alt
    return pages


def _pack(strips: list[Strip], dpi: int, opts: dict, cap: int | None
          ) -> list[list[tuple[Strip, float]]]:
    """Greedy packing; cap = most lines per page (None: no limit)."""
    _, ph = PAPER[opts["paper"]]
    k = 72.0 / dpi * (opts.get("scale") or 1.0)
    pit = pitches(strips, opts)
    _, _, mt, mb = page_box(opts, 0, False)
    avail1 = ph - mt - mb - (RUN_HEAD if opts.get("_no_band") else TITLE_BAND)
    availn = ph - mt - mb - RUN_HEAD
    pages: list[list[tuple[Strip, float]]] = [[]]
    y_top = 0.0
    for i, s in enumerate(strips):
        avail = avail1 if len(pages) == 1 else availn
        if pages[-1]:
            y_top += pit[i - 1] * k
            y_img = y_top - s.staff_top * k
            if y_img + s.img.shape[0] * k > avail or (cap and len(pages[-1]) >= cap):
                pages.append([])
        if not pages[-1]:
            y_img = 0.0
            y_top = s.staff_top * k
        pages[-1].append((s, y_img))
    return pages


def turns(npages: int) -> int:
    """Page turns of a part printed as facing pages (1-2: 0, 3-4: 1)."""
    return max(0, (npages - 1) // 2)


def choose_layout(strips: list[Strip], dpi: int, opts: dict
                  ) -> tuple[float, float, int]:
    """choose_layout -> (scale, gap, pages). DESIGN.md §5.2:
    fewest page turns first (a smaller staff and 2 pages is better than a
    larger staff and 3 pages), then the largest staff (down to
    `min_staff_mm`), then the widest gap from `gap` down to `gap_min`.
    `page_count` (when set) is a hard target instead of the turn rule."""
    smax = fit_scale(strips, dpi, opts)
    h_px = 4.0 * strips[0].sp       # one staff (a part may have two staves)

    def mm(sc: float) -> float:
        return h_px * 72.0 / dpi * sc * 25.4 / 72.0

    scales = [smax]
    while mm(scales[-1] - 0.02) >= opts["min_staff_mm"] and scales[-1] - 0.02 > 0.3:
        scales.append(scales[-1] - 0.02)
    gaps = list(np.arange(opts["gap"], opts["gap_min"] - 1e-9, -0.25)) or [opts["gap"]]

    def npages(sc: float, g: float) -> int:
        # content pages (a title page adds none: the first turn is before
        # the music, DESIGN.md §5.4)
        return len(layout_pages(strips, dpi, {**opts, "scale": sc, "gap": float(g)})[0])

    target = opts.get("page_count")
    if target:
        for sc in scales:
            for g in gaps:
                n = npages(sc, g)
                if n <= target:
                    return sc, float(g), n
        sc, g = scales[-1], gaps[-1]
        return sc, float(g), npages(sc, g)
    if opts["paper"] in config.SIZE_FIRST:
        # ledger (0.3.0-dev.36; operator request 2026-10-27): the staff is as large as
        # the page width and max_staff_mm allow; pages and turns follow
        sc = scales[0]
        best = turns(npages(sc, gaps[-1]))
    else:
        best = min(turns(npages(sc, gaps[-1])) for sc in scales)
        sc = next(sc for sc in scales if turns(npages(sc, gaps[-1])) == best)
    for g in gaps:
        n = npages(sc, g)
        if turns(n) == best:
            return sc, float(g), n
    return sc, float(gaps[-1]), npages(sc, gaps[-1])


def choose_reflow(strips: list[Strip], dpi: int, opts: dict, pre: list | None = None,
                  floor_scale: float | None = None
                  ) -> tuple[float, float, int, list[Strip]]:
    """choose_reflow -> (scale, gap, content pages, lines) for a re-flowed
    part. Same order as choose_layout (fewest page turns, then the largest
    staff, then the widest gap), with the staff up to `max_staff_mm`: the
    line length follows the staff size, never shorter than needed.
    pre: find_prefixes(strips) when the caller has it. floor_scale: the
    smallest scale tried, when lower than `min_staff_mm` gives (a page
    budget below the size of the source lines must still find a layout)."""
    pw, _ = PAPER[opts["paper"]]
    usable = pw - 2 * mm2pt(opts.get("margin_side", 15.0))
    sp = strips[0].sp
    pre = find_prefixes(strips) if pre is None else pre
    cap_px = reflow_caps(strips, pre)
    s_hi = min(opts["max_staff_mm"] * dpi / (4 * sp * 25.4),
               usable * dpi / 72.0 / max(cap_px, 1.0))
    floor = opts["min_staff_mm"] * dpi / (4 * sp * 25.4)
    if floor_scale is not None:
        floor = min(floor, floor_scale)
    scales = [s_hi]
    while scales[-1] * 0.97 >= floor and len(scales) < 60:
        scales.append(scales[-1] * 0.97)
    gaps = list(np.arange(opts["gap"], opts["gap_min"] - 1e-9, -0.25)) or [opts["gap"]]
    cache: dict[float, list[Strip]] = {}

    def lines(sc: float) -> list[Strip]:
        if sc not in cache:
            k = 72.0 / dpi * sc
            cache[sc] = reflow(strips, 0.98 * usable / k, pre)
        return cache[sc]

    def npages(sc: float, g: float) -> int:
        return len(layout_pages(lines(sc), dpi, {**opts, "scale": sc, "gap": float(g)})[0])

    target = opts.get("page_count")
    if target:                        # the largest staff that fits N pages
        for sc in scales:
            for g in gaps:
                if npages(sc, g) <= target:
                    return sc, float(g), npages(sc, g), lines(sc)
        sc, g = scales[-1], gaps[-1]
        return sc, float(g), npages(sc, g), lines(sc)
    # re-flow is chosen for size: the largest staff (max_staff_mm, or what
    # the widest uncut piece allows); the page count follows. Among gaps,
    # the widest with the fewest page turns at that size.
    sc = scales[0]
    best = min(turns(npages(sc, g)) for g in gaps)
    for g in gaps:
        if turns(npages(sc, g)) == best:
            return sc, float(g), npages(sc, g), lines(sc)
    return sc, float(gaps[-1]), npages(sc, gaps[-1]), lines(sc)


def fit_scale(strips: list[Strip], dpi: int, opts: dict) -> float:
    """Largest scale <= opts.scale whose widest strip fits the page width."""
    pw, _ = PAPER[opts["paper"]]
    usable = pw - 2 * mm2pt(opts.get("margin_side", 15.0))
    widest = max(s.img.shape[1] for s in strips) * 72.0 / dpi
    # ceiling: `scale` when set, else the size that gives max_staff_mm
    cap = opts.get("scale") or (opts.get("max_staff_mm", 8.0) * dpi
                                / (4 * strips[0].sp * 25.4))
    return min(cap, usable / widest)


LARGE = {"letter": ((792.0, 1224.0), "11x17"),      # Letter -> 11x17 (ledger)
         "a4": ((841.89, 1190.55), "A3")}           # A4 -> A3 (exact sqrt 2)
CROP_MARK = (14.4, 50.4)   # pt from each side edge: the cut line marks


def large_copy(src: Path, paper: str) -> Path:
    """large_copy -> path of the large-print copy of a part: each page
    scaled to the full width of the larger sheet (Letter -> 11x17, x1.294;
    A4 -> A3, x1.414), at the top of the sheet. Where the scaled page is
    shorter than the sheet (11x17: 14.24 in of 17 in), short crop marks at
    both sides show the cut line."""
    (sw, sh), tag = LARGE[paper]
    pw, ph = PAPER[paper]
    f = sw / pw
    out = src.with_name(f"{src.stem}-{tag}.pdf")
    doc = pymupdf.open(src)
    big = pymupdf.open()
    for pno in range(len(doc)):
        page = big.new_page(width=sw, height=sh)
        page.show_pdf_page(pymupdf.Rect(0, 0, sw, ph * f), doc, pno)
        cut = ph * f
        if sh - cut > 1.0:
            for a, b in ((CROP_MARK[0], CROP_MARK[1]), (sw - CROP_MARK[1], sw - CROP_MARK[0])):
                page.draw_line((a, cut), (b, cut), color=(0, 0, 0), width=0.5)
    big.save(out, garbage=3, deflate=True)
    return out


LAST_RENDER: dict = {}      # content pages and title page of the last render_part


def rest_turn(strips: list[Strip], j: int) -> bool:
    """A page may turn before line j and the player rests: a multi-bar rest
    line (REST_TURN_MIN bars or more) is the last line of the page or the
    first line of the next. A movement start or a rehearsal letter does not
    count: the player may be playing there."""
    for t in (j - 1, j):
        rs = strips[t].rest_src
        if rs is not None and rs[2].bars >= REST_TURN_MIN:
            return True
    return False


def line_bars(s: Strip) -> tuple[int, int | None] | None:
    """line_bars -> (first bar, last bar) of a line; the last is None when
    unknown. None when the line has no bar numbers."""
    if s.rest_src is not None:
        run = s.rest_src[2]
        if run.first is None:
            return None
        return run.first, run.first + run.bars - 1
    if s.bar_nums:
        return int(s.bar_nums[0]), int(s.bar_nums[-1])
    if s.bar_no is not None:
        return int(s.bar_no), None
    return None


def break_lines(strips: list[Strip], bars: list[int]) -> tuple[list[int], list[str]]:
    """break_lines -> (j list, warnings): a page break before line j for each
    bar N in `bars` ("break after bar N"). Lines are fixed, so N must be the
    last bar of a line; else a warning names the line ends near N."""
    out, warn = [], []
    spans = [line_bars(s) for s in strips]
    for n in sorted({int(b) for b in bars or []}):
        hit = next((i for i, sp in enumerate(spans) if sp and sp[1] == n), None)
        if hit is not None:
            if hit + 1 < len(strips):
                out.append(hit + 1)
            else:
                warn.append(f"break after bar {n}: the last line of the part (ignored)")
            continue
        ends = [sp[1] for sp in spans if sp and sp[1] is not None]
        near = sorted(ends, key=lambda e: (abs(e - n), e))[:4]
        inside = any(sp and sp[1] is not None and sp[0] <= n < sp[1] for sp in spans)
        warn.append(f"break after bar {n}: " + (
            "bar is inside a line (lines are not cut)" if inside else "no line ends at that bar")
            + (f"; line ends near it: {', '.join(str(e) for e in sorted(near))}" if near else ""))
    return sorted(set(out)), warn


def good_turn(strips: list[Strip], j: int) -> bool:
    """A page may turn before line j: a movement starts there, the line
    opens with a rehearsal letter (a new section, after a repeat), or a
    multi-bar rest stands on either side (the player turns while resting)."""
    s = strips[j]
    if s.movement or s.rest_src is not None or strips[j - 1].rest_src is not None:
        return True
    return any(mx <= s.staff_x0 + 3 * s.sp for mx, _ in s.marks)


def plan_pages(strips: list[Strip], dpi: int, opts: dict, title_page: bool
               ) -> tuple[list[list[tuple[Strip, float]]], int]:
    """plan_pages -> (pages of (strip, y), bad turns): page breaks chosen over the
    whole part at once (dynamic programming, not first-fit), so a turn
    falls at a section boundary where possible (DESIGN.md §5.4): a turn
    follows each recto (physical page 1, 3, 5, ...; page 1 is a title page
    when title_page) when printed double-sided. A section that fits on two
    pages then starts on a verso and needs no turn. Costs: TURN_BAD per
    turn not at good_turn, PAGE_COST per page, SHORT_LAST, FILL_COST."""
    n = len(strips)
    _, ph = PAPER[opts["paper"]]
    k = 72.0 / dpi * (opts.get("scale") or 1.0)
    pit = pitches(strips, opts)
    _, _, mt, mb = page_box(opts, 0, False)
    band = RUN_HEAD if (title_page or opts.get("_no_band")) else TITLE_BAND
    avail1 = ph - mt - mb - band
    availn = ph - mt - mb - RUN_HEAD
    cum = [0.0]
    for v in pit:
        cum.append(cum[-1] + v)
    duplex = opts.get("duplex", "auto") != "off"
    rest_rule = opts.get("turns", "any") == "rest"
    logo_on = logo_wanted(opts)
    logo_need = logo_room(ph, page_box(opts, 0, False)[3])

    def turn_cost(t: int) -> float:          # cost of a turn before line t
        if not rest_rule:
            return 0.0 if good_turn(strips, t) else TURN_BAD
        if rest_turn(strips, t):
            return 0.0
        return TURN_MOVE if strips[t].movement else TURN_HARD
    fill_cost = REPAGE_FILL if rest_rule else FILL_COST
    forced = sorted(f for f in set(opts.get("_breaks") or []) if 0 < f < n)

    def height(i: int, j: int) -> float:        # lines i..j-1 on one page (pt)
        last = strips[j - 1]
        return (strips[i].staff_top + (cum[j - 1] - cum[i]) - last.staff_top
                + last.img.shape[0]) * k

    first_phys = 2 if title_page else 1
    INF = float("inf")
    # best[c][j]: cost of lines 0..j-1 on content pages 0..c-1
    # at most 2 pages more than first-fit (more never saves a turn)
    maxp = min(n, len(_pack(strips, dpi, {**opts, "_no_band": title_page or opts.get("_no_band")},
                            None)) + (4 if rest_rule else 2) + len(forced))
    best = [dict() for _ in range(maxp + 1)]
    back: list[dict] = [dict() for _ in range(maxp + 1)]
    best[0][0] = 0.0
    total_best, end_c = INF, None
    for c in range(maxp):
        avail = avail1 if c == 0 else availn
        for i, cost in list(best[c].items()):
            fj = next((f for f in forced if f > i), None)   # a manual break ends a page here
            for j in range(i + 1, n + 1):
                h = height(i, j)
                if h > avail and j > i + 1:
                    break
                cc = cost + PAGE_COST
                if j == n and logo_on and avail - h < logo_need:
                    cc += LOGO_COST          # no room for the logo under the last line
                if j < n:
                    cc += fill_cost * max(0.0, 1.0 - h / avail) ** 2
                    phys = first_phys + c
                    if phys % 2 == 1 or not duplex:
                        cc += turn_cost(j)
                if cc < best[c + 1].get(j, INF):
                    best[c + 1][j] = cc
                    back[c + 1][j] = i
                if fj is not None and j >= fj:
                    break
        if n in best[c + 1]:
            last_i = back[c + 1][n]
            tot = best[c + 1][n]
            if c > 0 and n - last_i < min(MIN_LAST_LINES, n // (c + 1)):
                tot += SHORT_LAST
            if tot < total_best:
                total_best, end_c = tot, c + 1
        if not best[c + 1]:
            break
    # pages from the back pointers, then y of each line as in _pack
    cuts, j, c = [], n, end_c
    while c > 0:
        i = back[c][j]
        cuts.append((i, j))
        j, c = i, c - 1
    pages = []
    cuts = list(reversed(cuts))
    for c, (i, j) in enumerate(cuts):
        # last page of a group score with room to spare: systems further
        # apart, up to SYSTEM_GAP_LAST (operator request 2026-10-24: "the whole page
        # is available")
        extra = 0.0
        if c == len(cuts) - 1 and j - i > 1 and len(strips[i].staff_labels) > 1:
            avail = avail1 if c == 0 else availn
            free = avail - height(i, j)
            s0 = strips[i]
            n_st = len(s0.staff_labels)
            inner = ((s0.staff_bottom - s0.staff_top) - n_st * 4 * s0.sp) / (n_st - 1)
            extra = max(0.0, min(free / (j - i - 1),
                                 (SYSTEM_GAP_LAST - SYSTEM_GAP_FACTOR) * inner * k))
        page, y_top = [], 0.0
        for t in range(i, j):
            s = strips[t]
            if t == i:
                y_top = s.staff_top * k
                page.append((s, 0.0))
            else:
                y_top += pit[t - 1] * k + extra
                page.append((s, y_top - s.staff_top * k))
        pages.append(page)
    bad, j = 0, 0
    for c, pg in enumerate(pages[:-1]):
        j += len(pg)
        if ((first_phys + c) % 2 == 1 or not duplex) and turn_cost(j) >= (
                TURN_HARD if rest_rule else TURN_BAD):
            bad += 1
    return pages, bad


def layout_pages(strips: list[Strip], dpi: int, opts: dict
                 ) -> tuple[list[list[tuple[Strip, float]]], bool]:
    """layout_pages -> (content pages, title page?). DESIGN.md §5.4: page
    breaks by plan_pages, with and without a title page (title_page auto,
    double-sided, 3+ content pages); fewer bad turns, then fewer pages
    win; a tie keeps the title page (the music starts on a spread)."""
    pages, bad = plan_pages(strips, dpi, opts, False)
    if opts.get("title_page", "auto") == "auto" and opts.get("duplex", "auto") != "off" \
       and len(pages) >= 3:
        tp, tbad = plan_pages(strips, dpi, opts, True)
        if len(tp) >= 3 and (tbad, len(tp)) <= (bad, len(pages)):
            return tp, True
    return pages, False


AMB_HEAD = 0.8         # ambitus notehead size, share of a normal head (cue size)
CLEF_LINE = {"G": 2, "C": 3, "F": 4}


def ambitus_width(sp: float = AMB_SP) -> float:
    return 8.0 * sp


def draw_ambitus(page: pymupdf.Page, x: float, base: float, clef: str, lo: int,
                 hi: int, lo_alt: int = 0, hi_alt: int = 0, sp: float = AMB_SP) -> None:
    """draw_ambitus: a small staff (bottom line at base) with the clef and
    the lowest and highest notes as black noteheads without stems, stacked
    in one column at 80 % size (cue size), ledger lines as needed.
    lo, hi: diatonic numbers. lo_alt, hi_alt: +1 sharp, -1 flat, 0 none;
    an accidental (80 % size) stands left of the heads. Accidentals less
    than a sixth apart stand in two columns (upper nearer the heads) and
    the head column moves right, inside the same width."""
    w = ambitus_width(sp)
    lw = max(0.35, 0.12 * sp)
    for i in range(5):
        y = base - i * sp
        page.draw_line((x, y), (x + w, y), color=(0, 0, 0), width=lw)
    fam = clef[0]
    line = 2 if clef == "G8" else (int(clef[1]) if clef[1:].isdigit() else CLEF_LINE.get(fam, 2))
    glyph = "\ue052" if clef == "G8" else {"G": "\ue050", "C": "\ue05c",
                                            "F": "\ue062"}.get(fam, "\ue050")
    put_text(page, (x + 0.3 * sp, base - (line - 1) * sp), glyph, "music", 4 * sp)
    bottom = CLEF_BOTTOM.get(clef, 30)
    head = "\ue0a4"                                  # noteheadBlack, no stem
    hsize = AMB_HEAD * 4 * sp                        # 80 % of the staff's notehead
    hw = text_len(head, "music", hsize)
    acc = {lo: lo_alt, hi: hi_alt} if lo != hi else {lo: lo_alt or hi_alt}
    stagger = bool(lo_alt and hi_alt and 0 < hi - lo < 6)
    xh = x + (5.5 if stagger else 4.6) * sp          # both notes in one column
    xs = {lo: xh, hi: xh}
    if hi - lo == 1:                                 # a second: the upper head
        xs[hi] = xh + hw                             # moves right, as in a chord
    for d in (lo, hi):
        step = d - bottom
        y = base - step * sp / 2
        for ls in list(range(-2, step - 1, -2)) + list(range(10, step + 1, 2)):
            yl = base - ls * sp / 2
            page.draw_line((xs[d] - 0.3 * sp, yl), (xs[d] + hw + 0.3 * sp, yl),
                           color=(0, 0, 0), width=lw * 1.4)
        put_text(page, (xs[d], y), head, "music", hsize)
    xa = xh - 0.2 * sp
    for d in ((hi,) if lo == hi else (hi, lo)):      # upper accidental nearer the heads
        a_ = acc.get(d, 0)
        if not a_:
            continue
        g_ = ACC_GLYPH[a_]
        aw = text_len(g_, "music", hsize)
        put_text(page, (xa - aw, base - (d - bottom) * sp / 2), g_, "music", hsize)
        if stagger:
            xa -= aw + 0.1 * sp


# The logo is optional: PARTITOR_LOGO names a PNG file. Unset: no logo, no room kept.
LOGO_TITLE_H = 64.0     # pt, on a title page
LOGO_TITLE_Y = 0.76     # title page: logo centre, share of the page height (balances the title block)
LOGO_LAST_H = 44.0      # pt, on the back page (centred above the folio)
LOGO_LAST_MIN_H = 28.0  # pt, smaller than this the wordmark is not legible: logo left out
LOGO_GAP = 4.0          # pt, between the last line and the logo
LOGO_FOLIO_GAP = 10.0   # pt, between the logo and the folio
LOGO_COST = 20.0        # plan_pages: the last page has no room for the logo (less than PAGE_COST)
FOLIO_SIZE = 9.5        # pt
_LOGO_WARNED: list[bool] = []


def folio_base(ph: float, mb: float) -> float:
    """folio_base -> baseline (pt from the top) of the folio, in the bottom margin."""
    return ph - mb + min(18.0, mb - 6.0)


def folio_top(ph: float, mb: float) -> float:
    """folio_top -> top of the folio's digits (pt from the top of the page)."""
    return folio_base(ph, mb) - 0.7 * FOLIO_SIZE


def logo_room(ph: float, mb: float) -> float:
    """logo_room -> height the music area must leave free on the last page for
    the logo above the folio, beyond the bottom margin (pt, 0 when the margin holds it)."""
    return max(0.0, LOGO_LAST_MIN_H + LOGO_GAP + LOGO_FOLIO_GAP - (folio_top(ph, mb) - (ph - mb)))


def logo_path() -> Path | None:
    """logo_path -> the PNG file named by PARTITOR_LOGO; None when the variable
    is unset or the file is missing."""
    v = os.environ.get("PARTITOR_LOGO")
    return Path(v) if v and Path(v).is_file() else None


def logo_wanted(opts: dict) -> bool:
    """logo_wanted -> True when pages carry a logo: PARTITOR_LOGO is set (even
    when the file is missing: put_logo then warns once) and the layout key
    `logo` is not off."""
    return opts.get("logo", "on") == "on" and bool(os.environ.get("PARTITOR_LOGO"))


def logo_width(h: float) -> float | None:
    """logo_width -> width in pt of the logo at height h; None when missing."""
    path = logo_path()
    if path is None:
        return None
    pix = pymupdf.Pixmap(str(path))
    return h * pix.width / pix.height


def put_logo(page: pymupdf.Page, x: float, y: float, h: float, align: str = "left") -> float:
    """put_logo -> width of the logo drawn (0.0 when the file is missing, with
    one warning per run). Top-left at (x, y), height h pt; align "right" takes
    x as the right edge, "centre" as the centre line."""
    path = logo_path()
    if path is None:
        if not _LOGO_WARNED:
            _LOGO_WARNED.append(True)
            _warn(f"logo: PARTITOR_LOGO file not found: {os.environ.get('PARTITOR_LOGO')} (pages are drawn without it)")
        return 0.0
    w = logo_width(h) or 0.0
    x0 = x - w if align == "right" else (x - w / 2 if align == "centre" else x)
    page.insert_image(pymupdf.Rect(x0, y, x0 + w, y + h), filename=str(path))
    return w


def _title_page(page: pymupdf.Page, name: str, meta: dict, box: tuple,
                logo: bool = False) -> None:
    """Title page (DESIGN.md §5.4): title, subtitle, part name, composer,
    members of a group, centred in the upper third."""
    pw, ph = page.rect.width, page.rect.height
    ml, mr, mt, _ = box
    cx = (ml + pw - mr) / 2

    def centre(text: str, size: float, y: float, kind: str) -> None:
        put_text(page, (cx - text_len(text, kind, size) / 2, y), text, kind, size)
    y = mt + ph * 0.22
    if meta.get("title"):
        centre(meta["title"], 28, y, "regular")
        y += 30
    if meta.get("subtitle"):
        centre(meta["subtitle"], 16, y, "italic")
        y += 24
    if meta.get("composer"):
        centre(meta["composer"], 15, y + 8, "regular")
        y += 30
    y += 40
    centre(name, 24, y, "bold")
    if meta.get("members"):
        centre(meta["members"], 12, y + 24, "italic")
    if meta.get("ambitus"):
        sp_ = AMB_SP * 1.15
        draw_ambitus(page, cx - ambitus_width(sp_) / 2, y + 48, *meta["ambitus"], sp=sp_)
    if logo:                                  # centred, towards the bottom (balances the title block)
        put_logo(page, cx, ph * LOGO_TITLE_Y - LOGO_TITLE_H / 2, LOGO_TITLE_H, "centre")


def turn_list(strips: list[Strip], pages: list, title_page: bool, opts: dict,
              breaks: list[int] | None = None) -> list[dict]:
    """turn_list -> one dict per page turn (after each recto; every page when
    single-sided): pdf_page (the page before the turn, 1-based in the PDF),
    bar (last bar before the turn, None if unknown), next_bar, rest (bars of
    the multi-bar rest beside the turn; 0 if none), ok (the player rests or
    a movement or rehearsal letter starts: good_turn), resting (rest_turn),
    manual (a page break set by `breaks`)."""
    duplex = opts.get("duplex", "auto") != "off"
    first_phys = 2 if title_page else 1
    out, j = [], 0
    for c, pg in enumerate(pages[:-1]):
        j += len(pg)
        phys = first_phys + c
        if not (phys % 2 == 1 or not duplex):
            continue
        a, b = line_bars(strips[j - 1]), line_bars(strips[j])
        rest = max((strips[t].rest_src[2].bars for t in (j - 1, j)
                    if strips[t].rest_src is not None), default=0)
        out.append({"pdf_page": phys, "bar": a[1] if a and a[1] is not None else None,
                    "next_bar": b[0] if b else None, "rest": rest,
                    "ok": good_turn(strips, j), "resting": rest_turn(strips, j),
                    "movement": bool(strips[j].movement) and not rest_turn(strips, j),
                    "manual": j in (breaks or [])})
    return out


def render_part(name: str, strips: list[Strip], meta: dict, dpi: int,
                opts: dict, out: Path) -> int:
    """render_part -> physical page count. Writes out (PDF). meta: title,
    subtitle, composer, members (group score: its parts, top to bottom)."""
    pw, ph = PAPER[opts["paper"]]
    k = 72.0 / dpi * (opts.get("scale") or 1.0)
    breaks, bwarn = break_lines(strips, opts.get("breaks") or [])
    for w_ in bwarn:
        _warn(f"{name}: {w_}")
    opts = {**opts, "_breaks": breaks}
    pages, title_page = layout_pages(strips, dpi, opts)
    LAST_RENDER["turns"] = turn_list(strips, pages, title_page, opts, breaks)
    doc = pymupdf.open()
    n = len(pages)
    duplex = title_page or is_duplex(opts, n)
    left_ink = max(anchor(s) for s in strips)    # widest ink left of the alignment line
    if title_page:
        page = doc.new_page(width=pw, height=ph)
        _title_page(page, name, meta, page_box(opts, 0, duplex), logo_wanted(opts))
    for ci, pg in enumerate(pages):
        phys = ci + (1 if title_page else 0)
        page = doc.new_page(width=pw, height=ph)
        ml, mr, mt, mb = page_box(opts, phys, duplex)
        if ci == 0 and not title_page:
            # Title band. insert_text draws at a baseline and never drops
            # text (insert_textbox drops text that does not fit its box).
            cx = (ml + pw - mr) / 2

            def centre(text: str, size: float, base: float, kind: str) -> None:
                put_text(page, (cx - text_len(text, kind, size) / 2, base), text, kind, size)
            if meta.get("title"):
                centre(meta["title"], 21, mt + 18, "regular")
            if meta.get("subtitle"):
                centre(meta["subtitle"], 13, mt + 38, "italic")
            put_text(page, (ml, mt + 66), name, "bold", 16)
            if meta.get("ambitus") and not any(s_.ambitus_marks for s_ in strips):
                # no room in the first-line indent: beside the part name
                draw_ambitus(page, ml + text_len(name, "bold", 16) + 14,
                             mt + 66 - 5.5 + 2 * AMB_SP, *meta["ambitus"])
            if meta.get("composer"):
                w = text_len(meta["composer"], "regular", 12)
                put_text(page, (pw - mr - w, mt + 66), meta["composer"], "regular", 12)
            if meta.get("members"):
                put_text(page, (ml, mt + 80), meta["members"], "italic", 10)
            top = mt + TITLE_BAND
        else:
            # interior pages: short composer — title — part
            short = meta.get("composer_short") or composer_surname(meta.get("composer", ""))
            head = " — ".join(x for x in (short, meta.get("title", ""), name) if x)
            if duplex and phys % 2 == 0:          # recto: head at the outer (right)
                w = text_len(head, "italic", 9.5)
                put_text(page, (pw - mr - w, mt + 4), head, "italic", 9.5)
            else:                                 # verso or single-sided: left
                put_text(page, (ml, mt + 4), head, "italic", 9.5)
            top = mt + RUN_HEAD
        folio = f"{ci + 1}/{n}"
        w = text_len(folio, "regular", FOLIO_SIZE)
        put_text(page, ((ml + pw - mr - w) / 2, folio_base(ph, mb)), folio,
                 "regular", FOLIO_SIZE)
        for s, y in pg:
            hpx, wpx = s.img.shape
            x = ml + (left_ink - anchor(s)) * k
            rect = pymupdf.Rect(x, top + y, x + wpx * k, top + y + hpx * k)
            if s.bar_no is not None:
                # bar number above the staff start, clear of the clef
                base, _, _ = bar_mark(s)
                put_text(page, (x + bar_x(s) * k, top + y + base * k), str(s.bar_no),
                         "italic", s.bar_size * s.sp * k)
            for bx0, btop, bx1, bbot, letter, fs, bl in reh_boxes(s):
                r = pymupdf.Rect(x + bx0 * k, top + y + btop * k,
                                 x + bx1 * k, top + y + bbot * k)
                page.draw_rect(r, color=(0, 0, 0), width=max(0.6, 0.12 * s.sp * k))
                put_text(page, (x + (bx0 + REH_PAD * s.sp) * k, top + y + bl * k),
                         letter, "bold", fs * k)
            rb = rest_box(s)
            if rb:
                put_text(page, (x + rb[0] * k, top + y + rb[3] * k), rb[5], rb[6], rb[4] * k)
            for xl_, bot_, clef_, lo_, hi_, *alt_ in s.ambitus_marks:
                draw_ambitus(page, x + xl_ * k, top + y + bot_ * k, clef_, lo_, hi_,
                             *alt_, sp=s.sp * k)
            for t_, x1_, base_, fs_, caps_ in line_labels(s):
                if caps_:
                    put_smallcaps(page, x + x1_ * k, top + y + base_ * k, t_, fs_ * k)
                else:
                    put_text(page, (x + x1_ * k - text_len(t_, "regular", fs_ * k),
                                    top + y + base_ * k), t_, "regular", fs_ * k)
            if s.bracket:
                # group score: a bracket joins the staves (engraver practice)
                bx = x + (s.staff_x0 - 1.0 * s.sp) * k
                y0 = top + y + s.staff_top * k
                y1 = top + y + s.staff_bottom * k
                lw = 0.45 * s.sp * k
                page.draw_line((bx, y0 - 0.3 * s.sp * k), (bx, y1 + 0.3 * s.sp * k),
                               color=(0, 0, 0), width=lw)
                for yy, d in ((y0 - 0.3 * s.sp * k, -1), (y1 + 0.3 * s.sp * k, 1)):
                    page.draw_line((bx - lw / 2, yy), (bx + 0.9 * s.sp * k, yy + d * 0.5 * s.sp * k),
                                   color=(0, 0, 0), width=0.18 * s.sp * k)
            # grey + alpha: paper is transparent, so a nested strip never
            # hides ink of the strip above it
            ga = np.empty((hpx, wpx, 2), np.uint8)
            ga[..., 0] = 0
            ga[..., 1] = np.where(s.img, 255, 0)
            pix = pymupdf.Pixmap(pymupdf.csGRAY, wpx, hpx, ga.tobytes(), True)
            page.insert_image(rect, pixmap=pix)
        if ci == n - 1 and logo_wanted(opts):
            # back page: logo centred above the folio, in the room left under
            # the last line (plan_pages leaves room where it can)
            s_, y_ = pg[-1]
            free = folio_top(ph, mb) - LOGO_FOLIO_GAP - (top + y_ + s_.img.shape[0] * k)
            lh = min(LOGO_LAST_H, free - LOGO_GAP)
            if lh >= LOGO_LAST_MIN_H:
                put_logo(page, (ml + pw - mr) / 2, folio_top(ph, mb) - LOGO_FOLIO_GAP - lh, lh,
                         "centre")
            elif logo_path() is not None:
                _warn(f"{name}: no room for the logo on the back page (page {ci + 1}); left out")
    doc.save(out, garbage=3, deflate=True)
    LAST_RENDER.update(content=n, title_page=title_page)
    return n + (1 if title_page else 0)


# =============================================================================
# Cached lines (0.3.0-dev.37, `repage`)
# =============================================================================
# A build keeps the finished lines of each part (after finish_lines: justified,
# indented, labelled) in <item>/lines/<part>.lines. `repage` loads them and
# plans the page breaks again; nothing is analysed or built again. The file is
# a gzip pickle read by a restricted unpickler (numpy arrays and the Strip and
# RestRun classes only). LINES_FORMAT changes with the fields of Strip.
LINES_FORMAT = 1
_NP_OK = {"_reconstruct", "ndarray", "dtype", "scalar", "_frombuffer"}


class _LinesUnpickler(pickle.Unpickler):
    def find_class(self, module: str, name: str):
        if name in ("Strip", "RestRun") and (module in ("__main__", "partitor", "pt", __name__)
                                             or module.startswith("partitor.")):
            return {"Strip": Strip, "RestRun": RestRun}[name]
        if module.split(".")[0] == "numpy" and name in _NP_OK:
            return super().find_class(module, name)
        if module == "builtins" and name in ("set", "frozenset", "slice", "complex"):
            return super().find_class(module, name)
        raise pickle.UnpicklingError(f"not allowed in a lines file: {module}.{name}")


def lines_path(lines_dir: Path, name: str) -> Path:
    return lines_dir / f"{file_part_name(name)}.lines"


def strip_fields() -> list[str]:
    return sorted(f.name for f in dataclasses.fields(Strip))


def save_lines(path: Path, name: str, dpi: int, meta: dict, opts: dict,
               strips: list[Strip]) -> None:
    """save_lines: write the finished lines of one part (atomic). The source
    image of a rest line is dropped (the line is not drawn again)."""
    slim = [dc_replace(s, rest_src=(None, 0, s.rest_src[2])) if s.rest_src is not None else s
            for s in strips]
    payload = {"format": LINES_FORMAT, "fields": strip_fields(), "version": VERSION,
               "name": name, "dpi": dpi, "meta": dict(meta),
               "opts": {k: v for k, v in opts.items() if not k.startswith("_")},
               "strips": slim}
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with gzip.open(tmp, "wb", compresslevel=3) as f:
        pickle.dump(payload, f, protocol=pickle.HIGHEST_PROTOCOL)
    os.replace(tmp, path)


def load_lines(path: Path) -> dict:
    """load_lines -> the payload of save_lines. Raises ValueError (what is
    wrong) for a missing, damaged or foreign file."""
    if not path.is_file():
        raise ValueError(f"no saved lines ({path.name}): rebuild the part once")
    try:
        with gzip.open(path, "rb") as f:
            d = _LinesUnpickler(f).load()
    except (OSError, EOFError, pickle.UnpicklingError, AttributeError, ValueError) as e:
        raise ValueError(f"saved lines cannot be read ({path.name}: {e}): rebuild the part")
    if not isinstance(d, dict) or d.get("format") != LINES_FORMAT \
       or d.get("fields") != strip_fields():
        raise ValueError(f"saved lines are from another partitor ({d.get('version', '?')} "
                         f"{path.name}): rebuild the part")
    return d


def count_bad_turns(turns_: list[dict], opts: dict) -> int:
    """Turns where the player is playing (turns=rest), or where no section
    starts and no rest stands (turns=any)."""
    if opts.get("turns", "any") == "rest":
        return sum(1 for t in turns_ if not t["resting"] and not t.get("movement"))
    return sum(1 for t in turns_ if not t["ok"])


def turn_text(t: dict) -> str:
    """One page turn as a line for the report."""
    bar = f"bar {t['bar']}" if t["bar"] is not None else "bar ?"
    nxt = f" -> {t['next_bar']}" if t["next_bar"] is not None else ""
    why = (f"rest {t['rest']} bars" if t["resting"] else
           "movement start, no rest: check that it is not attacca" if t.get("movement") else
           "section start (player may be playing)" if t["ok"] else "PLAYING")
    return f"PDF page {t['pdf_page']}: after {bar}{nxt}  {why}" + \
        ("  [manual break]" if t["manual"] else "")


