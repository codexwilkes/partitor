def workdir(pdf: Path, out: str | None, pages: str | None = None) -> Path:
    if out:
        return Path(out)
    if pages:
        tag = re.sub(r"\s+", "", pages)
        return pdf.with_name(f"{pdf.stem}.p{tag}.partitor")
    return pdf.with_suffix(".partitor")


def cmd_pieces(a: argparse.Namespace) -> int:
    """List the pieces of a PDF: runs of music pages; a page with a title
    starts a new piece. Analysis at 200 dpi, no label OCR (titles are read
    from the text layer or by OCR)."""
    start = time.monotonic()
    pdf = Path(a.pdf)
    if not pdf.is_file():
        _die(f"input not found: {pdf}")
    print(f"{BOLD}partitor {VERSION} — pieces{RST}\n{time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
    _head(f"Pages: {pdf.name}")
    doc = pymupdf.open(pdf)
    rows: list[tuple[int, bool, str]] = []
    for res, _ in iter_pages(pdf, 200, list(range(doc.page_count)), ocr=False):
        title = res.title
        rows.append((res.page, res.music, title))
        for g in res.gate:
            _warn(f"page {res.page + 1}: {g}")
            _note("Likely an illustration or manuscript facsimile. "
                  "`detect` fails on this page; leave it out with --pages.")
    pieces: list[list] = []
    for pno, music, title in rows:
        if not music:
            continue
        if not pieces or title or pieces[-1][1] != pno - 1:
            pieces.append([pno, pno, title])
        else:
            pieces[-1][1] = pno
    _head("Pieces")
    for k, (p0, p1, title) in enumerate(pieces, 1):
        rng = f"{p0 + 1}" if p0 == p1 else f"{p0 + 1}-{p1 + 1}"
        _ok(f"{k:2d}  pages {rng:7s}  {title or '(no title found)'}")
        _note(f"partitor detect {pdf.name} --pages {rng}")
    skipped = [r[0] + 1 for r in rows if not r[1]]
    if skipped:
        _skip(f"no music: pages {', '.join(map(str, skipped))}")
    return _summary(start)


def cmd_detect(a: argparse.Namespace) -> int:
    """detect: analyse the pages, write layout.yaml and the preview.

    jobs (--jobs, else PARTITOR_JOBS, else auto) > 1: forked workers analyse
    the pages (fork_map, as build); each returns only small data and the
    parent joins it in page order, so the output equals the one-job run.
    One job: this process, page by page (iter_pages)."""
    start = time.monotonic()
    pdf = Path(a.pdf)
    if not pdf.is_file():
        _die(f"input not found: {pdf}")
    doc = pymupdf.open(pdf)
    try:
        pages = parse_pages(a.pages, doc.page_count)
    except ValueError as e:
        _die(str(e))
    out = workdir(pdf, a.out, a.pages)
    out.mkdir(parents=True, exist_ok=True)
    pdir = out / "preview"
    pdir.mkdir(exist_ok=True)
    print(f"{BOLD}partitor {VERSION} — detect{RST}\n{time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
    if _TESS["path"] is None:
        _warn("ocr:  tesseract not found; staff labels are not read")
        _note("Fix: apt install tesseract-ocr")
    config.TUNE["page_header_sp"] = a.page_header_sp
    _head(f"Analysis: {pdf.name}  (dpi {a.dpi}, pages {pages[0] + 1}-{pages[-1] + 1})")
    sysrecs: list[dict] = []
    items: list[str] = []
    titles: list[str] = []
    composers: list[str] = []
    t_analysis = time.monotonic()
    jobs = job_count(getattr(a, "jobs", None), PAGE_WORKER_GB, len(pages))

    def page_out(res: PageResult, recs: list[dict]) -> tuple:
        """Gate line and preview of one page -> only small data (system
        records, preview section, title, composer). The PageResult holds the
        large owner image: it stays in the process that made it."""
        check_page(res)
        return recs, preview_page(res, recs, pdir), res.title, res.composer

    if jobs <= 1:
        # one process, as before 0.4.1 (iter_pages carries the system base)
        results = (page_out(res, recs) for res, recs in iter_pages(pdf, a.dpi, pages))
    else:
        _note(f"analysing {len(pages)} page(s) with {jobs} worker(s)")
        wdocs: dict[int, "pymupdf.Document"] = {}

        def page_task(pno: int) -> tuple:
            d_ = wdocs.get(os.getpid())
            if d_ is None:                    # one open document per process
                d_ = wdocs[os.getpid()] = pymupdf.open(pdf)
            # nsys = 0: the system index is a key inside one page (analyse_one)
            res, recs = analyse_one(d_, pno, a.dpi, 0)
            return page_out(res, recs)

        results = parallel.fork_map(page_task, pages, jobs)
    try:
        for k_, pno in enumerate(pages):
            if jobs > 1:
                _progress(f"page {pno + 1} ({k_ + 1}/{len(pages)}): waiting for its worker")
            recs, item, title, composer = next(results)
            if jobs > 1:
                _progress_end()
            items.append(item)
            sysrecs.extend(recs)
            if title:
                titles.append(title)
            if composer:
                composers.append(composer)
    finally:
        results.close()
    if jobs > 1:
        _note(f"workers: {jobs}; the largest used {worker_peak_mb()} MB "
              f"(estimate for the worker count: {PAGE_WORKER_GB:.1f} GB)")
        _note(f"analysis took {time.monotonic() - t_analysis:.0f} s")
    if not sysrecs:
        _fail("music:  no staves found")
        return _summary(start)
    _head("Systems")
    counts: dict[int, int] = {}
    for r in sysrecs:
        counts[len(r["staves"])] = counts.get(len(r["staves"]), 0) + 1
    for n, c in sorted(counts.items(), reverse=True):
        _ok(f"systems:  {c} with {n} staves")
    parts = [p.strip() for p in a.parts.split(",") if p.strip()] if a.parts else []
    names, entries = assign_maps(sysrecs, parts)
    bars, resync, used = assign_bars(sysrecs)
    for e, r, b in zip(entries, sysrecs, bars):
        e["bar"] = b
        e["bars"] = r["nbars"]
        e["widths"] = r.get("widths", [])
        if r.get("repeats"):
            e["repeats"] = r["repeats"]
        if r.get("anchors"):
            e["anchors"] = [[int(x[0]), int(x[1])] for x in r["anchors"]]
        if any(r.get("steps") or []):
            e["steps"] = r["steps"]
        if r.get("restart"):
            e["restart"] = True
        if r.get("geom"):
            e["geom"] = {"page": int(r["page"]) + 1, **r["geom"]}
    # the operator's bar edits and answers of an earlier analysis stay (each
    # edit only where the line has the bars it had then)
    old_rules: dict = {}
    old_lay = out / getattr(a, "layout_name", "layout.yaml")
    if old_lay.is_file():
        try:
            old_rules = (yaml.safe_load(old_lay.read_text(encoding="utf-8")) or {}
                         ).get("bar_rules") or {}
        except yaml.YAMLError:
            old_rules = {}
    keep_rules = {k: list(old_rules[k]) for k in ("bar_edits", "bars_ack") if old_rules.get(k)}
    edit_notes: list[str] = []
    eff_entries = effective_systems(entries, keep_rules, edit_notes)
    for t in edit_notes:
        _warn(f"bars:  {t}")
    bar_rules = propose_bar_rules(eff_entries)
    bar_rules.update(keep_rules)
    scheme = renumber({"systems": entries, "bar_rules": bar_rules})
    _head("Bar numbers")
    if used:
        _ok(f"bars:  counted from barlines, checked against {used} printed number(s)")
    else:
        _warn("bars:  no printed bar numbers found to check the count")
    if keep_rules.get("bar_edits"):
        _note(f"bars:  {len(keep_rules['bar_edits'])} bar edit(s) kept from the earlier analysis")
    for m in bar_mismatches(effective_systems(entries, bar_rules), bar_rules):
        _warn(f"bars:  {mismatch_text(m)}")
        _note("Check the proof. The parts follow the source score unless you say "
              "otherwise: partitor bars <id> (k keeps the printed numbers; j / a mend "
              "a misread barline)")
    nrep = sum(len(e.get("repeats") or []) for e in entries)
    if nrep:
        _ok(f"repeats:  {nrep} repeat sign(s); rehearsal letters "
            f"{sum(len(e.get('marks') or []) for e in entries)}")
    for sid in bar_rules["pickup"]:
        _warn(f"bars:  pickup at {sid} (first bar short): numbered from 0 — check")
    for key in bar_rules["split"]:
        _warn(f"bars:  bar split by a repeat at {key}: counted once — check")
    if bar_rules["pickup"] or bar_rules["split"]:
        _note(f"printed numbers in the source: {scheme} count. Change: bar_rules in "
              "the layout (partitor bars <id> in the library)")
    ref_n = max(len(r["staves"]) for r in sysrecs)
    if parts and len(parts) != ref_n:
        _warn(f"parts:  {len(parts)} names given, fullest system has {ref_n} staves; "
              "names taken from labels")
    _ok(f"parts:  {', '.join(names)}")
    unresolved = [e["id"] for e in entries if "?" in e["map"]]
    _head("Output")
    lay_path = out / getattr(a, "layout_name", "layout.yaml")
    if lay_path.exists() and not a.force:
        _warn(f"layout:  {lay_path} exists, not overwritten (use --force)")
    else:
        lay = {
            "source": pdf.name, "sha256": sha256(pdf), "dpi": a.dpi,
            "pages": f"{pages[0] + 1}-{pages[-1] + 1}",
            "title": a.title or (titles[0] if titles else ""),
            "subtitle": a.subtitle,
            "composer": a.composer or (composers[0] if composers else ""),
            "parts": names,
            "page_header_sp": config.TUNE["page_header_sp"],
            "bar_rules": bar_rules,
            "bar_rules_status": "proposed",
            "systems": entries,
            "layout": {},
        }
        lay_path.write_text(LAYOUT_HELP + yaml.safe_dump(
            lay, sort_keys=False, allow_unicode=True, default_flow_style=None,
            width=100), encoding="utf-8")
        _ok(f"layout:   {lay_path}")
        if unresolved:
            _warn(f"map:  {len(unresolved)} system(s) uncertain: "
                  f"{', '.join(unresolved[:6])}{' …' if len(unresolved) > 6 else ''}")
            _note(f"Fix: check `suggest` and set `map` in {lay_path}")
    idx = write_preview_index(pdir, items, pdf.name)
    _ok(f"preview:  {idx}")
    return _summary(start)


def load_layout(path: Path) -> dict:
    return yaml.safe_load(path.read_text(encoding="utf-8"))


REST_FREE_SP = 14.0     # staff start (clef, key, time) skipped by the empty-staff check
REST_STEM_SP = 2.6      # a vertical ink run this long is a stem, not a rest
REST_BAND_SP = 3.5      # rows checked above and below the staff


def staff_is_empty(res: "PageResult", idx: int) -> bool:
    """staff_is_empty -> True when a staff holds only rests: past its start
    (clef, key, time: 14 sp) and clear of the barlines (0.8 sp), no column
    of its ink has a vertical run of 2.6 sp or more (a stem; an H-bar's
    ends, a rest block, a staff line, text and numbers are shorter)."""
    st = res.staves[idx]
    sp = res.sp
    x1 = int(st.x1)
    x0 = int(st.x0 + min(REST_FREE_SP * sp, 0.4 * (x1 - st.x0)))
    y0 = max(0, int(st.top - REST_BAND_SP * sp))
    y1 = min(res.owner.shape[0], int(st.bottom + REST_BAND_SP * sp))
    if x1 <= x0 or y1 <= y0:
        return True
    ink = res.owner[y0:y1, x0:x1] == idx
    for bx in res.barlines.get(st.system, []):
        ink[:, max(0, int(bx - 0.8 * sp) - x0):max(0, int(bx + 0.8 * sp) - x0 + 1)] = False
    run = np.zeros(ink.shape[1], np.int32)
    best = np.zeros(ink.shape[1], np.int32)
    for r in range(ink.shape[0]):
        run = (run + 1) * ink[r]
        np.maximum(best, run, out=best)
    return not bool((best >= REST_STEM_SP * sp).any())


def cmd_build(a: argparse.Namespace) -> int:
    start = time.monotonic()
    pdf = Path(a.pdf)
    out = workdir(pdf, a.out, a.pages)
    lay_path = out / getattr(a, "layout_name", "layout.yaml")
    if not lay_path.is_file():
        _die(f"layout not found: {lay_path}", f"Run: partitor detect {pdf}")
    lay = load_layout(lay_path)
    print(f"{BOLD}partitor {VERSION} — build{RST}\n{time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
    _head("Layout")
    if lay.get("sha256") != sha256(pdf):
        _die("input PDF changed since detect", f"Run: partitor detect {pdf} --force")
    opts = dict(LAYOUT_DEFAULTS)
    opts.update({k: v for k, v in (lay.get("layout") or {}).items() if k in LAYOUT_DEFAULTS})
    cli_set = set()
    for key in LAYOUT_DEFAULTS:
        v = getattr(a, key, None)
        if v is not None:
            opts[key] = v
            cli_set.add(key)
    err = check_margins(opts)
    if err:
        _die(f"layout: {err}", f"Fix: edit {lay_path} or the build options")
    for key in ("gap", "gap_min", "bar_raise", "bar_size", "max_staff_mm", "small_mm"):
        opts[key] = float(opts[key])
    if opts["gap_min"] > opts["gap"]:
        opts["gap_min"] = opts["gap"]
    sysmaps = {}
    bad = False
    for srec in lay["systems"]:
        m = srec.get("map")
        if m is None or len(m) != srec["staves"] or "?" in m:
            _fail(f"map:  {srec['id']}  ({srec['staves']} staves, map {m})")
            bad = True
        sysmaps[srec["id"]] = m
    if bad:
        _note(f"Fix: edit {lay_path}")
        return _summary(start)
    _ok(f"layout:  {lay_path}  ({len(sysmaps)} systems)")

    _head("Analysis")
    dpi = int(lay["dpi"])
    config.TUNE["page_header_sp"] = float(lay.get("page_header_sp", PAGE_HEADER_SP))
    doc = pymupdf.open(pdf)
    pages = parse_pages(lay.get("pages"), doc.page_count)
    expect = {s["id"]: s["staves"] for s in lay["systems"]}
    seen: list[str] = []
    part_strips: dict[str, list] = {p: [] for p in lay["parts"]}   # Strip | RestRun
    lay_sys = {s_["id"]: s_ for s_ in lay["systems"]}
    groups = {str(g): [p for p in (ps or []) if p in lay["parts"]]
              for g, ps in (lay.get("groups") or {}).items()}
    groups = {g: ps for g, ps in groups.items() if ps}
    group_strips: dict[str, list] = {g: [] for g in groups}
    skip = set(lay.get(SKIP_KEY) or [])
    # only: build just these parts / groups (the rest of the parts are not
    # touched; the library keeps the old files of the others)
    only = [str(n) for n in (getattr(a, "only", None) or [])]
    bad_ = [n for n in only if n not in part_strips and n not in groups]
    if bad_:
        _die(f"unknown part or group: {', '.join(bad_)}",
             f"Parts: {', '.join(part_strips)}; groups: {', '.join(groups) or '-'}")
    want_parts = [p for p in part_strips if (not only or p in only) and p not in skip]
    want_groups = [g for g in groups if not only or g in only]
    # parts whose staves this build reads: the parts and the members of the groups
    consumers = set(want_parts) | {x for g in want_groups for x in groups[g]}
    darker = opts["ink"] == "darker"
    # bar number at each line start (not on a movement's first line)
    if lay.get("bar_rules") is not None:
        renumber(lay)                 # bar and marks follow bar_rules
    # bars per system for multi-bar rests: from the line-start numbers when
    # the next system of the movement has one (a printed number corrected a
    # wrong barline count), else the counted bars
    span: dict[str, int] = {}
    edit_notes: list[str] = []
    eff_sys = effective_systems(lay["systems"], lay.get("bar_rules"), edit_notes)
    for t in edit_notes:
        _warn(f"bars:  {t}")
    open_bars = bar_mismatches(eff_sys, lay.get("bar_rules"))
    if open_bars:
        for m in open_bars:
            _fail(f"bars:  {mismatch_text(m)}")
        _note("The parts follow the source score only when you confirm it. Run: "
              "partitor bars <id>  (k N keeps the printed numbers; j / a mend a "
              "misread barline)")
        return _summary(start)
    for k_, s_ in enumerate(eff_sys):
        nb_ = int(s_.get("bars") or 0)
        nx_ = eff_sys[k_ + 1] if k_ + 1 < len(eff_sys) else None
        if nx_ is not None and not nx_.get("restart") and isinstance(s_.get("bar"), int) \
           and isinstance(nx_.get("bar"), int) and nx_["bar"] > s_["bar"]:
            nb_ = nx_["bar"] - s_["bar"]
        span[s_["id"]] = nb_
    bar_of = {}
    marks_of = {s_["id"]: s_.get("marks") or [] for s_ in lay["systems"]}
    nums_of = {s_["id"]: s_.get("bar_nums") or [] for s_ in lay["systems"]}
    if opts["bar_numbers"] == "start":
        for j, srec in enumerate(lay["systems"]):
            b = srec.get("bar")
            if isinstance(b, int) and b >= 1 and j > 0 and not srec.get("restart"):
                bar_of[srec["id"]] = b
    ids_by_page: dict[int, list[str]] = {}
    for s_ in lay["systems"]:
        ids_by_page.setdefault(int(s_["id"].split(".")[0][1:]) - 1, []).append(s_["id"])

    def consume(res, recs):
        """consume -> (strips per part, strips per group, system ids) of one
        page. res None: the page was not analysed (a part-only build: none of
        the wanted parts has a staff on it and no movement starts there, so
        only multi-bar rests are needed)."""
        ap: dict[str, list] = {p: [] for p in want_parts}
        ag: dict[str, list] = {g: [] for g in want_groups}
        ids: list[str] = []
        if res is not None:
            check_page(res)
        for srec in recs:
            ids.append(srec["id"])
            if res is not None and expect.get(srec["id"]) != len(srec["staves"]):
                _die("systems differ from layout", f"Run: partitor detect {pdf} --force")
            m = sysmaps[srec["id"]]
            gsys = res.staves[srec["staves"][0]].system if res is not None else None
            # a part with no staff in this system rests for its bars: a
            # multi-bar rest keeps the part playable and its numbers right
            ls_ = lay_sys[srec["id"]]
            nb_ = span.get(srec["id"], 0)
            b0_ = ls_.get("bar") if isinstance(ls_.get("bar"), int) else None
            # a part whose staves here hold only rests (no noteheads read, no
            # stems): a multi-bar rest too (rests=compress). Not with a
            # rehearsal mark in the system (it would be lost).
            idle: set[str] = set()
            idle_g: set[str] = set()
            if res is not None and nb_ > 0 and opts["rests"] == "compress" \
                    and not marks_of.get(srec["id"]):
                stp_ = ls_.get("steps") or [None] * len(m)
                for part in dict.fromkeys(x for x in m if x != "-" and x in consumers):
                    ii = [i for i, x in enumerate(m) if x == part]
                    if all(i < len(stp_) and not stp_[i] for i in ii):
                        if all(staff_is_empty(res, srec["staves"][i]) for i in ii):
                            idle.add(part)
                        else:
                            _warn(f"rests:  {srec['id']}  {part}: ink that is not a rest, "
                                  "kept as engraved")
            if nb_ > 0:
                hdr_ = None
                if res is not None and gsys in res.restart:        # keep the movement title
                    hm = res.owner == OWN_HEADER_BASE + gsys
                    if hm.any():
                        ys_, xs_ = np.nonzero(hm)
                        sys_st = [st for st in res.staves if st.system == gsys]
                        tst = min(sys_st, key=lambda st: st.top)
                        y0h, y1h = int(ys_.min()), int(ys_.max()) + 1
                        x0h, x1h = int(xs_.min()), int(xs_.max()) + 1
                        hdr_ = (hm[y0h:y1h, x0h:x1h].copy(),
                                x0h - int(min(st.x0 for st in sys_st)),
                                max(0, int(round(tst.top)) - y1h))
                new_move = res is not None and gsys in res.restart
                rest = lambda: RestRun(nb_, b0_, new_move, hdr_)
                for part in ap:
                    if part not in m or part in idle:
                        ap[part].append(rest())
                for gname, gparts in groups.items():
                    if gname not in ag:
                        continue
                    here = [x for x in gparts if x in m]
                    if not here or all(x in idle for x in here):
                        ag[gname].append(rest())
                        idle_g.add(gname)
            if res is None:
                continue
            for part in dict.fromkeys(x for x in m if x != "-" and x not in idle):
                idx = [srec["staves"][i] for i, x in enumerate(m) if x == part]
                if part not in part_strips:
                    _fail(f"map:  {srec['id']}  (unknown part '{part}')")
                    continue
                if part not in ap:
                    continue                  # not wanted in this build
                edges = [min(res.staves[i].x0 for i in idx)] + res.barlines.get(gsys, [])
                mk = [(edges[i], str(t)) for i, t in marks_of.get(srec["id"], [])
                      if 0 <= i < len(edges)]
                gg = own_group_gap(lay, part, opts)
                if gg is not None and len(idx) > 1:       # a part on two staves
                    stp = group_strip(res, srec["staves"], [(part, [i]) for i in idx],
                                      OWN_HEADER_BASE + gsys, darker,
                                      bar_no=bar_of.get(srec["id"]), marks=mk,
                                      movement=gsys in res.restart,
                                      nums=nums_of.get(srec["id"], []), gap_sp=gg,
                                      labels=False)
                else:
                    stp = make_strip(res, idx, OWN_HEADER_BASE + gsys, darker,
                                     bar_no=bar_of.get(srec["id"]), marks=mk,
                                     movement=gsys in res.restart)
                stp.bar_raise, stp.bar_size = opts["bar_raise"], opts["bar_size"]
                set_bar_geometry(stp, res, idx, gsys, nums_of.get(srec["id"], []))
                ap[part].append(stp)
            for gname, gparts in groups.items():
                # a group score: the staves of its parts present in this
                # system, in score order, joined by a bracket
                if gname not in ag:
                    continue
                idx = [srec["staves"][i] for i, x in enumerate(m) if x in gparts]
                if not idx or gname in idle_g:
                    continue
                edges = [min(res.staves[i].x0 for i in idx)] + res.barlines.get(gsys, [])
                mk = [(edges[i], str(t)) for i, t in marks_of.get(srec["id"], [])
                      if 0 <= i < len(edges)]
                order = list(dict.fromkeys(x for x in m if x in gparts))
                runs = [(x, [srec["staves"][i] for i, y in enumerate(m) if y == x])
                        for x in order]
                stp = group_strip(res, srec["staves"], runs, OWN_HEADER_BASE + gsys, darker,
                                  bar_no=bar_of.get(srec["id"]), marks=mk,
                                  movement=gsys in res.restart,
                                  nums=nums_of.get(srec["id"], []),
                                  gap_sp=own_group_gap(lay, gname, opts))
                stp.bar_raise, stp.bar_size = opts["bar_raise"], opts["bar_size"]
                stp.bracket = len(idx) > 1
                ag[gname].append(stp)
        return ap, ag, ids

    def needs_page(pno: int) -> bool:
        """A part-only build analyses a page only when a wanted part has a
        staff on it or a movement starts on it (the title is read from the
        page). Every other page gives multi-bar rests, from the layout."""
        if not only:
            return True
        for sid in ids_by_page.get(pno, []):
            if lay_sys[sid].get("restart") or any(x in consumers for x in sysmaps[sid]):
                return True
        return False

    bar_edits = bar_edits_by_system(lay.get("bar_rules"))
    t_analysis = time.monotonic()
    todo = [pno for pno in pages if needs_page(pno)]
    todo_set = set(todo)
    jobs = job_count(getattr(a, "jobs", None), PAGE_WORKER_GB, len(todo))
    if only or jobs > 1:
        _note(f"analysing {len(todo)} of {len(pages)} page(s) with {jobs} worker(s)"
              + (f"; building {', '.join(only)} only" if only else ""))
    wdocs: dict[int, "pymupdf.Document"] = {}

    def page_task(pno: int):
        d_ = wdocs.get(os.getpid())
        if d_ is None:                    # one open document per process
            d_ = wdocs[os.getpid()] = pymupdf.open(pdf)
        _progress(f"page {pno + 1} ({pages.index(pno) + 1}/{len(pages)}): analysing")
        res, recs = analyse_one(d_, pno, dpi, 0, ocr=True, bar_edits=bar_edits)
        _progress_end()
        return consume(res, recs)

    # same analysis as detect, OCR included: printed bar numbers and
    # bracketed labels must be removed in build exactly as in detect
    outs = parallel.fork_map(page_task, todo, jobs)
    try:
        for k_, pno in enumerate(pages):
            if pno in todo_set:
                if jobs > 1:
                    _progress(f"page {pno + 1} ({k_ + 1}/{len(pages)}): waiting for its worker")
                ap_, ag_, ids_ = next(outs)
                if jobs > 1:
                    _progress_end()
            else:
                ap_, ag_, ids_ = consume(None, [{"id": sid, "staves": []}
                                                for sid in ids_by_page.get(pno, [])])
            seen.extend(ids_)
            for p_, v_ in ap_.items():
                part_strips[p_].extend(v_)
            for g_, v_ in ag_.items():
                group_strips[g_].extend(v_)
    finally:
        outs.close()
    if jobs > 1:
        _note(f"workers: {jobs}; the largest used {worker_peak_mb()} MB "
              f"(estimate for the worker count: {PAGE_WORKER_GB:.1f} GB)")
    t_render = time.monotonic()
    _note(f"analysis took {t_render - t_analysis:.0f} s")
    if seen != [s["id"] for s in lay["systems"]]:
        _die("systems differ from layout", f"Run: partitor detect {pdf} --force")
    if _counts["fail"]:
        return _summary(start)

    part_strips = {p: fill_rests(v, opts) for p, v in part_strips.items()}
    group_strips = {g: fill_rests(v, opts) for g, v in group_strips.items()}
    for v in group_strips.values():
        for s_ in v:
            if s_.rest_src is not None:
                s_.bracket = True      # a group's rest line keeps the system bracket
                                       # (operator request 2026-10-25: it had none)

    _head("Parts")
    parts_dir = Path(getattr(a, "parts_dir", None) or out / "parts")   # library: parts.new
    parts_dir.mkdir(exist_ok=True)
    tail = getattr(a, "tail", "") or ""       # library: -<piece>--<id>
    lines_dir = Path(a.lines_dir) if getattr(a, "lines_dir", None) else None   # library: lines.new
    if lines_dir is not None:
        lines_dir.mkdir(exist_ok=True)
    if opts.get("large") == "on" and opts["paper"] not in LARGE:
        _note(f"large copy: skipped (paper {opts['paper']} is already 11x17)")
    LAST_BUILD.clear()
    meta = {k: lay.get(k, "") for k in ("title", "subtitle", "composer", "composer_short")}

    plays = (lay.get("layout") or {}).get(PART_LAYOUT_KEY) or {}
    amb_data = {k: lay.get(k) for k in ("parts", "systems", "ambitus", SKIP_KEY)}
    refresh_ambitus(amb_data)
    # group members need their ambitus also when not extracted on their own
    amb_all = {**amb_data, SKIP_KEY: [], "ambitus": dict(amb_data.get("ambitus") or {})}
    refresh_ambitus(amb_all)

    def emit(name: str, strips: list[Strip], num: int, extra: dict, opts: dict = opts
             ) -> dict:
        # -> the record of the part for `built` (a worker returns it to the
        # parent; LAST_BUILD is filled there, in part order)
        # per-part layout (layout.parts) over the item layout; command-line
        # options (already in opts) are not overridden
        own = {k: v for k, v in (plays.get(name) or {}).items()
               if k in LAYOUT_DEFAULTS and k not in cli_set}
        if own:
            opts = {**opts, **own}
            for key in ("gap", "gap_min", "bar_raise", "bar_size", "max_staff_mm"):
                opts[key] = float(opts[key])
            opts["gap_min"] = min(opts["gap_min"], opts["gap"])
            _note(f"{name}: own layout " + " ".join(f"{k}={v}" for k, v in own.items()))
        h_max = 4.0 * strips[0].sp * 72.0 / dpi * fit_scale(strips, dpi, opts) * 25.4 / 72.0
        h_width = 4.0 * strips[0].sp * 72.0 / dpi * fit_scale(
            strips, dpi, {**opts, "scale": 1e9}) * 25.4 / 72.0   # page width only
        nsrc = len(strips)
        group = bool(extra.get("members"))
        if opts.get("reflow") == "on":
            pre = find_prefixes(strips)
            _note(f"{name}: {reflow_report(strips, pre)}")
            o_r, floor = opts, None
            if group and not opts.get("page_count"):
                # a group is several staves per line: its pages grow with the
                # square of the staff size (Biber Trombones: 12 pages at 3.7 mm,
                # about 60 at 8 mm). pages=auto: at most GROUP_REFLOW_PAGES times
                # the pages without re-flow; pages=N sets the count instead.
                base = finish_lines(strips, name, group, extra.get("ambitus"),
                                    extra.get("ambitus_map"))
                n0 = choose_layout(base, dpi, opts)[2]
                o_r = {**opts, "page_count": max(n0, math.ceil(GROUP_REFLOW_PAGES * n0))}
                floor = fit_scale(strips, dpi, {**opts, "scale": 1e9})
                _note(f"{name}: page budget {o_r['page_count']} (pages without re-flow {n0} "
                      f"x {GROUP_REFLOW_PAGES}); set pages=N to change it")
            sc, g, n_est, strips = choose_reflow(strips, dpi, o_r, pre, floor)
            strips = finish_lines(strips, name, group, extra.get("ambitus"),
                                  extra.get("ambitus_map"))
            sc = min(sc, fit_scale(strips, dpi, opts))
        else:
            # one line width, indent, labels: before the layout choice (labels
            # widen the lines)
            strips = finish_lines(strips, name, group, extra.get("ambitus"),
                                  extra.get("ambitus_map"))
            sc, g, n_est = choose_layout(strips, dpi, opts)
        o = {**opts, "scale": sc, "gap": g}
        if sc < fit_scale(strips, dpi, opts) - 1e-6:
            _note(f"{name}: staff reduced to fit {n_est} page(s) (fewer page turns)")
        if opts.get("page_count") and n_est > opts["page_count"]:
            _warn(f"page-count:  {name}  (cannot fit {opts['page_count']} page(s) above "
                  f"{opts['min_staff_mm']} mm staff and gap {opts['gap_min']} sp)")
        h_px = 4.0 * strips[0].sp   # one staff, top line to bottom line
        h_mm = h_px * 72.0 / dpi * sc * 25.4 / 72.0
        fn = parts_dir / (part_file_name(num, name, tail) if tail
                          else f"{num:02d}-{file_part_name(name)}.pdf")
        n = render_part(name, strips, {**meta, **extra}, dpi, o, fn)
        tl = LAST_RENDER.get("turns") or []
        nbad = count_bad_turns(tl, o)
        if o.get("turns", "any") == "rest" and nbad:
            _warn(f"turn-while-playing:  {name}  " + "; ".join(
                f"PDF page {t['pdf_page']} (after bar {t['bar']})" for t in tl
                if not t["resting"] and not t.get("movement"))
                  + "  (no rest to turn in; set breaks or accept)")
        if lines_dir is not None:
            save_lines(lines_path(lines_dir, name), name, dpi, {**meta, **extra}, o, strips)
        big = (large_copy(fn, opts["paper"])
               if opts.get("large") == "on" and opts["paper"] in LARGE else None)
        rec = {"part": name, "pages": n, "reflow": opts.get("reflow") == "on",
               "width_mm": round(h_width, 2),
               "content_pages": LAST_RENDER.get("content", n),
               "title_page": bool(LAST_RENDER.get("title_page")),
               "staff_mm": round(h_mm, 2),
               "staff_max_mm": round(h_max, 2), "gap": round(g, 2),
               "turns": len(tl), "bad_turns": nbad,
               "file": fn.name, **({"large": big.name} if big else {}),
               **({"group": True} if extra.get("members") else {})}
        flow = f" (re-flowed from {nsrc})" if opts.get("reflow") == "on" else ""
        _ok(f"{name}:  {len(strips)} lines{flow}  {n} page(s)  staff {h_mm:.1f} mm  "
            f"gap {g:.2f} sp  -> {fn}")
        if (opts.get("reflow_offer") == "on" and opts.get("reflow") != "on"
                and h_mm < opts["small_mm"] and h_width < opts["small_mm"]):
            _note(f"{name}: small print ({h_mm:.1f} mm, held by the source line width): "
                  f"re-flow can give up to {opts['max_staff_mm']:.0f} mm (--reflow on)")
        return rec

    # the steps in part order: messages, and the parts to render (one worker
    # each when jobs > 1; the numbers NN are those of all parts, also when only
    # some are built)
    steps: list[tuple] = []
    for num, (part, strips) in enumerate(part_strips.items(), 1):
        if only and part not in only:
            continue
        if part in skip:
            steps.append(("skip", f"part:  {part}  (not extracted)"))
        elif not strips:
            steps.append(("warn", f"part:  {part}  (no staves mapped)"))
        else:
            steps.append(("emit", part, strips, num, {"ambitus": ambitus_for(amb_data, part)}))
    for gi, (gname, strips) in enumerate(group_strips.items(), len(part_strips) + 1):
        if only and gname not in only:
            continue
        if not strips:
            steps.append(("warn", f"group:  {gname}  (none of its parts is mapped)"))
        else:
            steps.append(("emit", gname, strips, gi,
                          {"members": " · ".join(groups[gname]),
                           "ambitus_map": {p_: ambitus_for(amb_all, p_) for p_ in groups[gname]}}))
    emits = [st_ for st_ in steps if st_[0] == "emit"]
    rjobs = job_count(getattr(a, "jobs", None), RENDER_WORKER_GB, len(emits))
    if rjobs > 1:
        _note(f"rendering {len(emits)} part(s) with {rjobs} worker(s)")

    def render_task(i: int) -> dict:
        _, name_, strips_, num_, extra_ = emits[i]
        return emit(name_, strips_, num_, extra_)

    results = parallel.fork_map(render_task, range(len(emits)), rjobs)
    try:
        for st_ in steps:
            if st_[0] == "skip":
                _skip(st_[1])
            elif st_[0] == "warn":
                _warn(st_[1])
            else:
                LAST_BUILD.append(next(results))
    finally:
        results.close()
    if rjobs > 1:
        _note(f"workers: {rjobs}; the largest so far used {worker_peak_mb()} MB "
              f"(estimate for the worker count: {RENDER_WORKER_GB:.1f} GB)")
    _note(f"rendering took {time.monotonic() - t_render:.0f} s")
    return _summary(start)


# =============================================================================
# Library (library folder, DESIGN.md §2-3, §6)
# =============================================================================
# Library layout: <library>/inbox/*.pdf (operator drops PDFs), <library>/library/
# <id>-<slug>/ with <id>-source.pdf, <id>-score.yaml, <id>-proof.pdf, parts/. The library
# folder comes from PARTITOR_LIBRARY (set by the partitor wrapper), default
# /var/lib/partitor/library. The folder is local or an SMB mount: the engine
# does not know which. score.yaml is the engine's layout file plus the item keys
# (id, slug, created, built); the CLI is the only writer.
LIBRARY_DEFAULT = "/var/lib/partitor/library"
# item id: YYYY-MM-NNNN (year and month of the extraction, serial in the
# year); items of 0.3.0-dev.6 and before: YYYY-NNN (still found)
ITEM_RE = re.compile(r"^(\d{4})-(?:(\d{2})-(\d{4})|(\d{3}))(?:-|$)")
ITEM_HELP = """\
# partitor score.yaml — written by the partitor CLI. Change it with
#   partitor set <id> key=value   (or the item menu), not by hand.
#   Edits are saved, not built: `pending` lists them; partitor rebuild <id>
#   builds. composer: full name (page 1); composer_short: interior pages.
"""
PAPER_NEXT = {"letter": "a4", "a4": "ledger", "ledger": "letter"}   # menu `a`
SET_KEYS = {          # set key -> (layout key or None for metadata, parser)
    "title": (None, str), "subtitle": (None, str), "composer": (None, str),
    "composer_short": (None, str),
    "pages": ("page_count", "pages"), "paper": ("paper", ("letter", "a4", "ledger")),
    "gap": ("gap", float), "min_gap": ("gap_min", float),
    "ink": ("ink", ("normal", "darker")), "scale": ("scale", float),
    "min_staff_mm": ("min_staff_mm", float),
    "margin_top": ("margin_top", float), "margin_bottom": ("margin_bottom", float),
    "margin_side": ("margin_side", float), "gutter": ("gutter", float),
    "duplex": ("duplex", ("auto", "on", "off")),
    "bar_numbers": ("bar_numbers", ("start", "none")),
    "bar_raise": ("bar_raise", float), "bar_size": ("bar_size", float),
    "large": ("large", ("on", "off")),
    "logo": ("logo", ("on", "off")),
    "reflow": ("reflow", ("on", "off")), "reflow_offer": ("reflow_offer", ("on", "off")),
    "max_staff_mm": ("max_staff_mm", float),
    "title_page": ("title_page", ("auto", "off")),
    "group_gap": ("group_gap", "gapsp"),
    "rests": ("rests", ("compress", "keep")),
    "turns": ("turns", ("any", "rest")), "breaks": ("breaks", "breaks"),
}
GAP_MAX = 14.0        # expand never sets a wider gap (sp)
PART_SET_KEYS = {"pages", "gap", "min_gap", "scale", "min_staff_mm", "max_staff_mm", "group_gap",
                 "reflow", "title_page", "bar_raise", "bar_size", "ink", "turns", "breaks"}
REPAGE_KEYS = ("turns", "breaks", "duplex", "title_page")   # `repage` applies these without a rebuild


def set_name(layout_key: str) -> str:
    """set_name -> the `set` key of a layout key (page_count -> pages)."""
    return next((k for k, (lk, _) in SET_KEYS.items() if lk == layout_key), layout_key)


def set_value(key: str, val) -> str:
    """set_value -> a value as `set` takes it; unset pages = auto, other
    unset keys = their default."""
    if val is None:
        if key == "pages":
            return "auto"
        if key == "group_gap":
            return "source"
        if key == "breaks":
            return "none"
        lk = SET_KEYS.get(key, (key, None))[0]
        return f"{LAYOUT_DEFAULTS.get(lk)} (default)"
    return str(val)


def part_names(data: dict) -> list[str]:
    """part_names -> extracted parts (not skipped) and group names."""
    skip = set(data.get(SKIP_KEY) or [])
    return [p for p in data.get("parts") or [] if p not in skip and p != "-"] + \
        list((data.get("groups") or {}).keys())


def part_layout(data: dict, part: str | None) -> dict:
    """part_layout -> layout of the item with the overrides of one part."""
    lay = {k: v for k, v in (data.get("layout") or {}).items() if k != PART_LAYOUT_KEY}
    if part:
        lay.update(((data.get("layout") or {}).get(PART_LAYOUT_KEY) or {}).get(part) or {})
    return {**LAYOUT_DEFAULTS, **lay}


def library_root() -> Path:
    return Path(os.environ.get("PARTITOR_LIBRARY", LIBRARY_DEFAULT))


def item_dirs(lib: Path) -> list[Path]:
    if not lib.is_dir():
        return []
    return sorted(d for d in lib.iterdir() if d.is_dir() and ITEM_RE.match(d.name))


def _id_parts(name: str) -> tuple[int, int | None, int] | None:
    """(year, month or None, serial) of an item folder name or id."""
    m = ITEM_RE.match(name)
    if not m:
        return None
    if m.group(3):
        return int(m.group(1)), int(m.group(2)), int(m.group(3))
    return int(m.group(1)), None, int(m.group(4))


def item_id(item: Path) -> str:
    """The id at the start of an item folder name."""
    m = ITEM_RE.match(item.name)
    if not m:
        raise ValueError(f"not an item folder: {item.name}")
    return m.group(0).rstrip("-")


def next_id(lib: Path, year: int, month: int) -> str:
    """next_id -> 'YYYY-MM-NNNN': one more than the highest serial of the
    year (old YYYY-NNN items count too)."""
    top = 0
    for d in item_dirs(lib):
        ip = _id_parts(d.name)
        if ip and ip[0] == year:
            top = max(top, ip[2])
    if top >= 9999:
        raise ValueError(f"no free id in {year}")
    return f"{year}-{month:02d}-{top + 1:04d}"


def resolve_id(ref: str, year: int) -> tuple[int, int | None, int]:
    """resolve_id '12' | '2026-12' | '2026-10-0012' | '2026-012' ->
    (year, month or None, serial). A serial alone means this year."""
    ref = ref.strip()
    m = re.fullmatch(r"(\d{1,4})", ref)
    if m:
        return year, None, int(m.group(1))
    m = re.fullmatch(r"(\d{4})-(\d{1,2})-(\d{1,4})", ref)
    if m:
        return int(m.group(1)), int(m.group(2)), int(m.group(3))
    m = re.fullmatch(r"(\d{4})-(\d{1,4})", ref)
    if m:
        return int(m.group(1)), None, int(m.group(2))
    raise ValueError(f"not an id: {ref} (use 12 or 2026-10-0012)")


def find_item(lib: Path, ref: str) -> Path:
    y, mo, n = resolve_id(ref, time.localtime().tm_year)
    hits = [d for d in item_dirs(lib)
            if (ip := _id_parts(d.name)) and ip[0] == y and ip[2] == n
            and (mo is None or ip[1] == mo)]
    if not hits:
        raise ValueError(f"no item {ref} in {lib}")
    return hits[0]


def item_file(item: Path, kind: str) -> Path:
    """item_file(item, 'score.yaml' | 'source.pdf' | 'proof.pdf') -> the
    item's file, named <id>-<kind> so it keeps its id out of the folder
    (operator request 2026-10-24). An old plain-named file is renamed on first use."""
    old = item / kind
    if not ITEM_RE.match(item.name):              # not a library item (tests, scratch)
        return old
    new = item / f"{item_id(item)}-{kind}"
    if not new.exists() and old.exists():
        os.replace(old, new)
    return new


def score_name(item: Path) -> str:
    return item_file(item, SCORE_FILE).name


def piece_tag(composer: str, title: str) -> str:
    """piece_tag -> 'Schein-Maria': composer surname and the first word of
    the title (leading number dropped), ASCII, case kept."""
    fold = lambda t: unicodedata.normalize("NFKD", re.sub(r"['\u2019`]", "", t)) \
        .encode("ascii", "ignore").decode("ascii")
    sur = re.findall(r"[A-Za-z0-9]+", fold(composer.split()[-1]))[:1] if composer.split() else []
    t = re.sub(r"^\s*\d+\s*[.)]\s*", "", title)
    word = re.findall(r"[A-Za-z0-9]+", fold(t))[:1]
    return "-".join(sur + word) or "piece"


def load_item(item: Path) -> dict:
    """load_item -> score.yaml of an item. A missing id comes from the
    folder name (a failed detect left score.yaml without item keys; the
    menu showed "2026-10-", operator request 2026-10-25)."""
    data = yaml.safe_load(item_file(item, SCORE_FILE).read_text(encoding="utf-8")) or {}
    if not data.get("id") and ITEM_RE.match(item.name):
        data["id"] = item_id(item)
    return data


def save_item(item: Path, data: dict) -> None:
    """Write <id>-score.yaml atomically (temp file + rename on the share).
    The ambitus of every part follows the maps (refresh_ambitus)."""
    if data.get("systems"):
        refresh_ambitus(data)
    dst = item_file(item, SCORE_FILE)
    tmp = dst.with_name(dst.name + ".tmp")
    tmp.write_text(ITEM_HELP + LAYOUT_HELP + yaml.safe_dump(
        data, sort_keys=False, allow_unicode=True, default_flow_style=None, width=100),
        encoding="utf-8")
    os.replace(tmp, dst)


def natural_key(name: str) -> list:
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", name)]


def inbox_pdfs(share: Path) -> list[Path]:
    inbox = share / "inbox"
    if not inbox.is_dir():
        return []
    return sorted((p for p in inbox.iterdir()
                   if p.is_file() and p.suffix.lower() == ".pdf"),
                  key=lambda p: natural_key(p.name))


def suggest_meta(pdf: Path) -> tuple[str, str]:
    """suggest_meta -> (title, composer) from PDF metadata, else the file
    name (IMSLP pattern 'IMSLP123-PMLP45-Composer_Title.pdf' handled)."""
    title = composer = ""
    try:
        md = pymupdf.open(pdf).metadata or {}
        title = (md.get("title") or "").strip()
        composer = (md.get("author") or "").strip()
    except Exception:          # metadata is only a suggestion
        pass
    if not title:
        stem = re.sub(r"^IMSLP\d+-(PMLP\d+-)?", "", pdf.stem)
        title = re.sub(r"[_]+", " ", stem).strip()
    return title, composer


def item_status(data: dict) -> str:
    """not analysed | needs choices | ready to build | changes not built |
    built (DESIGN.md §6.2: edits are saved; only a build makes PDFs)."""
    if "systems" not in data:
        return "not analysed"
    if any("?" in (s.get("map") or ["?"]) for s in data.get("systems", [])):
        return "needs choices"
    if not data.get("built"):
        return "ready to build"
    if data.get("pending"):
        return "changes not built"
    return "built"


def mark_pending(data: dict, *what: str) -> None:
    """Note edits since the last build (shown in review; cleared by a build)."""
    pend = list(data.get("pending") or [])
    for w in what:
        if w and w not in pend:
            pend.append(w)
    if pend:
        data["pending"] = pend


def item_line(item: Path, data: dict) -> str:
    """One-line summary: id · composer (short) · title · parts · pages · staff."""
    b = data.get("built") or {}
    parts = data.get("parts") or []
    out = [p for p in parts if p not in set(data.get(SKIP_KEY) or [])]
    comp = data.get("composer_short") or composer_surname(data.get("composer", ""))
    bits = [data.get("id") or item_id(item)] + ([comp] if comp else []) + \
        [data.get("title") or "(no title)", f"{len(out)} parts"]
    if b.get("parts"):
        pages = max(p["pages"] for p in b["parts"])
        staff = min(p["staff_mm"] for p in b["parts"])
        bits += [f"{pages} page{'s' * (pages != 1)}", f"staff {staff:.1f} mm"]
        if data.get("pending"):
            n = len(data["pending"])
            bits.append(f"{n} change{'s' * (n != 1)} not built")
    else:
        bits.append(item_status(data))
    return " · ".join(str(x) for x in bits)


PROOF_H = 1400        # preview page height (px), set by preview_page


def proof_from_preview(item: Path) -> Path | None:
    """Join preview/page-*.png into proof.pdf (one page each), remove
    preview/, then label it (annotate_proof). proof.pdf opens in File
    Station and on a phone."""
    pdir = item / "preview"
    pngs = sorted(pdir.glob("page-*.png"), key=lambda p: natural_key(p.name))
    if not pngs:
        return None
    doc = pymupdf.open()
    for png in pngs:
        img = pymupdf.open(png)
        r = img[0].rect
        page = doc.new_page(width=r.width, height=r.height)
        page.insert_image(page.rect, filename=str(png))
    out = item_file(item, "proof.pdf")
    tmp = out.with_name(out.name + ".tmp")
    doc.save(tmp, garbage=3, deflate=True)
    os.replace(tmp, out)
    shutil.rmtree(pdir, ignore_errors=True)
    annotate_proof(item)
    return out


def _proof_pages(data: dict) -> list[int]:
    """Source page numbers (1-based) of the proof pages, in order."""
    m = re.fullmatch(r"\s*(\d+)\s*-\s*(\d+)\s*", str(data.get("pages") or ""))
    return list(range(int(m.group(1)), int(m.group(2)) + 1)) if m else []


PROOF_BAR = (0.62, 0.0, 0.62)       # bar numbers and barline ticks (magenta)
PROOF_LETTER = (0.85, 0.38, 0.0)    # rehearsal letters (orange)


def proof_bars(page, e: dict, ef: dict, rules: dict, f: float, sts: list) -> None:
    """Draw the bars of one system on a proof page: a tick at each barline
    above the top staff, the bar number after it (magenta; '48 cont.' for a
    bar that completes the bar before it) and a boxed rehearsal letter
    (orange). Barlines: the system's widths (staff spaces from the staff
    start, bar edits applied) times the staff space. The first bar's number
    stands right of the part name above the staff."""
    g = e["geom"]
    nums = e.get("bar_nums") or []
    wd = [float(w) for w in ef.get("widths") or []]
    if not nums or len(wd) != len(nums) or not sts:
        return
    x0 = min(float(st[0]) for st in g["staves"])
    top, bot = float(g["staves"][0][1]), float(g["staves"][0][2])
    sp = (bot - top) / 4.0
    ty = top * f                                  # top line of the top staff
    letters = {int(m[0]): m[1] for m in e.get("marks") or []}
    split = set(rules.get("split") or [])
    maps = e.get("map") or []
    nm = maps[0] if maps else ""
    name_w = pymupdf.get_text_length(nm if nm not in ("?", "-") else "(left out)",
                                     fontname="helv", fontsize=9.0) + 8
    edge = x0
    for i, n in enumerate(nums):
        left = edge * f
        edge += wd[i] * sp
        if i > 0:                                 # tick at the barline before bar i
            page.draw_line((left, ty - 9), (left, ty - 1), color=PROOF_BAR, width=1.0)
        lab = str(n) + (" cont." if f"{e['id']}:{i}" in split else "")
        x = left + 2 + (name_w if i == 0 else 0)
        if i in letters:
            fs = 11.0
            tw = pymupdf.get_text_length(letters[i], fontname="hebo", fontsize=fs)
            box = pymupdf.Rect(x, ty - 24, x + tw + 6, ty - 10)
            page.draw_rect(box, color=PROOF_LETTER, fill=(1, 1, 1), width=1.2)
            page.insert_text((x + 3, ty - 12.5), letters[i], fontsize=fs, fontname="hebo",
                             color=PROOF_LETTER)
            x = box.x1 + 2
        lw = pymupdf.get_text_length(lab, fontname="hebo", fontsize=8.5)
        page.draw_rect(pymupdf.Rect(x - 1, ty - 21, x + lw + 1, ty - 10), color=None,
                       fill=(1, 1, 1), fill_opacity=0.8)
        page.insert_text((x, ty - 12.5), lab, fontsize=8.5, fontname="hebo", color=PROOF_BAR)


def annotate_proof(item: Path, data: dict | None = None) -> None:
    """Redraw proof.pdf from its page images with labels from score.yaml:
    a header per page (source page), each system's name (p8.s2) in blue,
    each staff's part above its start in black; a system that needs a
    choice gets a red frame and '? suggestion' per staff; each part's
    lowest and highest note is ringed in green and named; the bars of each
    system: a tick at each barline, the bar number (magenta) and the
    rehearsal letters (orange, boxed), as the parts will print them; and
    page 1 lists the ambitus of every part. Run after detect and again
    after every change to the maps, part names, ambitus or bar rules.
    data: the layout to draw (the bars menu shows edits not yet saved);
    default: the saved score.yaml."""
    proof = item_file(item, "proof.pdf")
    if not proof.is_file() or not item_file(item, SCORE_FILE).is_file():
        return
    if data is None:
        data = load_item(item)
    rules_ = data.get("bar_rules") or {}
    renumber(data)                      # bar numbers and letters follow the bar rules
    eff_ = {e["id"]: e for e in effective_systems(data.get("systems") or [], rules_)}
    src = pymupdf.open(proof)
    pages = _proof_pages(data)
    out = pymupdf.open()
    by_page: dict[int, list[dict]] = {}
    for e in data.get("systems") or []:
        g = e.get("geom")
        if g:
            by_page.setdefault(int(g["page"]), []).append(e)
    # ambitus: where each part's lowest and highest note stands (checked on
    # the proof before printing; operator request 2026-10-25)
    amb = data.get("ambitus") or {}
    ext: dict[tuple[str, int], list[tuple[str, str, int]]] = {}
    for part, a_ in amb.items():
        if a_.get("from") == "off":
            continue
        for sid, kk, which, xx, d in part_extremes(data, part):
            ext.setdefault((sid, kk), []).append((part, which, xx, d))
    amb_line = "ambitus: " + "  ·  ".join(
        f"{p_} {a_.get('range') or 'none'}" + (" (by hand)" if a_.get("from") == "operator" else "")
        for p_, a_ in amb.items() if a_.get("from") != "off")
    for k, sp_page in enumerate(src):
        imgs = sp_page.get_images(full=True)
        if not imgs:
            continue
        pix = pymupdf.Pixmap(src, imgs[0][0])
        page = out.new_page(width=sp_page.rect.width, height=sp_page.rect.height)
        page.insert_image(page.rect, pixmap=pix)
        pno = pages[k] if k < len(pages) else k + 1
        need = [e for e in by_page.get(pno, []) if "?" in (e.get("map") or [])]
        head = (f"source page {pno}" + (f"  -  {len(need)} system(s) to choose (red)"
                                         if need else "")
                + "  |  bars: magenta numbers, boxed letters")
        hw = pymupdf.get_text_length(head, fontname="hebo", fontsize=12)
        hfs = min(12.0, 12.0 * (page.rect.width - 16) / max(hw, 1.0))
        page.insert_text((8, 16), head, fontsize=hfs, fontname="hebo",
                         color=(0.8, 0, 0) if need else (0, 0, 0.6))
        if k == 0 and amb:
            aw = pymupdf.get_text_length(amb_line, fontname="helv", fontsize=9)
            afs = min(9.0, 9.0 * (page.rect.width - 16) / max(aw, 1.0))
            page.insert_text((8, 28), amb_line, fontsize=afs, fontname="helv",
                             color=(0, 0.45, 0))
        for e in by_page.get(pno, []):
            g = e["geom"]
            f = page.rect.height / float(g["h"])
            sts = [(x0 * f, t * f, b * f) for x0, t, b in g["staves"]]
            uncertain = "?" in (e.get("map") or [])
            col = (0.8, 0, 0) if uncertain else (0, 0, 0.6)
            hgt = max(4.0, sts[0][2] - sts[0][1])
            if uncertain:
                x0 = min(s_[0] for s_ in sts) - 0.6 * hgt
                page.draw_rect(pymupdf.Rect(x0, sts[0][1] - 1.2 * hgt,
                                            page.rect.width - 4, sts[-1][2] + 0.5 * hgt),
                               color=col, width=2)
            page.insert_text((max(2.0, sts[0][0] - 3.2 * hgt), sts[0][1] - 0.5 * hgt),
                             e["id"], fontsize=11, fontname="hebo", color=col)
            maps = e.get("map") or []
            sug = e.get("suggest") or []
            proof_bars(page, e, eff_.get(e["id"], e), rules_, f, sts)
            for j, (x0, t, b) in enumerate(sts):
                name = maps[j] if j < len(maps) else "?"
                if name == "?":
                    txt = f"? {sug[j]}" if j < len(sug) else "?"
                elif name == "-":
                    txt = "(left out)"
                else:
                    txt = name
                fs = 9.0
                w = pymupdf.get_text_length(txt, fontname="helv", fontsize=fs)
                r = pymupdf.Rect(x0 + 2, t - fs - 3, x0 + w + 6, t - 1)
                page.draw_rect(r, color=None, fill=(1, 1, 1), fill_opacity=0.85)
                page.insert_text((x0 + 4, t - 3), txt, fontsize=fs, fontname="helv",
                                 color=(0.8, 0, 0) if name == "?" else (0, 0, 0))
                st_ = (e.get("steps") or [None] * (j + 1))[j] if j < len(e.get("steps") or []) else None
                for part, which, xx, d in ext.get((e["id"], j), []):
                    if not st_ or not xx:
                        continue
                    stp = st_[0] if which == "low" else st_[1]
                    cx, cy = xx * f, b - stp * (b - t) / 8.0
                    rad = max(3.0, 0.22 * (b - t))
                    page.draw_circle((cx, cy), rad, color=(0, 0.55, 0), width=1.5)
                    bn = extreme_bar(data, e["id"], st_, which)
                    lbl = (f"{part} {which} {pitch_name(d)}" + (f", bar {bn}" if bn else "")
                           + f" ({e['id']})")
                    ly = cy + rad + 8 if which == "low" else cy - rad - 3
                    lw_ = pymupdf.get_text_length(lbl, fontname="helv", fontsize=7.5)
                    page.draw_rect(pymupdf.Rect(cx - 1, ly - 7.5, cx + lw_ + 3, ly + 2),
                                   color=None, fill=(1, 1, 1), fill_opacity=0.85)
                    page.insert_text((cx + 1, ly), lbl, fontsize=7.5, fontname="helv",
                                     color=(0, 0.45, 0))
    tmp = proof.with_name(proof.name + ".tmp")
    out.save(tmp, garbage=3, deflate=True)
    src.close()
    os.replace(tmp, proof)


def _engine_step(fn, ns: argparse.Namespace) -> int:
    """Run one engine command in-process with fresh counters; _die
    (SystemExit) becomes exit code 1."""
    _reset_counts()
    try:
        return fn(ns)
    except SystemExit as e:
        return int(e.code or 1) if not isinstance(e.code, str) else 1


def run_detect(item: Path, pages: str | None, title: str, composer: str,
               parts: str = "", jobs: str | None = None) -> int:
    """Run detect for an item (jobs: workers, a number or auto; None = PARTITOR_JOBS)."""
    ns = argparse.Namespace(pdf=str(item_file(item, "source.pdf")), pages=pages,
                            parts=parts, title=title, subtitle="", composer=composer,
                            dpi=400, out=str(item), page_header_sp=PAGE_HEADER_SP,
                            force=True, layout_name=score_name(item), jobs=jobs)
    sf = item_file(item, SCORE_FILE)
    before = load_item(item) if sf.is_file() else {}
    rc = _engine_step(cmd_detect, ns)
    # detect rewrites score.yaml: the item keys go back, also on failure
    if sf.is_file() and before:
        data = load_item(item)
        head = {k: before[k] for k in ("id", "slug", "created", "source") if k in before}
        if any(k not in data for k in head):
            save_item(item, {**head, **data})
    return rc


PARTS_NEW, PARTS_PREV = "parts.new", "parts.prev"


def recover_parts(item: Path) -> None:
    """A build that stopped between the two renames of swap_parts left no
    parts folder: put the previous set back (it is complete)."""
    if not (item / "parts").exists() and (item / PARTS_PREV).is_dir():
        os.replace(item / PARTS_PREV, item / "parts")
        _warn(f"parts:  a build stopped while it swapped the folders; the previous parts "
              f"are back in parts/")


def swap_parts(item: Path) -> None:
    """After a build that succeeded: parts/ -> parts.prev/ (the set before; the
    one before that goes now), parts.new/ -> parts/. A build that fails or
    is killed never reaches here, so parts/ is always a complete set."""
    new, cur, prev = item / PARTS_NEW, item / "parts", item / PARTS_PREV
    shutil.rmtree(prev, ignore_errors=True)
    if cur.exists():
        os.replace(cur, prev)
    os.replace(new, cur)


def keep_lines(item: Path) -> None:
    """After a good build: the lines of the parts built now (lines.new/) go
    into lines/; the lines of parts not built now stay. A failed build never
    reaches here, so lines/ always match a set of parts."""
    new, cur = item / LINES_NEW, item / "lines"
    if not new.is_dir():
        return
    cur.mkdir(exist_ok=True)
    for f in new.glob("*.lines"):
        os.replace(f, cur / f.name)
    shutil.rmtree(new, ignore_errors=True)


def restore_previous_parts(item: Path) -> bool:
    """Undo the last swap: parts.prev/ becomes parts/ again (the trial set
    goes). False when there is no previous set."""
    cur, prev = item / "parts", item / PARTS_PREV
    if not prev.is_dir():
        return False
    shutil.rmtree(cur, ignore_errors=True)
    os.replace(prev, cur)
    shutil.rmtree(item / "lines", ignore_errors=True)   # they match the set that went
    return True


def build_names(data: dict) -> list[tuple[int, str]]:
    """build_names -> (NN, name) of every output in file order: the parts (also
    those not extracted: they keep their number), then the groups that have
    a member. NN is the number in the part file name (cmd_build uses the same)."""
    parts = list(data.get("parts") or [])
    groups = [g for g, ps in (data.get("groups") or {}).items()
              if any(p in parts for p in (ps or []))]
    return list(enumerate(parts + [str(g) for g in groups], 1))


def selection_help(data: dict) -> str:
    skip = set(data.get(SKIP_KEY) or [])
    nparts = len(data.get("parts") or [])
    return "  ".join(f"{n} {nm}{' (not extracted)' if nm in skip else ''}"
                     f"{' (group)' if n > nparts else ''}"
                     for n, nm in build_names(data) if nm != "-")


def parse_parts(data: dict, words: list[str]) -> list[str] | None:
    """parse_parts -> the parts and groups named by `words`, in file order; None
    when they are every part (a full build). Each word is a number (the NN of
    the part file and of `show`; groups come after the parts), a range
    (2-4), a name (not case sensitive; several words make one name: Bass
    Trombone Grosso) or the start of a name that no other name starts with.
    `all` is every part. Commas and semicolons separate like spaces.
    Raises ValueError (what is wrong), never builds."""
    outs = [(n, nm) for n, nm in build_names(data) if nm != "-"]
    if not outs:
        raise ValueError("no parts yet (analyse first)")
    by_num = dict(outs)
    names = [nm for _, nm in outs]
    low = {nm.casefold(): nm for nm in names}
    skip = set(data.get(SKIP_KEY) or [])
    toks = re.sub(r"[,;]", " ", " ".join(words)).split()
    chosen: list[str] = []
    i = 0
    while i < len(toks):
        hit = None
        for j in range(len(toks), i, -1):               # the longest name first
            cand = " ".join(toks[i:j]).casefold()
            if cand in low:
                hit = (j, low[cand])
                break
        if hit:
            chosen.append(hit[1])
            i = hit[0]
            continue
        t = toks[i]
        i += 1
        if t.casefold() == "all":
            chosen.extend(nm for nm in names if nm not in skip)
            continue
        m = re.fullmatch(r"(\d+)(?:-(\d+))?", t)
        if m:
            lo, hi = int(m.group(1)), int(m.group(2) or m.group(1))
            if lo > hi:
                raise ValueError(f"{t}: the range runs backwards")
            for n in range(lo, hi + 1):
                if n not in by_num:
                    raise ValueError(f"no part number {n}")
                chosen.append(by_num[n])
            continue
        pre = [nm for nm in names if nm.casefold().startswith(t.casefold())]
        if len(pre) == 1:
            chosen.append(pre[0])
        elif pre:
            raise ValueError(f"{t}: more than one part starts so ({', '.join(pre)})")
        else:
            raise ValueError(f"no part or group {t}")
    if not chosen:
        raise ValueError("no part named")
    gone = [nm for nm in dict.fromkeys(chosen) if nm in skip]
    if gone:
        raise ValueError(f"not extracted: {', '.join(gone)} (menu t: N=+ extracts it)")
    ordered = [nm for nm in names if nm in set(chosen)]
    if set(ordered) >= {nm for nm in names if nm not in skip}:
        return None
    return ordered


def partial_blocker(item: Path, data: dict, names: list[str], tail: str) -> str | None:
    """partial_blocker -> why a build of `names` only cannot leave the other parts
    as they are (None: it can). The other parts keep their files only when
    each is built, its file is there, and the name a full build would give it
    now (number, piece, id) is the name it has."""
    built = {r["part"]: r for r in (data.get("built") or {}).get("parts") or []}
    pdir = item / "parts"
    if not built or not pdir.is_dir():
        return "nothing built yet"
    skip = set(data.get(SKIP_KEY) or [])
    for num, nm in build_names(data):
        if nm in names or nm == "-" or nm in skip or nm not in built:
            continue
        r = built[nm]
        want = part_file_name(num, nm, tail)
        if r.get("file") != want:
            return f"the file name of {nm} would change ({r.get('file')} -> {want})"
        for k in ("file", "large"):
            if r.get(k) and not (pdir / r[k]).is_file():
                return f"{r[k]} is not in parts/"
    return None


def keep_other_parts(item: Path, data: dict, stage: Path, names: list[str]) -> list[dict]:
    """keep_other_parts -> the `built` records of the parts not in `names`, after
    copying their files from parts/ into the stage (the new set is then
    complete, so parts.prev/ keeps the whole old set for an undo)."""
    cur = {nm for _, nm in build_names(data)}
    keep = []
    for r in (data.get("built") or {}).get("parts") or []:
        if r["part"] in names or r["part"] not in cur:
            continue
        for k in ("file", "large"):
            if r.get(k):
                shutil.copy2(item / "parts" / r[k], stage / r[k])
        keep.append(dict(r))
    return keep


def run_build(item: Path, only: list[str] | None = None, jobs: str | None = None) -> int:
    """Build into parts.new/; only a build that succeeded replaces parts/
    (the old set stays in parts.prev/ until the next success). Before 0.3.0-dev.32
    the old parts were deleted first: a crash left none.

    only: the parts and groups to build (names, see parse_parts); the other
    parts keep their files, which are copied into the new set. A set that
    cannot keep them (partial_blocker) is built whole. jobs: workers, a
    number or auto."""
    recover_parts(item)
    data = load_item(item)
    iid = item_id(item)
    tail = f"-{piece_tag(data.get('composer', ''), data.get('title', ''))}--{iid}"
    if only:
        why = partial_blocker(item, data, only, tail)
        if why:
            _warn(f"rebuild:  all parts are built, not only {', '.join(only)}: {why}")
            only = None
    stage = item / PARTS_NEW
    shutil.rmtree(stage, ignore_errors=True)            # left by a build that was killed
    lstage = item / LINES_NEW
    shutil.rmtree(lstage, ignore_errors=True)
    ns = argparse.Namespace(pdf=str(item_file(item, "source.pdf")), pages=None,
                            out=str(item), layout_name=score_name(item), tail=tail,
                            parts_dir=str(stage), lines_dir=str(lstage), only=only, jobs=jobs)
    for key in LAYOUT_DEFAULTS:
        setattr(ns, key, None)
    rc = _engine_step(cmd_build, ns)
    if rc == 0 and LAST_BUILD and stage.is_dir():
        data = load_item(item)
        new = [dict(r) for r in LAST_BUILD]
        if only:
            try:
                new += keep_other_parts(item, data, stage, only)
            except OSError as e:
                shutil.rmtree(stage, ignore_errors=True)
                _fail(f"build:  the other parts could not be kept ({e}); parts/ is unchanged")
                return 1
            order = {nm: i for i, (_, nm) in enumerate(build_names(data))}
            new.sort(key=lambda r: order.get(r["part"], len(order)))
        swap_parts(item)
        keep_lines(item)
        _note(f"parts:  the set before is kept in {PARTS_PREV}/ until the next good build")
        data = load_item(item)
        if only:
            left = [x for x in data.get("pending") or []
                    if not any(x.startswith(f"{nm}:") for nm in only)]
            if left:
                data["pending"] = left
                _warn(f"not built in the other parts: {', '.join(left)}")
            else:
                data.pop("pending", None)
        else:
            data.pop("pending", None)
        data["built"] = {"date": time.strftime("%Y-%m-%d %H:%M"), "parts": new}
        save_item(item, data)
    elif rc == 0:
        shutil.rmtree(stage, ignore_errors=True)        # nothing was built
    elif stage.is_dir():
        _warn(f"parts:  the build did not finish: parts/ is unchanged; "
              f"the partial set is in {PARTS_NEW}/ (removed at the next build)")
    return rc


def merge_item_keys(item: Path, keep: dict, again: bool = False) -> dict:
    """After detect rewrote score.yaml: put back the item keys and settings.
    again (an analysis again): also the operator's part list, groups, skip
    list and ambitus (when the staves carry the same names), and the
    previous answer as the suggestion of a system still uncertain."""
    data = load_item(item)
    head = {k: keep[k] for k in ("id", "slug", "created") if k in keep}
    data = {**head, **data}
    if keep.get("layout"):
        data["layout"] = dict(keep["layout"])
    kr = keep.get("bar_rules") or {}
    if kr.get("marks_add") or kr.get("marks_drop"):   # marks set by the operator
        br = dict(data.get("bar_rules") or {})
        for k in ("marks_add", "marks_drop"):
            if kr.get(k):
                br[k] = list(kr[k])
        data["bar_rules"] = br
        renumber(data)
    for k in ("title", "subtitle", "composer", "composer_short", "pending"):
        if keep.get(k):
            data[k] = keep[k]
    # an analysis again keeps groups and parts not extracted when the
    # part names are the same
    if again and keep.get("parts"):
        named = [p for p in data.get("parts") or [] if p != "-"]
        if set(named) <= set(keep["parts"]):
            data["parts"] = list(keep["parts"])      # the operator's order and names
        old = {e["id"]: e for e in keep.get("systems") or []}
        for e in data.get("systems") or []:
            o = old.get(e["id"])
            if o and "?" in (e.get("map") or []) and len(o.get("map") or []) == len(e["map"]) \
                    and "?" not in o["map"]:
                e["suggest"] = list(o["map"])        # Enter takes the previous answer
        if keep.get("ambitus"):
            data["ambitus"] = {p: dict(v) for p, v in keep["ambitus"].items()}
    if keep.get("parts") == data.get("parts"):
        for k in ("groups", SKIP_KEY):
            if keep.get(k):
                data[k] = keep[k]
    save_item(item, data)
    return data


def part_clefs(data: dict) -> dict[str, str]:
    """Clef of each part, from the systems where it is mapped (most common
    clef read there; a part on two staves: 'G+F'); '?' when none was read."""
    seen: dict[str, dict[str, int]] = {}
    for e in data.get("systems") or []:
        per: dict[str, list[str]] = {}
        for name, clef in zip(e.get("map") or [], e.get("clefs") or []):
            if name not in ("?", "-"):
                per.setdefault(name, []).append(clef or "?")
        for name, cl in per.items():
            if all(c == "?" for c in cl):
                continue
            key = "+".join(cl)
            seen.setdefault(name, {}).setdefault(key, 0)
            seen[name][key] += 1
    return {p: (max(seen[p], key=seen[p].get) if p in seen else "?")
            for p in data.get("parts") or []}


def show_parts(data: dict) -> None:
    clefs = part_clefs(data)
    skip = set(data.get(SKIP_KEY) or [])
    for i, p in enumerate(data.get("parts") or [], 1):
        note = f"  {DIM}— not extracted{RST}" if p in skip else ""
        print(f"     {i}  {p}  ({clefs.get(p, '?')} clef){note}")


def system_where(data: dict, e: dict) -> str:
    """'source page 8, system 2 of 3 (proof page 1)' for a system entry."""
    m = re.fullmatch(r"p(\d+)\.s(\d+)", e.get("id", ""))
    if not m:
        return e.get("id", "")
    pno, sno = int(m.group(1)), int(m.group(2))
    n_on = sum(1 for x in data.get("systems") or [] if x.get("id", "").startswith(f"p{pno}."))
    pages = _proof_pages(data)
    pp = f" (proof page {pages.index(pno) + 1})" if pno in pages else ""
    return f"source page {pno}, system {sno} of {n_on} from the top{pp}"


def choose_maps(item: Path) -> bool:
    """Ask for every system marked '?'. For each: where it is (source and
    proof page, red frame on the proof), its clefs and printed labels, and
    the suggestion. Answer: Enter = suggestion, or one part number per
    staff, top staff first ('2 3 4'; 0 leaves a staff out). True when all
    systems are set."""
    data = load_item(item)
    parts = data.get("parts") or []
    todo = [s_ for s_ in data.get("systems", []) if "?" in s_.get("map", [])]
    if not todo:
        return True
    _head(f"Choices: {len(todo)} system(s) need their parts")
    print("     proof.pdf (item folder) frames these systems in red and labels")
    print("     every staff with its part. Parts and their clefs:")
    show_parts(data)
    for k, s_ in enumerate(todo, 1):
        n = s_["staves"]
        sug = s_.get("suggest") or []
        clefs = s_.get("clefs") or []
        labels = [x for x in (s_.get("labels") or []) if x]
        while True:
            print(f"\n  [{k}/{len(todo)}] {s_['id']}: {system_where(data, s_)}")
            print(f"     {n} staves, clefs top to bottom: {' '.join(clefs) or '?'}"
                  + (f"; printed labels: {', '.join(labels)}" if labels else ""))
            if len(sug) == n:
                nums = [str(parts.index(x) + 1) if x in parts else ("0" if x == "-" else "?")
                        for x in sug]
                shown = ["(left out)" if x == "-" else x for x in sug]
                print(f"     suggestion: {', '.join(shown)}  (= {' '.join(nums)})")
            ans = ask(f"part number for each of the {n} staves, top first "
                      "(Enter = suggestion; 0 = leave out; same number twice = "
                      "one part on two staves; q = stop, continue later with rebuild)")
            if not ans and len(sug) == n:
                s_["map"] = list(sug)
                break
            nums = ans.replace(",", " ").split()
            if len(nums) == n and all(x.isdigit() and int(x) <= len(parts) for x in nums):
                s_["map"] = [parts[int(x) - 1] if int(x) else "-" for x in nums]
                break
            sn = [str(parts.index(x) + 1) if x in parts else ("0" if x == "-" else "?")
                  for x in sug] if len(sug) == n else []
            ex = " ".join(sn) if sn and "?" not in sn else " ".join(["1"] * n)
            print(f"     {YLW}need {n} numbers from 0 to {len(parts)}, one per staff, "
                  f"e.g. {ex} (0 = staff left out){RST}")
        # the answer becomes the suggestion for the systems still to come
        # with the same staff count and clefs (operator request 2026-10-24: they kept
        # the wrong suggestion)
        if s_["map"] != sug:
            for later in todo[k:]:
                if later["staves"] == n and clefs_compatible(later.get("clefs") or [], clefs):
                    later["suggest"] = list(s_["map"])
        save_item(item, data)
    annotate_proof(item)
    return True


PART_OPS = re.compile(r"^\s*(\d+)\s*(?:(\+)\s*(\d+)|=\s*(.+?))\s*$")


def apply_part_ops(data: dict, line: str) -> str:
    """apply_part_ops -> '' or an error. One line of operations on the
    parts list, separated by ';', all numbered as the list is now:
      N=name   rename part N
      N=-      do not extract part N (no PDF); it stays in the list, so
               its staves can still be identified in choices
      N=+      extract part N again
      N+M      join part N into part M: one part on two staves (piano,
               organ); M keeps its name
    Maps and suggestions follow; nothing changes when one item is bad."""
    parts = list(data.get("parts") or [])
    ren: dict[int, str] = {}
    drop: set[int] = set()
    undrop: set[int] = set()
    join: dict[int, int] = {}
    for op in (x for x in line.split(";") if x.strip()):
        m = PART_OPS.match(op)
        if not m:
            return f"not understood: {op.strip()} (N=name, N=-, N+M)"
        n = int(m.group(1))
        if not 1 <= n <= len(parts):
            return f"no part {n} (1-{len(parts)})"
        if m.group(2):
            t = int(m.group(3))
            if not 1 <= t <= len(parts) or t == n:
                return f"cannot join {n} into {t}"
            join[n - 1] = t - 1
        elif m.group(4).strip() == "-":
            drop.add(n - 1)
        elif m.group(4).strip() == "+":
            undrop.add(n - 1)
        else:
            ren[n - 1] = m.group(4).strip()
    if set(join) & set(join.values()) or drop & undrop:
        return "a part cannot be joined twice, or left out and extracted at once"
    keep = [k for k in range(len(parts)) if k not in join]
    new_name = {k: ren.get(k, parts[k]) for k in keep}
    if len(set(new_name.values())) != len(new_name):
        return "two parts would have the same name"
    skipped = {k for k in keep if parts[k] in set(data.get(SKIP_KEY) or [])}
    skipped = (skipped | drop) - undrop
    if not [k for k in keep if k not in skipped]:
        return "at least one part must be extracted"
    target = {parts[k]: new_name[k] for k in keep}
    for k, t in join.items():
        target[parts[k]] = new_name.get(t, parts[t])
    data["parts"] = [new_name[k] for k in keep]
    data[SKIP_KEY] = [new_name[k] for k in keep if k in skipped]
    if not data[SKIP_KEY]:
        data.pop(SKIP_KEY)
    for s_ in data.get("systems") or []:
        s_["map"] = [target.get(x, x) for x in s_.get("map") or []]
        if s_.get("suggest"):
            s_["suggest"] = [target.get(x, x) for x in s_["suggest"]]
    pl = (data.get("layout") or {}).get(PART_LAYOUT_KEY)
    if pl:                                  # per-part layout follows a rename
        data["layout"][PART_LAYOUT_KEY] = {
            (new_name[parts.index(n)] if n in parts and parts.index(n) in new_name else n): v
            for n, v in pl.items()}
    return ""


def rename_parts(item: Path) -> list[str] | None:
    """Part names: operations as in apply_part_ops (rename, leave out,
    join two staves into one part), shown again after each line; a comma
    list replaces all names; Enter = done. A comma list with a different
    number of names needs detect again: returns that list then (the
    caller re-runs detect), else None."""
    data = load_item(item)
    while True:
        _head("Parts (names come from the printed labels)")
        show_parts(data)
        print("     N=name rename   N=- do not extract   N=+ extract again   "
              "N+M join N into M (two staves, e.g. piano)   ; between several")
        ans = ask("change (Enter = done)", "")
        if not ans:
            break
        if any(c in ans for c in "=+"):
            err = apply_part_ops(data, ans)
            if err:
                print(f"     {YLW}{err}{RST}")
                data = load_item(item)
                continue
        else:
            parts = list(data.get("parts") or [])
            new = [x.strip() for x in ans.split(",") if x.strip()]
            if len(new) != len(parts):
                return new
            err = apply_part_ops(data, ";".join(f"{k}={v}" for k, v in
                                                enumerate(new, 1)))
            if err:
                print(f"     {YLW}{err}{RST}")
                data = load_item(item)
                continue
        save_item(item, data)
    annotate_proof(item)
    return None


def bar_summary(data: dict) -> str:
    """'line starts 0, 7, 14 …; letters A (p8.s2)' for the CLI."""
    sy = data.get("systems") or []
    starts = ", ".join(str(e.get("bar")) for e in sy[:8]) + (" …" if len(sy) > 8 else "")
    lets = [f"{m[1]} ({e['id']})" for e in sy for m in (e.get("marks") or [])]
    return f"line starts {starts}" + (f"; letters {', '.join(lets)}" if lets else "")


def confirm_bar_mismatches(item: Path) -> None:
    """Where the printed bar numbers of the source disagree with the count
    of barlines, ask the operator, one place at a time. The parts should
    follow the source score: Y keeps the printed numbers (recorded, not
    asked again); n leaves it open (the build stops until it is settled:
    mend the barlines with `partitor bars`, or keep the printed numbers)."""
    data = load_item(item)
    rules = dict(data.get("bar_rules") or {})
    ms = bar_mismatches(effective_systems(data.get("systems") or [], rules), rules)
    if not ms:
        return
    _head("Bar numbers: the barline count and the printed numbers differ")
    ack = list(rules.get("bars_ack") or [])
    for m in ms:
        _warn(f"bars:  {mismatch_text(m)}")
        if yes(f"{m['id']}: keep the printed numbers (the source's own numbering)?"):
            ack.append(m["key"])
        else:
            _note(f"{m['id']}: left open. Mend the barlines (partitor bars: j join, a add) "
                  "or keep the printed numbers (k); the build stops until then")
    if ack != list(rules.get("bars_ack") or []):
        rules["bars_ack"] = ack
        data["bar_rules"] = rules
        mark_pending(data, "bar numbers")
        save_item(item, data)


def confirm_bar_rules(item: Path) -> None:
    """Ask Y/n for each proposed pickup and split bar (detect proposes them
    from bar widths), then renumber and save."""
    confirm_bar_mismatches(item)
    data = load_item(item)
    rules = data.get("bar_rules") or {"pickup": [], "split": [], "fix": {}}
    if data.get("bar_rules_status") == "confirmed":
        return
    keep_p, keep_s = [], []
    if rules.get("pickup") or rules.get("split"):
        _head("Bar numbers (see proof.pdf)")
        for sid in rules.get("pickup") or []:
            if yes(f"{sid}: the first bar is short. A pickup (bar 0, the next bar is 1)?"):
                keep_p.append(sid)
        for key in rules.get("split") or []:
            sid, i = key.split(":")
            if yes(f"{sid}, bar {int(i) + 1}: after a repeat, completes the short bar "
                   "before it. Count the two as one bar?"):
                keep_s.append(key)
    data["bar_rules"] = {**rules, "pickup": keep_p, "split": keep_s,
                         "fix": rules.get("fix") or {}}
    data["bar_rules_status"] = "confirmed"
    renumber(data)
    save_item(item, data)
    print(f"     bars: {bar_summary(data)}")


def saved(item: Path, a: argparse.Namespace, start: float) -> int:
    """After an edit: the change is saved, not built (operator request 2026-10-24:
    make all edits, review, then build). --build builds at once."""
    data = load_item(item)
    if getattr(a, "build", False):
        if item_status(data) == "needs choices":
            _warn(f"map:  systems need choices first: partitor rebuild {data['id']}")
        else:
            _rebuild_report(item, data.get("built"))
        return _summary(start)
    _note(f"saved, not built ({item_status(data)}). Review: partitor show {data['id']}"
          f"   Build: partitor rebuild {data['id']} (menu r)")
    return _summary(start)


def cmd_parts(a: argparse.Namespace) -> int:
    """parts <id>: rename parts one at a time; saved, not built."""
    start = time.monotonic()
    item = _item_or_die(a.id)
    before = load_item(item)
    try:
        new = rename_parts(item)
    except Abort:
        return 0
    if new:
        _die(f"{len(new)} names for {len(before.get('parts') or [])} parts",
             "Rename with number=name; a different number of parts needs "
             "partitor rebuild after detect (new item).")
    data = load_item(item)
    if data.get("parts") == before.get("parts") and data.get(SKIP_KEY) == before.get(SKIP_KEY):
        return 0
    mark_pending(data, "part names")
    save_item(item, data)
    _ok(f"parts:  {', '.join(data['parts'])}")
    return saved(item, a, start)


def apply_group_op(data: dict, line: str) -> str:
    """apply_group_op -> '' or an error. 'Name=4,5,6' sets group Name to
    parts 4, 5, 6 (numbers of the parts list; score order is kept);
    'Name=' deletes it."""
    name, eq, nums = line.partition("=")
    name = name.strip()
    if not eq or not name:
        return "use Name=4,5,6 (or Name= to delete)"
    parts = data.get("parts") or []
    groups = dict(data.get("groups") or {})
    if not nums.strip():
        if name not in groups:
            return f"no group {name}"
        groups.pop(name)
    else:
        try:
            ks = sorted({int(x) for x in nums.replace(" ", ",").split(",") if x.strip()})
        except ValueError:
            return "part numbers, e.g. 4,5,6"
        if not ks or not all(1 <= k <= len(parts) for k in ks):
            return f"part numbers from 1 to {len(parts)}"
        if name in parts:
            return f"{name} is already a part name"
        groups[name] = [parts[k - 1] for k in ks]
    data["groups"] = groups
    if not groups:
        data.pop("groups")
    return ""


