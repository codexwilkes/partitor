    return saved(item, a, start)


def step_size(data: dict, bigger: bool, part: str | None = None
              ) -> tuple[list[str], str]:
    """step_size -> (set pairs, reason) for one expand/contract step:
    size first (pages +-1), then gap (+-1 sp) (DESIGN.md §5.2). part: that
    part only (pairs 'Part:key=value'), else all parts."""
    b = (data.get("built") or {}).get("parts") or []
    if part:
        b = [p for p in b if p.get("part") == part]
        if not b:
            raise ValueError(f"{part}: not built yet")
    if not b:
        raise ValueError("not built yet")
    lay = part_layout(data, part)
    pre = f"{part}:" if part else ""
    pages = max(p.get("content_pages", p["pages"]) for p in b)
    room = any(p["staff_mm"] < p["staff_max_mm"] - 0.05 for p in b)
    if bigger:
        if room:
            return [f"{pre}pages={pages + 1}"], "larger staff on one more page"
        if lay.get("reflow") != "on" and any(
                p.get("width_mm", 99.0) < lay["max_staff_mm"] - 0.05 for p in b):
            return [f"{pre}reflow=on"], "staff held by the source line width; lines re-flowed"
        if lay["gap"] < GAP_MAX:
            return [f"{pre}gap={min(GAP_MAX, lay['gap'] + 1)}"], "staff at full width; more space"
        raise ValueError("at the largest size and gap")
    if pages > 1:
        return [f"{pre}pages={pages - 1}"], "one page less, smaller staff"
    if lay["gap"] - 1 >= lay["gap_min"]:
        return [f"{pre}gap={lay['gap'] - 1}"], "less space between staves"
    raise ValueError("at the smallest gap on one page")


def _cmd_step(a: argparse.Namespace, bigger: bool) -> int:
    start = time.monotonic()
    item = _item_or_die(a.id)
    data = load_item(item)
    try:
        pairs, why = step_size(data, bigger, getattr(a, "part", None))
        changes = apply_set(data, pairs)
    except ValueError as e:
        _die(f"{'expand' if bigger else 'contract'}: {e}")
    if data.get("pending"):
        _warn("expand/contract:  sizes are from the last build; other changes are not built yet")
    mark_pending(data, *(c.split(": ")[0] for c in changes))
    save_item(item, data)
    _ok(f"{'expand' if bigger else 'contract'}:  {why} ({'; '.join(changes)})")
    return saved(item, a, start)


def reid_item(lib: Path, item: Path) -> Path:
    """reid_item -> the item under a YYYY-MM-NNNN id (an old YYYY-NNN item;
    operator request 2026-10-25). Month from `created`; the serial is kept when no
    other item of the year has it, else the next free one. The folder,
    the item files and the part PDFs are renamed; nothing is rebuilt."""
    data = load_item(item)
    old = item_id(item)
    ip = _id_parts(old)
    if ip is None or ip[1] is not None:
        raise ValueError(f"{old}: already YYYY-MM-NNNN")
    year, _, serial = ip
    created = str(data.get("created") or "")
    mm = re.match(r"(\d{4})-(\d{2})", created)
    month = int(mm.group(2)) if mm and int(mm.group(1)) == year else time.localtime().tm_mon
    taken = {(_id_parts(d.name) or (0, 0, 0))[2] for d in item_dirs(lib)
             if d != item and (_id_parts(d.name) or (0,))[0] == year}
    new = f"{year}-{month:02d}-{serial:04d}" if serial not in taken else next_id(lib, year, month)
    dst = lib / f"{new}-{data.get('slug') or 'item'}"
    if dst.exists():
        raise ValueError(f"{dst.name} exists")
    for kind in (SCORE_FILE, "source.pdf", "proof.pdf"):   # old plain names first
        if (item / kind).exists() and not (item / f"{old}-{kind}").exists():
            os.replace(item / kind, item / f"{old}-{kind}")
    for f in item.iterdir():
        if f.is_file() and f.name.startswith(f"{old}-"):
            os.replace(f, item / (new + f.name[len(old):]))
    pdir = item / "parts"
    if pdir.is_dir():
        for f in pdir.iterdir():
            if old in f.name:
                os.replace(f, pdir / f.name.replace(old, new))
    os.replace(item, dst)
    data = load_item(dst)
    data["id"] = new
    if str(data.get("source", "")).startswith(f"{old}-") or data.get("source") == "source.pdf":
        data["source"] = f"{new}-source.pdf"
    for p_ in (data.get("built") or {}).get("parts") or []:
        for k in ("file", "large"):
            if k in p_:
                p_[k] = str(p_[k]).replace(old, new)
    save_item(dst, data)
    return dst


def cmd_reid(a: argparse.Namespace) -> int:
    """reid <id>: an old YYYY-NNN item gets a YYYY-MM-NNNN id."""
    start = time.monotonic()
    _, lib = _lib_or_die()
    item = _item_or_die(a.id)
    old = item.name
    try:
        dst = reid_item(lib, item)
    except (ValueError, OSError) as e:
        _die(f"reid: {e}")
    _ok(f"reid:  {old} -> {dst.name}  (files and part PDFs renamed; no build needed)")
    return _summary(start)


def cmd_expand(a: argparse.Namespace) -> int:
    return _cmd_step(a, True)


def cmd_contract(a: argparse.Namespace) -> int:
    return _cmd_step(a, False)


def cmd_repage(a: argparse.Namespace) -> int:
    """repage <id> [part ...]: new page breaks for built parts from the lines
    saved by the last build (no analysis, no build). Sets turns=rest for the
    parts (kept by later builds); breaks, duplex and title_page are taken
    from the layout. Writes through parts.new/ like a build."""
    start = time.monotonic()
    item = _item_or_die(a.id)
    recover_parts(item)
    data = load_item(item)
    built = {r["part"]: r for r in (data.get("built") or {}).get("parts") or []}
    if not built:
        _die("repage: nothing built yet", f"Build first: partitor rebuild {data['id']}")
    words = list(getattr(a, "parts", None) or [])
    try:
        only = parse_parts(data, words) if words else None
    except ValueError as e:
        _die(f"repage: {e}", f"Parts: {selection_help(data)}")
    names = [nm for _, nm in build_names(data) if nm in built and (only is None or nm in only)]
    if not names:
        _die("repage: none of those parts is built")
    print(f"{BOLD}partitor {VERSION} — repage{RST}\n{time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
    stage = item / PARTS_NEW
    shutil.rmtree(stage, ignore_errors=True)
    stage.mkdir()
    done, recs, report = [], {}, []
    set_now = []
    for nm in names:
        if part_layout(data, nm).get("turns") != "rest":
            set_now.append(f"{nm}:turns=rest")
    if set_now:
        apply_set(data, set_now)
        _note("turns=rest:  set for " + ", ".join(p.split(":")[0] for p in set_now)
              + " (a later build keeps it; set \"Name:turns=any\" to undo)")
    t0 = time.monotonic()
    _head("Pages")
    for nm in names:
        try:
            pl = load_lines(lines_path(item / "lines", nm))
        except ValueError as e:
            _warn(f"repage:  {nm}: {e}")
            continue
        lay = part_layout(data, nm)
        o = {**pl["opts"], **{k: lay.get(k) for k in REPAGE_KEYS}}
        old = built[nm]
        fn = stage / old["file"]
        try:
            n = render_part(nm, pl["strips"], pl["meta"], pl["dpi"], o, fn)
        except Exception as e:                      # noqa: BLE001  (leave parts/ as it is)
            shutil.rmtree(stage, ignore_errors=True)
            _die(f"repage: {nm}: {e}", "parts/ is unchanged")
        tl = list(LAST_RENDER.get("turns") or [])
        nbad = count_bad_turns(tl, o)
        big = (large_copy(fn, o["paper"])
               if o.get("large") == "on" and o["paper"] in LARGE else None)
        rec = {k: v for k, v in old.items() if k != "large"}
        rec.update(pages=n, content_pages=LAST_RENDER.get("content", n),
                   title_page=bool(LAST_RENDER.get("title_page")), turns=len(tl),
                   bad_turns=nbad, **({"large": big.name} if big else {}))
        recs[nm] = rec
        c0 = old.get("content_pages", old["pages"])
        _ok(f"{nm}:  pages of music {c0} -> {rec['content_pages']}  "
            f"turns {old.get('turns', turns(c0))} -> {len(tl)}  while playing {nbad}")
        report.append((nm, tl))
        done.append(nm)
    if not done:
        shutil.rmtree(stage, ignore_errors=True)
        _fail("repage:  nothing done (rebuild the parts once to save their lines)")
        return _summary(start)
    for nm, tl in report:
        _head(f"Turns: {nm}")
        for t in tl:
            line = f"     {turn_text(t)}"
            if t["resting"]:
                print(line)
            elif t.get("movement"):
                _note(line.strip())
            else:
                _warn(f"turn-while-playing:  {nm}  {turn_text(t)}")
    try:
        kept = keep_other_parts(item, data, stage, done)
    except OSError as e:
        shutil.rmtree(stage, ignore_errors=True)
        _die(f"repage:  the other parts could not be kept ({e})", "parts/ is unchanged")
    order = {nm: i for i, (_, nm) in enumerate(build_names(data))}
    new = sorted([recs[nm] for nm in done] + kept, key=lambda r: order.get(r["part"], len(order)))
    swap_parts(item)
    gone = {f"{nm}:{k}" for nm in done for k in REPAGE_KEYS}
    if set(done) >= set(built):
        gone |= set(REPAGE_KEYS)
    left = [x for x in data.get("pending") or [] if x not in gone]
    if left:
        data["pending"] = left
    else:
        data.pop("pending", None)
    data["built"] = {"date": time.strftime("%Y-%m-%d %H:%M"), "parts": new}
    save_item(item, data)
    _note(f"parts:  the set before is kept in {PARTS_PREV}/ until the next good build")
    _note(f"repage took {time.monotonic() - t0:.0f} s")
    return _summary(start)


def cmd_rebuild(a: argparse.Namespace) -> int:
    """rebuild <id>: detect again when score.yaml has no systems (failed
    new), ask open choices, then build."""
    start = time.monotonic()
    item = _item_or_die(a.id)
    data = load_item(item)
    try:
        if "systems" not in data:
            if run_detect(item, data.get("pages"), data.get("title", ""),
                          data.get("composer", "")):
                _reset_counts()
                _fail("detect:  failed (see above)")
                return _summary(start)
            data = merge_item_keys(item, data)
            proof_from_preview(item)
        choose_maps(item)
        confirm_bar_rules(item)
    except Abort:
        _warn("rebuild:  stopped")
        return _summary(start)
    only = None
    words = list(getattr(a, "parts", None) or [])
    if words:
        data = load_item(item)
        try:
            only = parse_parts(data, words)
        except ValueError as e:
            _die(f"rebuild: {e}", f"Parts: {selection_help(data)}")
    data = load_item(item)
    if _rebuild_report(item, data.get("built"), only, getattr(a, "jobs", None)) == 0:
        maybe_offer_reflow(item, only)
    return _summary(start)


def ask_part(data: dict) -> str | None:
    """ask_part -> one part or group by number, None for all (Enter)."""
    names = part_names(data)
    print("  " + "  ".join(f"{i} {n}" for i, n in enumerate(names, 1)))
    while True:
        v = ask("part (Enter = all parts)", "")
        if not v:
            return None
        if v.isdigit() and 1 <= int(v) <= len(names):
            return names[int(v) - 1]
        if v in names:
            return v
        _warn(f"part:  no part {v}")


def ambitus_menu(data: dict) -> None:
    """Menu key k: each part's ambitus, numbered; pick one and give
    LOW-HIGH (C4-F5, F#3-Bb4; # sharp, b flat), auto (read from the notes), off or on (a continuo
    part). Saved, not built; the proof is redrawn."""
    amb = data.get("ambitus") or {}
    names = [p for p in data.get("parts") or [] if p in amb]
    if not names:
        _warn("ambitus:  none yet (analyse again with partitor 0.3.0-dev.15 or later)")
        return
    for i, p_ in enumerate(names, 1):
        a_ = amb[p_]
        frm = a_.get("from", "auto")
        rp = ambitus_report(data, p_) if frm in ("auto", "on") else {"low": [], "high": [],
                                                                     "doubts": [], "low_at": []}
        bars = (f"  low {'; '.join(rp.get('low_at', [])[:2]) or '?'}; high "
                f"{'; '.join(rp.get('high_at', [])[:2]) or '?'}") if rp.get("low_at") else ""
        print(f"  {i}  {p_}: {a_.get('range') or 'none'}{bars}"
              + ("" if frm == "auto" else f"  ({'by hand' if frm == 'operator' else frm})"))
        for d_ in rp["doubts"]:
            print(f"       {YLW}? {d_}{RST}")
        if rp.get("suggest"):
            print(f"       suggested: {rp['suggest']}  ({rp['why']})")
    while True:
        v = ask("part (Enter = done)", "")
        if not v:
            return
        part = names[int(v) - 1] if v.isdigit() and 1 <= int(v) <= len(names) else (
            v if v in names else None)
        if part is None:
            _warn(f"ambitus:  no part {v}")
            continue
        val = ask(f"{part}: LOW-HIGH (e.g. C4-F5, F#3-Bb4), auto, off or on (Enter = no change)", "")
        if not val:
            continue
        cmd_set(argparse.Namespace(id=data["id"], pairs=[f"{part}:ambitus={val}"], build=False))
        data = load_item(_item_or_die(data["id"]))
        amb = data.get("ambitus") or {}


def item_menu(item: Path) -> None:
    """Menu for one item (DESIGN.md §6.2 sketch). Letters act at once."""
    iid = item_id(item)
    while True:
        if not item.is_dir():                 # renamed (m, rename): find it by its id
            try:
                item = find_item(item.parent, iid)
            except ValueError:
                return
        data = load_item(item)
        print(f"\n {BOLD}{item_line(item, data)}{RST}")
        st_ = item_status(data)
        print(f"  status: {st_}" + (f" — {', '.join(data['pending'])}" if data.get("pending") else ""))
        print("  edit (saved, not built):  m title/composer  t part names  g groups  "
              "n bar numbers and marks")
        print("                            e expand  c contract  p pages  a paper  k ambitus"
              "  s set")
        print("  v review   y analyse again   r build (r Trombones, r 2-4: only those)")
        print("  x repage (page turns while resting; x Trombones)   b back")
        try:
            raw = ask(">", "b").strip()
        except Abort:
            return
        k, _, rest = raw.partition(" ")             # r Trombones: a key and its words
        k = k.lower()
        ns = argparse.Namespace(id=data["id"], build=False)
        try:
            if k == "b":
                return
            if k in ("e", "c", "p"):
                part = ask_part(data)
                if k == "e":
                    cmd_expand(argparse.Namespace(id=data["id"], build=False, part=part))
                elif k == "c":
                    cmd_contract(argparse.Namespace(id=data["id"], build=False, part=part))
                else:
                    v = ask("pages (auto or 1-20)", "auto")
                    pre = f"{part}:" if part else ""
                    cmd_set(argparse.Namespace(id=data["id"], pairs=[f"{pre}pages={v}"],
                                               build=False))
            elif k == "k":
                ambitus_menu(data)
            elif k == "a":
                cur = (data.get("layout") or {}).get("paper", LAYOUT_DEFAULTS["paper"])
                new = PAPER_NEXT.get(cur, "letter")
                cmd_set(argparse.Namespace(id=data["id"], pairs=[f"paper={new}"], build=False))
            elif k == "s":
                v = ask("key=value (e.g. gap=11 title=\"…\")", "")
                if v:
                    cmd_set(argparse.Namespace(id=data["id"], pairs=shlex.split(v), build=False))
            elif k == "n":
                cmd_bars(ns)
            elif k == "t":
                cmd_parts(ns)
            elif k == "g":
                cmd_groups(ns)
            elif k == "m":
                cmd_meta(ns)
            elif k == "y":
                cmd_analyse(ns)
            elif k == "r":
                cmd_rebuild(argparse.Namespace(id=data["id"], build=False, parts=rest.split(),
                                               jobs=None))
            elif k == "x":
                cmd_repage(argparse.Namespace(id=data["id"], parts=rest.split()))
            elif k == "v":
                cmd_show(ns)
        except SystemExit:            # _die inside a command: stay in the menu
            pass
        except Abort:
            pass


RECENT_KEYS = "ABCDE"     # menu: the five items changed last
RECENT_MIN_ITEMS = 9      # the recent block shows from this many items on


def menu_key(item: Path, year: int) -> str:
    """menu_key -> the item's stable menu number: its serial for this
    year ('12' = 2026-10-0012, as every command takes it), year-serial for
    another year ('2025-14')."""
    ip = _id_parts(item.name)
    if not ip:
        return item.name
    return str(ip[2]) if ip[0] == year else f"{ip[0]}-{ip[2]}"


def id_order(item: Path) -> tuple[int, int]:
    ip = _id_parts(item.name) or (0, None, 0)
    return ip[0], ip[2]


def item_mtime(item: Path) -> float:
    f = item_file(item, SCORE_FILE)
    return f.stat().st_mtime if f.exists() else 0.0


def work_mark(item: Path) -> str:
    """'*' when the item has work pending (choices, changes not built,
    not analysed), else ' '."""
    try:
        st_ = item_status(load_item(item))
    except (OSError, yaml.YAMLError):
        return "*"
    return " " if st_ in ("built", "ready to build") else "*"


def cmd_menu(a: argparse.Namespace) -> int:
    """No command: the library, newest first, each item under its stable
    serial number; from RECENT_MIN_ITEMS items on, the five changed last
    first as A-E (operator request 2026-10-25: numbers for muscle memory, letters for
    the piece just worked on). /words filters both, + / - pages, * marks
    work pending, n new from inbox."""
    share, lib = _lib_or_die()
    words, page = "", 0
    size = list_page_size()
    year = time.localtime().tm_year

    def line(key: str, d: Path) -> str:
        try:
            return f"  {work_mark(d)}{key:>7}  {item_line(d, load_item(d))}"
        except (OSError, yaml.YAMLError):
            return f"  *{key:>7}  {d.name} · (no score.yaml)"

    while True:
        allit = sorted(item_dirs(lib), key=id_order, reverse=True)
        items = [d for d in allit if not words or item_matches(d, words)]
        recent = sorted(items, key=item_mtime, reverse=True)[:len(RECENT_KEYS)] \
            if len(allit) >= RECENT_MIN_ITEMS else []
        pages = max(1, -(-len(items) // size))
        page = min(page, pages - 1)
        waiting = len(inbox_pdfs(share))
        print(f"\n{BOLD}partitor {VERSION}{RST}  ({lib})"
              + (f"  filter: {words}  ({len(items)} of {len(allit)})" if words else ""))
        if not items:
            print("  (no item matches)" if words else "  (library empty)")
        if recent:
            print("  recent:")
            for ltr, d in zip(RECENT_KEYS, recent):
                print(line(ltr, d))
            print("  all (newest first):")
        for d in items[page * size:(page + 1) * size]:
            print(line(menu_key(d, year), d))
        nav = []
        if pages > 1:
            nav.append(f"page {page + 1}/{pages}: + next  - back")
        nav.append("/words filter" + ("  / clears" if words else ""))
        print(f"  n  new from inbox ({waiting} waiting)   {'   '.join(nav)}   q quit"
              + ("   * = work pending" if any(work_mark(d) == "*" for d in items[:size]) else ""))
        try:
            k = ask(">", "q").strip()
        except Abort:
            return 0
        if k.startswith("/"):
            words, page = k[1:].strip(), 0
            continue
        if k == "+":
            page = min(page + 1, pages - 1)
            continue
        if k == "-":
            page = max(0, page - 1)
            continue
        if k.lower() == "q":
            return 0
        if k.lower() == "n":
            try:
                cmd_new(argparse.Namespace(n=None))
            except SystemExit:
                pass
            continue
        if len(k) == 1 and k.upper() in RECENT_KEYS and recent:
            i_ = RECENT_KEYS.index(k.upper())
            if i_ < len(recent):
                item_menu(recent[i_])
            continue
        if k:
            try:
                item_menu(find_item(lib, k))      # 12, 2025-14, 2026-10-0012
            except ValueError:
                _warn(f"menu:  no item {k}")


def sandbox_check(library: bool = False) -> int:
    """sandbox_check -> 0 when this process runs as the sandbox expects
    (DESIGN.md §8): not root, no network sockets, read-only system, /root
    hidden, working folder writable; with library: inbox/ and library/ of the
    library folder writable. One line per item; used by the installer."""
    import socket
    import tempfile
    import pwd
    res = []
    user = pwd.getpwuid(os.geteuid()).pw_name
    res.append(("user", user, os.geteuid() != 0))
    try:
        socket.socket(socket.AF_INET, socket.SOCK_STREAM).close()
        res.append(("network", "open", False))
    except OSError:
        res.append(("network", "blocked", True))
    try:
        tempfile.TemporaryFile(dir="/usr").close()
        res.append(("system", "writable", False))
    except OSError:
        res.append(("system", "read-only", True))
    try:
        hidden = not os.listdir("/root")
    except OSError:
        hidden = True
    res.append(("/root", "hidden" if hidden else "visible", hidden))
    try:
        tempfile.TemporaryFile(dir=".").close()
        res.append(("work", "writable", True))
    except OSError:
        res.append(("work", "not writable", False))
    if library:
        root = library_root()
        for sub_ in ("inbox", "library"):
            d = root / sub_
            try:
                tempfile.TemporaryFile(dir=d).close()
                res.append((f"library {sub_}", f"writable ({d})", True))
            except OSError as e:
                res.append((f"library {sub_}", f"not writable ({d}: {e.strerror})", False))
    for name, val, good in res:
        print(f"{'ok  ' if good else 'FAIL'} {name}: {val}")
    return 0 if all(g for _, _, g in res) else 1


def main() -> int:
    if "--sandbox-check" in sys.argv[1:2]:
        return sandbox_check(library="--library" in sys.argv[2:3])
    if os.geteuid() == 0 and os.environ.get("PARTITOR_ALLOW_ROOT") != "1" \
            and sys.argv[1:2] not in (["--version"], ["-h"], ["--help"]):
        _die("the engine does not run as root (it parses PDFs from the internet)",
             "Use /usr/local/sbin/partitor: it runs the engine as user partitor "
             "in a sandbox.")
    p = argparse.ArgumentParser(prog="partitor", description="Split a score PDF into parts.")
    p.add_argument("--version", action="version", version=f"partitor {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("menu", help="recent items and new from inbox (default)")
    nw = sub.add_parser("new", help="wizard for an inbox PDF")
    nw.add_argument("n", nargs="?", help="inbox number (default: ask)")
    nw.add_argument("--jobs", help="worker processes of the analysis and the build: a number "
                    "or auto (default: PARTITOR_JOBS, else auto)")
    ls_ = sub.add_parser("list", help="all library items, or those matching words")
    ls_.add_argument("words", nargs="*", help="e.g. Schein (composer, title, part, id)")
    sub.add_parser("show").add_argument("id", help="12 or 2026-10-0012")
    rb = sub.add_parser("rebuild", help="build; with parts or groups: only those "
                        "(the other part files stay)")
    rb.add_argument("id", help="12 or 2026-10-0012")
    rb.add_argument("parts", nargs="*", metavar="PART",
                    help="numbers (3, 2-4), names (Trombones, Bass Trombone) or all; "
                         "default: every part")
    rb.add_argument("--jobs", help="worker processes: a number or auto "
                    "(default: PARTITOR_JOBS, else auto)")
    rp = sub.add_parser("repage", help="new page breaks from the saved lines: turns while "
                        "resting, manual breaks (no analysis, no build)")
    rp.add_argument("id", help="12 or 2026-10-0012")
    rp.add_argument("parts", nargs="*", metavar="PART",
                    help="numbers, names or all; default: every built part")
    sub.add_parser("proof", help="draw proof.pdf again (names, ambitus, bar numbers, letters)"
                   ).add_argument("id", help="12 or 2026-10-0012")
    for name in ("expand", "contract", "bars", "parts", "groups", "meta"):
        sp_ = sub.add_parser(name, help="edit; saved, not built (--build: build too)")
        sp_.add_argument("id", help="12 or 2026-10-0012")
        if name in ("expand", "contract"):
            sp_.add_argument("part", nargs="?", help="one part or group only (default: all)")
        sp_.add_argument("--build", action="store_true", help="build after the edit")
    sub.add_parser("reid", help="old YYYY-NNN item: new id YYYY-MM-NNNN (renames files)"
                   ).add_argument("id")
    sub.add_parser("rename", help="folder name follows the title and composer"
                   ).add_argument("id")
    an = sub.add_parser("analyse", help="analyse the source again (proof, allocation)")
    an.add_argument("id", nargs="?", help="12 or 2026-10-0012 (or --all)")
    an.add_argument("--yes", action="store_true", help="ask nothing; open choices stay for rebuild")
    an.add_argument("--all", action="store_true", help="every library item, as --yes")
    st = sub.add_parser("set", help="change settings; saved, not built (--build: build too)")
    st.add_argument("id")
    st.add_argument("pairs", nargs="+", metavar="key=value")
    st.add_argument("--build", action="store_true", help="build after the change")
    pc = sub.add_parser("pieces")
    pc.add_argument("pdf")
    d = sub.add_parser("detect")
    d.add_argument("pdf")
    d.add_argument("--pages")
    d.add_argument("--parts", default="")
    d.add_argument("--title", default="")
    d.add_argument("--subtitle", default="")
    d.add_argument("--composer", default="")
    d.add_argument("--dpi", type=int, default=400)
    d.add_argument("--page-header-sp", dest="page_header_sp", type=float,
                   default=PAGE_HEADER_SP)
    d.add_argument("--out")
    d.add_argument("--force", action="store_true")
    d.add_argument("--jobs", help="worker processes for the page analysis: a number or auto "
                   "(default: PARTITOR_JOBS, else auto)")
    b = sub.add_parser("build")
    b.add_argument("pdf")
    b.add_argument("--pages")
    b.add_argument("--out")
    b.add_argument("--paper", choices=sorted(PAPER))
    b.add_argument("--scale", type=float)
    b.add_argument("--gap", type=float)
    b.add_argument("--min-gap", dest="gap_min", type=float)
    b.add_argument("--clearance", type=float)
    b.add_argument("--page-count", dest="page_count", type=int)
    b.add_argument("--min-staff-mm", dest="min_staff_mm", type=float)
    b.add_argument("--ink", choices=["normal", "darker"])
    b.add_argument("--bar-numbers", dest="bar_numbers", choices=["start", "none"])
    b.add_argument("--bar-raise", dest="bar_raise", type=float)
    b.add_argument("--bar-size", dest="bar_size", type=float)
    b.add_argument("--margin-top", dest="margin_top", type=float)
    b.add_argument("--margin-bottom", dest="margin_bottom", type=float)
    b.add_argument("--margin-side", dest="margin_side", type=float)
    b.add_argument("--gutter", type=float)
    b.add_argument("--duplex", choices=["auto", "on", "off"])
    b.add_argument("--large", choices=["on", "off"])
    b.add_argument("--reflow", choices=["on", "off"])
    b.add_argument("--max-staff-mm", dest="max_staff_mm", type=float)
    b.add_argument("--title-page", dest="title_page", choices=["auto", "off"])
    b.add_argument("--rests", choices=["compress", "keep"])
    b.add_argument("--jobs", help="worker processes: a number or auto (default: PARTITOR_JOBS, else auto)")
    b.add_argument("--only", nargs="+", metavar="NAME", help="build these parts or groups only")
    a = p.parse_args()
    cmds = {"pieces": cmd_pieces, "detect": cmd_detect, "build": cmd_build,
            "menu": cmd_menu, "new": cmd_new, "list": cmd_list, "show": cmd_show,
            "set": cmd_set, "expand": cmd_expand, "contract": cmd_contract,
            "rebuild": cmd_rebuild, "repage": cmd_repage, "bars": cmd_bars, "parts": cmd_parts,
            "proof": cmd_proof,
            "groups": cmd_groups, "meta": cmd_meta, "analyse": cmd_analyse,
            "reid": cmd_reid, "rename": cmd_rename}
    return cmds[a.cmd or "menu"](a)


if __name__ == "__main__":
