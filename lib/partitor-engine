def _lib_or_die() -> tuple[Path, Path]:
    root = library_root()
    lib = root / "library"
    if not (root / "inbox").is_dir() or not lib.is_dir():
        _die(f"library folder not ready: {root} needs inbox/ and library/",
             "Run: partitor-init (see docs/INSTALL.md).")
